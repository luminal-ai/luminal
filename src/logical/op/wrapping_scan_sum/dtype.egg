;Dtype Propagation : LogicalWrappingScanSum
(rule
  (
    (= ?out_logical_tensor (LogicalWrappingScanSum ?in_logical ?axis))
    (= ?in_dtype (dtype-of ?in_logical))
  )
  (
    (set (dtype-of ?out_logical_tensor) ?in_dtype)
  )
  :ruleset prop
  :name "wrapping_scan_sum/dtype: dtype of LogicalWrappingScanSum from its operand"
)
