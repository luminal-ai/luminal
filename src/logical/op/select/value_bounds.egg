; Value bounds : LogicalSelect — the result is one of the two branches, so
; the interval is their union.
(rule
  (
    (= ?out (LogicalSelect ?cond ?if_true ?if_false))
    (= ?true_lower (value-lower-bound-of ?if_true))
    (= ?false_lower (value-lower-bound-of ?if_false))
  )
  ((set (value-lower-bound-of ?out) (min ?true_lower ?false_lower)))
  :ruleset main_ruleset :name "select/value_bounds: lower bound is the min over the two branches"
)
(rule
  (
    (= ?out (LogicalSelect ?cond ?if_true ?if_false))
    (= ?true_upper (value-upper-bound-of ?if_true))
    (= ?false_upper (value-upper-bound-of ?if_false))
  )
  ((set (value-upper-bound-of ?out) (max ?true_upper ?false_upper)))
  :ruleset main_ruleset :name "select/value_bounds: upper bound is the max over the two branches"
)

; Structural max/min refinements need only the bounds relevant to the
; conclusion. In particular, max(opaque,lo) >= lo and min(opaque,hi) <= hi
; hold even when opaque has no known interval. This lets a nested clamp
; establish a finite interval without declaring a range on caller data.
(rule ((= ?out (LogicalSelect (LogicalLessThan ?a ?b) ?b ?a))
       (= ?lower (value-lower-bound-of ?a)))
      ((set (value-lower-bound-of ?out) ?lower))
 :ruleset main_ruleset :name "select/value_bounds: maximum is at least its first operand")
(rule ((= ?out (LogicalSelect (LogicalLessThan ?a ?b) ?b ?a))
       (= ?lower (value-lower-bound-of ?b)))
      ((set (value-lower-bound-of ?out) ?lower))
 :ruleset main_ruleset :name "select/value_bounds: maximum is at least its second operand")
(rule ((= ?out (LogicalSelect (LogicalLessThan ?a ?b) ?b ?a))
       (= ?a_upper (value-upper-bound-of ?a))
       (= ?b_upper (value-upper-bound-of ?b)))
      ((set (value-upper-bound-of ?out) (max ?a_upper ?b_upper)))
 :ruleset main_ruleset :name "select/value_bounds: maximum upper bound uses both upper bounds")
(rule ((= ?out (LogicalSelect (LogicalLessThan ?b ?a) ?b ?a))
       (= ?upper (value-upper-bound-of ?a)))
      ((set (value-upper-bound-of ?out) ?upper))
 :ruleset main_ruleset :name "select/value_bounds: minimum is at most its first operand")
(rule ((= ?out (LogicalSelect (LogicalLessThan ?b ?a) ?b ?a))
       (= ?upper (value-upper-bound-of ?b)))
      ((set (value-upper-bound-of ?out) ?upper))
 :ruleset main_ruleset :name "select/value_bounds: minimum is at most its second operand")
(rule ((= ?out (LogicalSelect (LogicalLessThan ?b ?a) ?b ?a))
       (= ?a_lower (value-lower-bound-of ?a))
       (= ?b_lower (value-lower-bound-of ?b)))
      ((set (value-lower-bound-of ?out) (min ?a_lower ?b_lower)))
 :ruleset main_ruleset :name "select/value_bounds: minimum lower bound uses both lower bounds")
