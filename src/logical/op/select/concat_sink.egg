; Rewrite : a row slice of a row-wise computation is the computation over
; the row slices of its operands. A ROW CARRIER is a tensor one of whose
; axes is, row for row, the axis of a certified concatenation (k, A)
; (concat_slices.egg): the concatenation itself, then through elementwise
; ops and selects (any operand carrying), reductions over another axis, and
; views that read the carried axis at one of their own coordinates of the
; same extent and no other entry of theirs at that coordinate (a permute, a
; reshape of other axes, a broadcast, a matmul's operand view keep the rows;
; a slice of the axis does not).
;
; A row slice of a carrier SINKS when it is demanded: the slice is the op
; over the same slice of each operand, and an operand that carries the same
; rows, or is computed from literals alone, is demanded in turn, down to
; the concatenation, whose slices are its parts (select/rewrite.egg decides
; the select over the slice). Any other operand (a weight, the other side
; of a product, a table) is read through the slice's view, which composes
; with whatever view it already is. Demands come from
;   - a slice the model reads row for row through a view of another shape
;     (a split feeding a projection): an attention whose result is split by
;     query rows becomes one attention per query stream over the same keys;
;   - the row-wise rule (concat_rowwise.egg), for an operand that carries
;     the rows: a norm's statistics or the rotated half of a rotary
;     embedding become per-part.
; Slices read only to be concatenated again are not demanded: their
; concatenation is the tensor itself (concat_slices.egg).
;
; A slice sinks through a reduction only where the reduced operand mixes
; nothing but carried rows: a product of two carriers (the scores and the
; values of an attention, a norm's square), a carrier and a broadcast
; literal, a unary op or select of a carrier, or a projection of a
; concatenation itself. A projection of anything else by a weight keeps its
; slice as the slice of the joint projection. This is a cost bound, not a
; soundness condition: without it a demand reaching the residual stream of
; a chain of joined blocks (each block's entry concatenation IS the
; previous block's output) would sink through every block's projections and
; attention, and the three-block regression grows from 22k to 74k rows.
;
; Same values, same rounding: each element of a slice is computed by the
; same op on the same operand elements, and a reduction over another axis
; accumulates the same elements in the same order.

(rule
  ((row-free-demand ?list ?skip ?coord) (= ?list (IntExprNil)))
  ((row-free ?list ?skip ?coord))
  :ruleset main_ruleset
  :name "select/concat_sink: no entries are free of any coordinate"
)
(rule
  ((row-free-demand ?list ?skip ?coord) (= ?list (IntExprCons ?entry ?tail)))
  ((row-free-demand ?tail ?skip ?coord))
  :ruleset main_ruleset
  :name "select/concat_sink: freedom of the entries demands the tail's"
)
(rule
  (
    (row-free-demand ?list ?skip ?coord)
    (= ?list (IntExprCons ?entry ?tail))
    (= ?index (expr-list-length-of ?tail))
    (!= ?index ?skip)
  )
  ((axis-free-demand ?entry ?coord))
  :ruleset main_ruleset
  :name "select/concat_sink: freedom of the entries demands each other entry's"
)
(rule
  (
    (row-free-demand ?list ?skip ?coord)
    (= ?list (IntExprCons ?entry ?tail))
    (= ?skip (expr-list-length-of ?tail))
    (row-free ?tail ?skip ?coord)
  )
  ((row-free ?list ?skip ?coord))
  :ruleset main_ruleset
  :name "select/concat_sink: the carried axis's own entry is skipped"
)
(rule
  (
    (row-free-demand ?list ?skip ?coord)
    (= ?list (IntExprCons ?entry ?tail))
    (= ?index (expr-list-length-of ?tail))
    (!= ?index ?skip)
    (axis-free ?entry ?coord)
    (row-free ?tail ?skip ?coord)
  )
  ((row-free ?list ?skip ?coord))
  :ruleset main_ruleset
  :name "select/concat_sink: an entry free of the coordinate keeps the list free"
)

; A row slice of a carrier the model reads row for row through a view of
; another shape (the slice's axis read at one of the view's own coordinates,
; over the slice's extent: a projection's operand view) is demanded. A
; concatenation reads its parts through clamps over the whole extent, which
; is not such a reader, nor is anything composed from one. The slice is
; recognised by its carried entry and extent; the demand then builds the
; exact row-slice map, and a view that is not exactly that slice merges
; with nothing.
(rule
  (
    (row-carrier ?y ?axis ?split)
    (= ?slice (LogicalIndexMapApply ?y ?map ?sliced))
    (= ?map (IndexMapLit ?entries ?shape))
    (= ?entry (expr-list-nth-from-end ?entries ?axis))
    (= ?entry (CoordVar ?sliced ?axis))
    (= ?sliced (ShapeLit ?sliced_dims))
    (= ?slice_extent (expr-list-nth-from-end ?sliced_dims ?axis))
    (= ?slice_extent (IntLit ?split))
    (= ?reader (LogicalIndexMapApply ?slice ?reader_map ?reader_shape))
    (= ?reader_map (IndexMapLit ?reader_entries ?sliced))
    (= ?reader_entry (expr-list-nth-from-end ?reader_entries ?axis))
    (= ?reader_entry (CoordVar ?reader_shape ?reader_axis))
    (= ?reader_shape (ShapeLit ?reader_dims))
    (= ?reader_extent (expr-list-nth-from-end ?reader_dims ?reader_axis))
    (= ?reader_extent (IntLit ?split))
    (!= ?reader_shape ?sliced)
  )
  ((row-sink-demand ?y ?axis ?split 0 ?split))
  :ruleset main_ruleset
  :name "select/concat_sink: a carrier's first slice read row for row through another shape is demanded"
)
(rule
  (
    (row-carrier ?y ?axis ?split)
    (= ?slice (LogicalIndexMapApply ?y ?map ?sliced))
    (= ?map (IndexMapLit ?entries ?shape))
    (= ?entry (expr-list-nth-from-end ?entries ?axis))
    (= ?entry (IntAdd (CoordVar ?sliced ?axis) (IntLit ?split)))
    (= ?sliced (ShapeLit ?sliced_dims))
    (= ?slice_extent (expr-list-nth-from-end ?sliced_dims ?axis))
    (= ?slice_extent (IntLit ?extent))
    (= ?reader (LogicalIndexMapApply ?slice ?reader_map ?reader_shape))
    (= ?reader_map (IndexMapLit ?reader_entries ?sliced))
    (= ?reader_entry (expr-list-nth-from-end ?reader_entries ?axis))
    (= ?reader_entry (CoordVar ?reader_shape ?reader_axis))
    (= ?reader_shape (ShapeLit ?reader_dims))
    (= ?reader_extent (expr-list-nth-from-end ?reader_dims ?reader_axis))
    (= ?reader_extent (IntLit ?extent))
    (!= ?reader_shape ?sliced)
  )
  ((row-sink-demand ?y ?axis ?split ?split ?extent))
  :ruleset main_ruleset
  :name "select/concat_sink: a carrier's second slice read row for row through another shape is demanded"
)
; A demanded slice builds its map.
(rule
  ((row-sink-demand ?y ?axis ?split ?offset ?extent) (= ?shape (shape-of ?y)))
  ((row-slice-demand ?shape ?axis ?offset ?extent))
  :ruleset main_ruleset
  :name "select/concat_sink: a demanded row slice builds its map"
)

(rule
  (
    (row-carrier ?x ?axis ?split)
    (= ?y (LogicalExp ?x))
  )
  (
    (row-reducible ?y ?axis ?split)
