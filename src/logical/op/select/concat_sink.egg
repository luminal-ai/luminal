  )
  (
    (row-slice-demand ?x_shape ?axis ?offset ?extent)
  )
  :ruleset main_ruleset
  :name "select/concat_sink: a row slice of WrappingReduceSum over a later axis demands the operand's slice"
)
(rule
  (
    (row-sink-demand ?y ?axis ?split ?offset ?extent)
    (= ?shape (shape-of ?y))
    (row-slice ?shape ?axis ?offset ?extent ?map ?sliced)
    (= ?y (LogicalWrappingReduceSum ?x ?reduced))
    (< ?axis ?reduced)
    (row-carrier ?x ?axis ?split)
    (row-reducible ?x ?axis ?split)
    (= ?x_shape (shape-of ?x))
    (row-slice ?x_shape ?axis ?offset ?extent ?x_map ?x_sliced)
  )
  (
    (union (LogicalIndexMapApply ?y ?map ?sliced) (LogicalWrappingReduceSum (LogicalIndexMapApply ?x ?x_map ?x_sliced) ?reduced))
    (row-sink-demand ?x ?axis ?split ?offset ?extent)
  )
  :ruleset main_ruleset
  :name "select/concat_sink: a row slice of WrappingReduceSum over a later axis is WrappingReduceSum of the operand's slice"
)
(rule
  (
    (row-sink-demand ?y ?axis ?split ?offset ?extent)
    (= ?shape (shape-of ?y))
    (row-slice ?shape ?axis ?offset ?extent ?map ?sliced)
    (= ?y (LogicalWrappingReduceSum ?x ?reduced))
    (>= ?axis ?reduced)
    (row-carrier ?x (+ ?axis 1) ?split)
    (row-reducible ?x (+ ?axis 1) ?split)
    (= ?x_shape (shape-of ?x))
  )
  (
    (row-slice-demand ?x_shape (+ ?axis 1) ?offset ?extent)
  )
  :ruleset main_ruleset
  :name "select/concat_sink: a row slice of WrappingReduceSum over an earlier axis demands the operand's slice"
)
(rule
  (
    (row-sink-demand ?y ?axis ?split ?offset ?extent)
    (= ?shape (shape-of ?y))
    (row-slice ?shape ?axis ?offset ?extent ?map ?sliced)
    (= ?y (LogicalWrappingReduceSum ?x ?reduced))
    (>= ?axis ?reduced)
    (row-carrier ?x (+ ?axis 1) ?split)
    (row-reducible ?x (+ ?axis 1) ?split)
    (= ?x_shape (shape-of ?x))
    (row-slice ?x_shape (+ ?axis 1) ?offset ?extent ?x_map ?x_sliced)
  )
  (
    (union (LogicalIndexMapApply ?y ?map ?sliced) (LogicalWrappingReduceSum (LogicalIndexMapApply ?x ?x_map ?x_sliced) ?reduced))
    (row-sink-demand ?x (+ ?axis 1) ?split ?offset ?extent)
  )
  :ruleset main_ruleset
  :name "select/concat_sink: a row slice of WrappingReduceSum over an earlier axis is WrappingReduceSum of the operand's slice"
)
(rule
  (
    (row-sink-demand ?y ?axis ?split ?offset ?extent)
    (row-carry ?y ?x ?entries ?x_shape ?x_axis ?axis)
    (row-carrier ?x ?x_axis ?split)
    (= ?shape (shape-of ?y))
  )
  (
    (row-slice-demand ?x_shape ?x_axis ?offset ?extent)
    (row-slice-demand ?shape ?axis 0 ?extent)
  )
  :ruleset main_ruleset
  :name "select/concat_sink: a row slice of a carrying view demands the operand's slice and the rebasing"
)
(rule
  (
    (row-sink-demand ?y ?axis ?split ?offset ?extent)
    (row-carry ?y ?x ?entries ?x_shape ?x_axis ?axis)
    (row-carrier ?x ?x_axis ?split)
    (= ?shape (shape-of ?y))
    (row-slice ?shape ?axis 0 ?extent ?rebase ?sliced)
  )
  (
    (composed-entries-demand ?entries ?rebase)
  )
  :ruleset main_ruleset
  :name "select/concat_sink: a row slice of a carrying view demands the rebased entries"
)
(rule
  (
    (row-sink-demand ?y ?axis ?split ?offset ?extent)
    (row-carry ?y ?x ?entries ?x_shape ?x_axis ?axis)
    (row-carrier ?x ?x_axis ?split)
    (= ?shape (shape-of ?y))
    (row-slice ?shape ?axis ?offset ?extent ?map ?sliced)
    (row-slice ?shape ?axis 0 ?extent ?rebase ?sliced)
    (composed-entries ?entries ?rebase ?rebased)
    (row-slice ?x_shape ?x_axis ?offset ?extent ?x_map ?x_sliced)
  )
  (
    (union (LogicalIndexMapApply ?y ?map ?sliced)
      (LogicalIndexMapApply
        (LogicalIndexMapApply ?x ?x_map ?x_sliced)
        (IndexMapLit ?rebased ?x_sliced)
        ?sliced))
    (row-sink-demand ?x ?x_axis ?split ?offset ?extent)
  )
  :ruleset main_ruleset
  :name "select/concat_sink: a row slice of a carrying view is the rebased view of the operand's slice"
)
