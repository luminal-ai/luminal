; Forward LayoutTensor Propagation : Logical Floor — elementwise, same layout.
(rule
  (
    (= ?out_logical (LogicalFloor ?in_logical))
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
  )
  (
    (let new_out_layout_tensor (LayoutTensorLit ?out_logical ?in_layout)) ; Forward Propagation
  )
  :ruleset main_ruleset :name "floor/forward_layout: LogicalFloor forwards the input layout"
)
