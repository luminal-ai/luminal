;Dtype Propagation : LogicalWrappingReduceSum
(rule
  (
    (= ?out_logical_tensor (LogicalWrappingReduceSum ?in_logical ?reduction_index))
    (= ?in_dtype (dtype-of ?in_logical))
  )
  (
    (set (dtype-of ?out_logical_tensor) ?in_dtype)
  )
  :ruleset prop
  :name "wrapping_reduce_sum/dtype: dtype of LogicalWrappingReduceSum from its operand"
)
