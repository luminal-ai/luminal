; Forward LayoutTensor Propagation : Logical ReduceSum
(rule
  (
    (= ?out_logical (LogicalWrappingReduceSum ?in_logical ?reduction_dimension))
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
    (= ?bits (bits-of (dtype-of ?out_logical)))
    (= ?shape (shape-of ?out_logical))
  )
  (
    (let out_layout_tensor (LayoutTensorLit ?out_logical (RightMajorContiguousElementLayoutLit ?shape ?bits)))
  )
  :ruleset main_ruleset :name "wrapping_reduce_sum/forward_layout: canonical right-major layout for the summed result"
)
