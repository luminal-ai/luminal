;Dtype Propagation : LogicalConstant — F32, unconditionally (luminal
; parity: their Constant is F32; a typed constant arrives with Cast).
(rule
  (
    (= ?out_logical_tensor (LogicalConstant ?constant_value))
  )
  (
    (set (dtype-of ?out_logical_tensor) (F32))
  )
  :ruleset prop
  :name "constant/dtype: LogicalConstant is F32, unconditionally"
)
