; Forward LayoutTensor Propagation : Logical Recip
(rule
  (
    (= ?out_logical (LogicalRecip ?in_logical))
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
  )
  (
    (let new_out_layout_tensor (LayoutTensorLit ?out_logical ?in_layout)) ; Forward Propagation
  )
  :ruleset main_ruleset :name "recip/forward_layout: LogicalRecip result in the operand's layout"
)
