;Dtype Propagation : LogicalScanSumUnspecified
(rule
  (
    (= ?out_logical_tensor (LogicalScanSumUnspecified ?in_logical ?axis))
    (= ?in_dtype (dtype-of ?in_logical))
  )
  (
    (set (dtype-of ?out_logical_tensor) ?in_dtype)
  )
  :ruleset prop
  :name "scan_sum_unspecified/dtype: dtype of LogicalScanSumUnspecified from its operand"
)
