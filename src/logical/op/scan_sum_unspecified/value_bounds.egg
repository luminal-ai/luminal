; Value bounds : LogicalScanSumUnspecified — every prefix is a sum of k
; elements, 1 <= k <= n_upper, each in [lo, hi]; the k = 1 prefix is the
; element itself, so the bound is [min(lo, n_upper*lo), max(hi, n_upper*hi)].
(rule
  (
    (= ?out (LogicalScanSumUnspecified ?in ?axis))
    (= ?in_shape (shape-of ?in))
    (= ?in_shape (ShapeLit ?dims))
    (= ?extent (expr-list-nth-from-end ?dims ?axis))
    (= ?n_upper (upper-bound-of ?extent))
    (= ?lower (value-lower-bound-of ?in))
    (= ?upper (value-upper-bound-of ?in))
  )
  (
    (set (value-lower-bound-of ?out)
      (min ?lower (* ?n_upper ?lower)))
    (set (value-upper-bound-of ?out)
      (max ?upper (* ?n_upper ?upper)))
  )
  :ruleset main_ruleset :name "scan_sum_unspecified/value_bounds: prefix-sum bounds over prefixes of length 1 to the scanned extent"
)
