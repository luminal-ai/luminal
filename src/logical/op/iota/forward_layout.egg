; Forward LayoutTensor Propagation : Logical Iota — a SOURCE op: no input
; layout tensor exists to propagate from, so the canonical right-major
; contiguous layout tensor is minted directly from the term's own shape
; and dtype (the same canonical choice the reduces make for their outputs).
(rule
  (
    (= ?out_logical (LogicalIota ?index_expression ?shape))
    (= ?bits (bits-of (dtype-of ?out_logical)))
  )
  (
    (let out_layout_tensor (LayoutTensorLit ?out_logical (RightMajorContiguousElementLayoutLit ?shape ?bits)))
  )
)
