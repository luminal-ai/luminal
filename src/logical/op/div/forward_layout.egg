; Forward LayoutTensor Propagation : Logical Div
(rule
  (
    (= ?out_logical (LogicalDiv ?in1_logical ?in2_logical))
    (= ?in1_layout_tensor (LayoutTensorLit ?in1_logical ?in1_layout))
    (= ?in2_layout_tensor (LayoutTensorLit ?in2_logical ?in2_layout))
  )
  (
    (let ?out_layout_tensor1 (LayoutTensorLit ?out_logical ?in1_layout))
    (let ?out_layout_tensor2 (LayoutTensorLit ?out_logical ?in2_layout))
  )
)
