(rule ((= ?out (LogicalBoolsToBits ?in ?dt)) (= (bits-of ?dt) (BitWidthLit ?w))
 (= (shape-of ?out) (ShapeLit ?ods)))
 ((let gdims (BitAppendDim ?ods (IntLit ?w))))
 :ruleset main_ruleset :name "bools_to_bits/group_dims")
(rule ((= ?out (LogicalBoolsToBits ?in ?dt)) (= (bits-of ?dt) (BitWidthLit ?w))
 (= (shape-of ?out) (ShapeLit ?ods)) (= ?gds (BitAppendDim ?ods (IntLit ?w))) (bit-dims-complete ?gds))
 ((let gs (ShapeLit ?gds))) :ruleset main_ruleset :name "bools_to_bits/group_domain")
(rule ((= ?out (LogicalBoolsToBits ?in ?dt)) (= ?os (shape-of ?out)) (= ?w (bits-of ?dt)))
 ((let lt (LayoutTensorLit ?out (RightMajorContiguousElementLayoutLit ?os ?w))))
 :ruleset main_ruleset :name "bools_to_bits/canonical")
; All source coordinates are instantiated inside their own domains by
; core's existing guarded substitution. The maps differ only in the bit lane.
(rule ((= ?out (LogicalBoolsToBits ?in ?dt)) (!= ?dt (Bool8)) (= (bits-of ?dt) (BitWidthLit ?w)) (> ?w 1)
 (= ?is (shape-of ?in)) (= ?is (ShapeLit ?ds)) (= ?rank (rank-of ?is))
 (= ?os (shape-of ?out)) (= ?os (ShapeLit ?ods))
 (= ?gs (ShapeLit (BitAppendDim ?ods (IntLit ?w))))
 (= ?il (BitOffsetExpressionLayoutLit ?p ?is (BitWidthLit 1))) (= ?it (LayoutTensorLit ?in ?il)))
 ((int-subst-demand ?p (IndexMapLit (BitPackCoords ?ds ?os (- ?rank 1) ?w) ?is))
  (int-subst-demand ?p (IndexMapLit (BitGroupCoords ?ds ?gs ?rank ?w) ?is)))
 :ruleset main_ruleset :name "bools_to_bits/demand_compositions")
(rule ((= ?out (LogicalBoolsToBits ?in ?dt)) (!= ?dt (Bool8)) (= (bits-of ?dt) (BitWidthLit ?w)) (> ?w 1)
 (= ?is (shape-of ?in)) (= ?is (ShapeLit ?ds)) (= ?rank (rank-of ?is))
 (= ?os (shape-of ?out)) (= ?os (ShapeLit ?ods))
 (= ?gs (ShapeLit (BitAppendDim ?ods (IntLit ?w))))
 (= ?it (LayoutTensorLit ?in (BitOffsetExpressionLayoutLit ?p ?is (BitWidthLit 1))))
 (= ?group (int-subst-of ?p (IndexMapLit (BitGroupCoords ?ds ?gs ?rank ?w) ?is))))
 ((bit-lane-demand ?group ?gs)) :ruleset main_ruleset :name "bools_to_bits/demand_lane_proof")
; A proof of unit slope throughout the lane domain is equivalent to
; p(c,w*j+k) = p(c,w*j) + k. This avoids constructing AC reassociations
; merely to compare two address spellings.
(rule ((= ?out (LogicalBoolsToBits ?in ?dt)) (!= ?dt (Bool8)) (= (bits-of ?dt) (BitWidthLit ?w)) (> ?w 1)
 (= ?is (shape-of ?in)) (= ?is (ShapeLit ?ds)) (= ?rank (rank-of ?is))
 (= ?os (shape-of ?out)) (= ?os (ShapeLit ?ods))
 (= ?gs (ShapeLit (BitAppendDim ?ods (IntLit ?w))))
 (= ?il (BitOffsetExpressionLayoutLit ?p ?is (BitWidthLit 1))) (= ?it (LayoutTensorLit ?in ?il))
 (= ?base (int-subst-of ?p (IndexMapLit (BitPackCoords ?ds ?os (- ?rank 1) ?w) ?is)))
 (= ?group (int-subst-of ?p (IndexMapLit (BitGroupCoords ?ds ?gs ?rank ?w) ?is)))
 (bit-lane-slope ?group ?gs (bigint 1)))
 ((let ol (BitOffsetExpressionLayoutLit ?base ?os (BitWidthLit ?w)))
  (let lt (LayoutTensorLit ?out ol)) (bit-packing-view ?out ?il ol))
 :ruleset main_ruleset :name "bools_to_bits/proven_view")
; Width one is the identity; never feed a degenerate bit lane to slope inference.
(rule ((= ?out (LogicalBoolsToBits ?in ?dt)) (= (bits-of ?dt) (BitWidthLit 1))
 (= ?is (shape-of ?in)) (= ?is (shape-of ?out))
 (= ?il (BitOffsetExpressionLayoutLit ?p ?is (BitWidthLit 1))) (= ?it (LayoutTensorLit ?in ?il)))
 ((let lt (LayoutTensorLit ?out ?il)) (bit-packing-view ?out ?il ?il))
 :ruleset main_ruleset :name "bools_to_bits/width_one_view")

(rule ((bit-lane-demand ?e ?gs)) ((axis-free-demand ?e 0))
 :ruleset main_ruleset :name "bits/lane_demand_free")
(rule ((bit-lane-demand ?e ?gs) (axis-free ?e 0)) ((bit-lane-slope ?e ?gs (bigint 0)))
 :ruleset main_ruleset :name "bits/lane_free")
(rule ((bit-lane-demand ?e ?gs) (= ?e (CoordVar ?gs 0))) ((bit-lane-slope ?e ?gs (bigint 1)))
 :ruleset main_ruleset :name "bits/lane_coord")
(rule ((bit-lane-demand ?e ?gs) (= ?e (IntAdd ?a ?b)))
 ((bit-lane-demand ?a ?gs) (bit-lane-demand ?b ?gs))
 :ruleset main_ruleset :name "bits/lane_add_demand")
(rule ((bit-lane-demand ?e ?gs) (= ?e (IntAdd ?a ?b))
 (bit-lane-slope ?a ?gs ?sa) (bit-lane-slope ?b ?gs ?sb))
 ((bit-lane-slope ?e ?gs (+ ?sa ?sb))) :ruleset main_ruleset :name "bits/lane_add")
(rule ((bit-lane-demand ?e ?gs) (= ?e (IntMul ?a (IntLit ?c))))
 ((bit-lane-demand ?a ?gs)) :ruleset main_ruleset :name "bits/lane_scale_demand")
(rule ((bit-lane-demand ?e ?gs) (= ?e (IntMul ?a (IntLit ?c))) (bit-lane-slope ?a ?gs ?s))
 ((bit-lane-slope ?e ?gs (* ?s (bigint ?c)))) :ruleset main_ruleset :name "bits/lane_scale")
