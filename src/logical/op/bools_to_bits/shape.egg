(rule ((= ?p (BitPackDims (IntExprCons ?last (IntExprNil)) ?w)))
 ((set (bit-pack-remainder ?last ?w) (IntTruncRem ?last (IntLit ?w)))) :ruleset main_ruleset :name "bits/demand_divisibility")
(rewrite (BitPackDims (IntExprCons ?h (IntExprCons ?next ?tail)) ?w)
 (IntExprCons ?h (BitPackDims (IntExprCons ?next ?tail) ?w))
 :ruleset main_ruleset :name "bits/pack_prefix")
(rule ((= ?packed (BitPackDims (IntExprCons ?last (IntExprNil)) ?w))
 (= (bit-pack-remainder ?last ?w) (IntLit 0)))
 ((union ?packed (IntExprCons (IntTruncDiv ?last (IntLit ?w)) (IntExprNil))))
 :ruleset main_ruleset :name "bits/pack_last")
(rule ((= ?out (LogicalBoolsToBits ?in ?dt)) (= (shape-of ?in) (ShapeLit (IntExprNil))))
 ((panic "BoolsToBits requires a last axis")) :ruleset main_ruleset :name "bits/reject_scalar")
(rule ((= ?p (BitPackDims (IntExprCons (IntLit ?n) (IntExprNil)) ?w)) (!= (% ?n ?w) 0))
 ((panic "BoolsToBits last axis is not divisible by target width")) :ruleset main_ruleset :name "bits/reject_remainder")
(rule ((= ?out (LogicalBoolsToBits ?in ?dt)) (= (shape-of ?in) (ShapeLit ?ds))
 (= (bits-of ?dt) (BitWidthLit ?w)))
 ((let dims (BitPackDims ?ds ?w))) :ruleset main_ruleset :name "bits/pack_demand_shape")
(rule ((= ?out (LogicalBoolsToBits ?in ?dt)) (= (shape-of ?in) (ShapeLit ?ds))
 (= (bits-of ?dt) (BitWidthLit ?w)) (= ?ods (BitPackDims ?ds ?w)) (bit-dims-complete ?ods))
 ((set (shape-of ?out) (ShapeLit ?ods))) :ruleset prop :name "bools_to_bits/shape")
(rewrite (BitPackCoords (IntExprCons ?last (IntExprNil)) ?os 0 ?w)
 (IntExprCons (IntMul (CoordVar ?os 0) (IntLit ?w)) (IntExprNil))
 :ruleset main_ruleset :name "bits/pack_coords_last")
(rewrite (BitPackCoords (IntExprCons ?h (IntExprCons ?next ?tail)) ?os ?axis ?w)
 (IntExprCons (CoordVar ?os ?axis) (BitPackCoords (IntExprCons ?next ?tail) ?os (- ?axis 1) ?w))
 :ruleset main_ruleset :name "bits/pack_coords_prefix")
(rewrite (BitGroupCoords (IntExprCons ?last (IntExprNil)) ?gs 1 ?w)
 (IntExprCons (IntAdd (IntMul (CoordVar ?gs 1) (IntLit ?w)) (CoordVar ?gs 0)) (IntExprNil))
 :ruleset main_ruleset :name "bits/group_coords_last")
(rewrite (BitGroupCoords (IntExprCons ?h (IntExprCons ?next ?tail)) ?gs ?axis ?w)
 (IntExprCons (CoordVar ?gs ?axis) (BitGroupCoords (IntExprCons ?next ?tail) ?gs (- ?axis 1) ?w))
 :ruleset main_ruleset :name "bits/group_coords_prefix")
