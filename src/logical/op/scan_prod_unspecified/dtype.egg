;Dtype Propagation : LogicalScanProdUnspecified
(rule
  (
    (= ?out_logical_tensor (LogicalScanProdUnspecified ?in_logical ?axis))
    (= ?in_dtype (dtype-of ?in_logical))
  )
  (
    (set (dtype-of ?out_logical_tensor) ?in_dtype)
  )
  :ruleset prop
  :name "scan_prod_unspecified/dtype: dtype of LogicalScanProdUnspecified from its operand"
)
