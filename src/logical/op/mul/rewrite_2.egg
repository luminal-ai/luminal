; Logical Associativity : Mul — EXACT DTYPES ONLY (ruling 2026-08-06,
; same policy as Add associativity: f32 multiplication reassociation
; changes rounding/overflow behavior; integer products reassociate
; exactly). One rule per exact dtype; fail-safe on underived dtypes.
(rule
  (
    (= ?product (LogicalMul (LogicalMul ?lhs ?rhs) ?outer))
    (= (Int) (dtype-of ?product))
  )
  (
    (union ?product (LogicalMul ?lhs (LogicalMul ?rhs ?outer)))
  )
  :ruleset main_ruleset :name "mul/rewrite_2: associativity of LogicalMul, Int only"
)
(rule
  (
    (= ?product (LogicalMul (LogicalMul ?lhs ?rhs) ?outer))
    (= (Int64) (dtype-of ?product))
  )
  (
    (union ?product (LogicalMul ?lhs (LogicalMul ?rhs ?outer)))
  )
  :ruleset main_ruleset :name "mul/rewrite_2: associativity of LogicalMul, Int64 only"
)
