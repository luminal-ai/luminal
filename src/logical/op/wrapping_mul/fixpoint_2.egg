(rule
  (
    (= ?out_logical (LogicalWrappingMul ?in1_logical ?in2_logical))
    (= ?out_shape (shape-of ?out_logical))
  )
  (
    (set (shape-of ?in1_logical) ?out_shape)
    (set (shape-of ?in2_logical) ?out_shape)
  )
  :ruleset fixpoint-invariants
  :name "wrapping_mul/fixpoint_2: operand shapes of LogicalWrappingMul from the result"
)
