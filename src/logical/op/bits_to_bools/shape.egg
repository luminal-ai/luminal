(rewrite (BitAppendDim (IntExprNil) ?w) (IntExprCons ?w (IntExprNil))
 :ruleset main_ruleset :name "bits/append_nil")
(rewrite (BitAppendDim (IntExprCons ?h ?t) ?w) (IntExprCons ?h (BitAppendDim ?t ?w))
 :ruleset main_ruleset :name "bits/append_cons")
(rewrite (BitPrefixCoords (IntExprNil) ?s ?axis) (IntExprNil)
 :ruleset main_ruleset :name "bits/prefix_nil")
(rewrite (BitPrefixCoords (IntExprCons ?h ?t) ?s ?axis)
 (IntExprCons (CoordVar ?s ?axis) (BitPrefixCoords ?t ?s (- ?axis 1)))
 :ruleset main_ruleset :name "bits/prefix_cons")
(rule ((= ?ds (IntExprNil))) ((bit-dims-complete ?ds))
 :ruleset main_ruleset :name "bits/dims_nil")
(rule ((= ?ds (IntExprCons ?h ?t)) (bit-dims-complete ?t)) ((bit-dims-complete ?ds))
 :ruleset main_ruleset :name "bits/dims_cons")
(rule ((= ?out (LogicalBitsToBools ?in)) (= (shape-of ?in) (ShapeLit ?ds))
 (= (bits-of (dtype-of ?in)) (BitWidthLit ?w)))
 ((let dims (BitAppendDim ?ds (IntLit ?w)))) :ruleset main_ruleset :name "bits/unpack_demand_shape")
(rule ((= ?out (LogicalBitsToBools ?in)) (= (shape-of ?in) (ShapeLit ?ds))
 (= (bits-of (dtype-of ?in)) (BitWidthLit ?w))
 (= ?ods (BitAppendDim ?ds (IntLit ?w))) (bit-dims-complete ?ods))
 ((set (shape-of ?out) (ShapeLit ?ods))) :ruleset prop :name "bits_to_bools/shape")
