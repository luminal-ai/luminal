; A split of an encoding observes exactly its original accessed bit set.
(rule ((= ?out (LogicalBitsToBools ?in)) (= ?os (shape-of ?out)))
 ((let lt (LayoutTensorLit ?out (RightMajorContiguousElementLayoutLit ?os (BitWidthLit 1)))))
 :ruleset main_ruleset :name "bits_to_bools/canonical")
(rule ((= ?out (LogicalBitsToBools ?in)) (= ?iw (bits-of (dtype-of ?in))) (= ?is (shape-of ?in)) (= ?is (ShapeLit ?ds))
 (= ?rank (rank-of ?is)) (= ?os (shape-of ?out))
 (= ?il (BitOffsetExpressionLayoutLit ?p ?is ?iw))
 (= ?it (LayoutTensorLit ?in ?il)))
 ((let map (IndexMapLit (BitPrefixCoords ?ds ?os ?rank) ?is))
  (int-subst-demand ?p map))
 :ruleset main_ruleset :name "bits_to_bools/demand_composition")
(rule ((= ?out (LogicalBitsToBools ?in)) (= ?iw (bits-of (dtype-of ?in))) (= ?is (shape-of ?in)) (= ?is (ShapeLit ?ds))
 (= ?rank (rank-of ?is)) (= ?os (shape-of ?out))
 (= ?it (LayoutTensorLit ?in (BitOffsetExpressionLayoutLit ?p ?is ?iw)))
 (= ?base (int-subst-of ?p (IndexMapLit (BitPrefixCoords ?ds ?os ?rank) ?is))))
 ((let ol (BitOffsetExpressionLayoutLit (IntAdd ?base (CoordVar ?os 0)) ?os (BitWidthLit 1)))
 (let lt (LayoutTensorLit ?out ol))
 (bit-splitting-view ?out (BitOffsetExpressionLayoutLit ?p ?is ?iw) ol))
 :ruleset main_ruleset :name "bits_to_bools/view_layout")
