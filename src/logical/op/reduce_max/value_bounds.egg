; Value bounds : LogicalReduceMax — max never leaves the operand range.
(rule
  (
    (= ?out (LogicalReduceMax ?in ?axis))
    (= ?lower (value-lower-bound-of ?in))
  )
  ((set (value-lower-bound-of ?out) ?lower))
  :ruleset main_ruleset :name "reduce_max/value_bounds: lower bound of a max is the operand's lower bound"
)
(rule
  (
    (= ?out (LogicalReduceMax ?in ?axis))
    (= ?upper (value-upper-bound-of ?in))
  )
  ((set (value-upper-bound-of ?out) ?upper))
  :ruleset main_ruleset :name "reduce_max/value_bounds: upper bound of a max is the operand's upper bound"
)
