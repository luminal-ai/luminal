; Shape Propagation : LogicalReduceMax

; Trigger analysis
(rule
  (
    (= ?out_logical (LogicalReduceMax ?in_logical ?reduction_index))
    (= (shape-of ?in_logical) (ShapeLit ?dims))
  )
  (
    (expr-list-remove-axis-root-demand ?dims ?reduction_index)
  )
  :ruleset main_ruleset :name "reduce_max/seed: demand removal of the reduced axis from the dims"
)
