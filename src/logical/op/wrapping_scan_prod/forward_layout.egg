; Forward LayoutTensor Propagation : LogicalWrappingScanProd
(rule
  (
    (= ?out_logical (LogicalWrappingScanProd ?in_logical ?axis))
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
    (= ?bits (bits-of (dtype-of ?out_logical)))
    (= ?shape (shape-of ?out_logical))
  )
  (
    (let out_layout_tensor (LayoutTensorLit ?out_logical (RightMajorContiguousElementLayoutLit ?shape ?bits)))
  )
  :ruleset main_ruleset :name "wrapping_scan_prod/forward_layout: canonical right-major layout for the scanned result"
)
