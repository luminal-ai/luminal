;Dtype Propagation : LogicalWrappingScanProd
(rule
  (
    (= ?out_logical_tensor (LogicalWrappingScanProd ?in_logical ?axis))
    (= ?in_dtype (dtype-of ?in_logical))
  )
  (
    (set (dtype-of ?out_logical_tensor) ?in_dtype)
  )
  :ruleset prop
  :name "wrapping_scan_prod/dtype: dtype of LogicalWrappingScanProd from its operand"
)
