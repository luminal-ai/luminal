; Value bounds : LogicalCast. The Bool -> Int indicator is [0, 1];
; Int <-> Int64 conversions preserve values (the runtime checks
; narrowing exactness; bounds carry over soundly either way).
(rule
  (
    (= ?out (LogicalCast ?in (Int)))
    (= (dtype-of ?in) (Bool))
  )
  (
    (set (value-lower-bound-of ?out) (bigint 0))
    (set (value-upper-bound-of ?out) (bigint 1))
  )
  :ruleset main_ruleset :name "cast/value_bounds: Bool to Int cast is the indicator [0, 1]"
)
(rule
  (
    (= ?out (LogicalCast ?in (Int64)))
    (= (dtype-of ?in) (Bool))
  )
  (
    (set (value-lower-bound-of ?out) (bigint 0))
    (set (value-upper-bound-of ?out) (bigint 1))
  )
  :ruleset main_ruleset :name "cast/value_bounds: Bool to Int64 cast is the indicator [0, 1]"
)
(rule
  (
    (= ?out (LogicalCast ?in (Int64)))
    (= (dtype-of ?in) (Int))
    (= ?lower (value-lower-bound-of ?in))
  )
  ((set (value-lower-bound-of ?out) ?lower))
  :ruleset main_ruleset :name "cast/value_bounds: Int to Int64 cast carries the lower bound"
)
(rule
  (
    (= ?out (LogicalCast ?in (Int64)))
    (= (dtype-of ?in) (Int))
    (= ?upper (value-upper-bound-of ?in))
  )
  ((set (value-upper-bound-of ?out) ?upper))
  :ruleset main_ruleset :name "cast/value_bounds: Int to Int64 cast carries the upper bound"
)
(rule
  (
    (= ?out (LogicalCast ?in (Int)))
    (= (dtype-of ?in) (Int64))
    (= ?lower (value-lower-bound-of ?in))
  )
  ((set (value-lower-bound-of ?out) ?lower))
  :ruleset main_ruleset :name "cast/value_bounds: Int64 to Int cast carries the lower bound"
)
(rule
  (
    (= ?out (LogicalCast ?in (Int)))
    (= (dtype-of ?in) (Int64))
    (= ?upper (value-upper-bound-of ?in))
  )
  ((set (value-upper-bound-of ?out) ?upper))
  :ruleset main_ruleset :name "cast/value_bounds: Int64 to Int cast carries the upper bound"
)

; UInt64 is a wrapping unsigned ring. Its domain bounds are always sound;
; signed-to-unsigned casts refine them only inside one modulo interval.
(rule ((= (dtype-of ?out) (UInt64)))
 ((set (value-lower-bound-of ?out) (bigint 0))
  (set (value-upper-bound-of ?out) (- (* (bigint 4294967296) (bigint 4294967296)) (bigint 1))))
 :ruleset main_ruleset :name "uint64/value_bounds: unsigned storage domain")
(rule ((= ?out (LogicalCast ?in (UInt64)))
       (= ?lo (value-lower-bound-of ?in)) (= ?hi (value-upper-bound-of ?in))
       (>= ?lo (bigint 0)) (< ?hi (* (bigint 4294967296) (bigint 4294967296))))
 ((set (value-lower-bound-of ?out) ?lo) (set (value-upper-bound-of ?out) ?hi))
 :ruleset main_ruleset :name "uint64/value_bounds: nonnegative cast interval")
(rule ((= ?out (LogicalCast ?in (UInt64)))
       (= ?lo (value-lower-bound-of ?in)) (= ?hi (value-upper-bound-of ?in))
       (>= ?lo (bigint -9223372036854775808)) (< ?hi (bigint 0)))
 ((set (value-lower-bound-of ?out) (+ ?lo (* (bigint 4294967296) (bigint 4294967296))))
  (set (value-upper-bound-of ?out) (+ ?hi (* (bigint 4294967296) (bigint 4294967296)))))
 :ruleset main_ruleset :name "uint64/value_bounds: negative cast wraps by 2^64")

; A bounded UInt64 -> Int conversion preserves its interval when every
; source value fits. Outside this interval the conversion may wrap, so it
; must not carry the unsigned bounds into signed arithmetic.
(rule ((= ?out (LogicalCast ?in (Int)))
       (= (dtype-of ?in) (UInt64))
       (= ?lo (value-lower-bound-of ?in)) (= ?hi (value-upper-bound-of ?in))
       (>= ?lo (bigint 0)) (<= ?hi (bigint 2147483647)))
 ((set (value-lower-bound-of ?out) ?lo)
  (set (value-upper-bound-of ?out) ?hi))
 :ruleset main_ruleset :name "cast/value_bounds: in-range UInt64 to Int preserves bounds")

; Storage bounds through casts (2026-10-28). Narrow-integer storage
; always lies in its own dtype's range (narrow ints wrap), so a widening
; cast to Int / Int64 carries the SOURCE dtype's range. Int -> Int64 does
; NOT: an Int source may be an arithmetic result, and its dtype range
; would assume that arithmetic did not overflow (the carry rules above
; pass on whatever the lattice proved instead).
(rule ((= ?out (LogicalCast ?in (Int))) (= (dtype-of ?in) (I8)))
 ((set (value-lower-bound-of ?out) (bigint -128))
  (set (value-upper-bound-of ?out) (bigint 127)))
 :ruleset main_ruleset :name "cast/value_bounds: I8 to Int carries the I8 range")
(rule ((= ?out (LogicalCast ?in (Int64))) (= (dtype-of ?in) (I8)))
 ((set (value-lower-bound-of ?out) (bigint -128))
  (set (value-upper-bound-of ?out) (bigint 127)))
 :ruleset main_ruleset :name "cast/value_bounds: I8 to Int64 carries the I8 range")
(rule ((= ?out (LogicalCast ?in (Int))) (= (dtype-of ?in) (U8)))
 ((set (value-lower-bound-of ?out) (bigint 0))
  (set (value-upper-bound-of ?out) (bigint 255)))
 :ruleset main_ruleset :name "cast/value_bounds: U8 to Int carries the U8 range")
(rule ((= ?out (LogicalCast ?in (Int64))) (= (dtype-of ?in) (U8)))
 ((set (value-lower-bound-of ?out) (bigint 0))
  (set (value-upper-bound-of ?out) (bigint 255)))
 :ruleset main_ruleset :name "cast/value_bounds: U8 to Int64 carries the U8 range")
(rule ((= ?out (LogicalCast ?in (Int))) (= (dtype-of ?in) (I16)))
 ((set (value-lower-bound-of ?out) (bigint -32768))
  (set (value-upper-bound-of ?out) (bigint 32767)))
 :ruleset main_ruleset :name "cast/value_bounds: I16 to Int carries the I16 range")
(rule ((= ?out (LogicalCast ?in (Int64))) (= (dtype-of ?in) (I16)))
 ((set (value-lower-bound-of ?out) (bigint -32768))
  (set (value-upper-bound-of ?out) (bigint 32767)))
 :ruleset main_ruleset :name "cast/value_bounds: I16 to Int64 carries the I16 range")
(rule ((= ?out (LogicalCast ?in (Int))) (= (dtype-of ?in) (U16)))
 ((set (value-lower-bound-of ?out) (bigint 0))
  (set (value-upper-bound-of ?out) (bigint 65535)))
 :ruleset main_ruleset :name "cast/value_bounds: U16 to Int carries the U16 range")
(rule ((= ?out (LogicalCast ?in (Int64))) (= (dtype-of ?in) (U16)))
 ((set (value-lower-bound-of ?out) (bigint 0))
  (set (value-upper-bound-of ?out) (bigint 65535)))
 :ruleset main_ruleset :name "cast/value_bounds: U16 to Int64 carries the U16 range")

; A narrowing or unsigned-to-signed cast yields a stored value of the
; TARGET dtype (Int64 -> Int is checked; UInt64 -> signed may wrap), so
; the result lies in the target range; carried source bounds tighten it.
(rule ((= ?out (LogicalCast ?in (Int))) (= (dtype-of ?in) (Int64)))
 ((set (value-lower-bound-of ?out) (bigint -2147483648))
  (set (value-upper-bound-of ?out) (bigint 2147483647)))
 :ruleset main_ruleset :name "cast/value_bounds: Int64 to Int lies in the Int range")
(rule ((= ?out (LogicalCast ?in (Int))) (= (dtype-of ?in) (UInt64)))
 ((set (value-lower-bound-of ?out) (bigint -2147483648))
  (set (value-upper-bound-of ?out) (bigint 2147483647)))
 :ruleset main_ruleset :name "cast/value_bounds: UInt64 to Int lies in the Int range")
(rule ((= ?out (LogicalCast ?in (Int64))) (= (dtype-of ?in) (UInt64)))
 ((set (value-lower-bound-of ?out) (bigint -9223372036854775808))
  (set (value-upper-bound-of ?out) (bigint 9223372036854775807)))
 :ruleset main_ruleset :name "cast/value_bounds: UInt64 to Int64 lies in the Int64 range")
