; Forward LayoutTensor Propagation : LogicalAllReduce
(rule
  (
    (= ?out_logical (LogicalAllReduce ?in_logical ?group ?width ?sequence))
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
    (= ?bits (bits-of (dtype-of ?out_logical)))
    (= ?shape (shape-of ?out_logical))
  )
  (
    (let out_layout_tensor (LayoutTensorLit ?out_logical (RightMajorContiguousElementLayoutLit ?shape ?bits)))
  )
  :ruleset main_ruleset :name "all_reduce/forward_layout: canonical right-major layout for the reduced tensor"
)
