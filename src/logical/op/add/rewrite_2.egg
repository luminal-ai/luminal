; Logical Associativity : Add — EXACT DTYPES ONLY (ruling 2026-08-06).
; f32 addition is NOT associative: reassociating x·ind + fill + (−fill·ind)
; with fill = −3.4e38 absorbs x entirely (ULP(3.4e38) ≈ 3.9e31).
; Integer addition reassociates exactly, so
; the weld fires only on classes whose dtype is PROVEN integral — one rule
; per exact dtype (fail-safe: an underived dtype fires nothing). A future
; fast-math tier may reintroduce the float weld as an opt-in.
(rule
  (
    (= ?sum (LogicalAdd (LogicalAdd ?lhs ?rhs) ?outer))
    (= (Int) (dtype-of ?sum))
  )
  (
    (union ?sum (LogicalAdd ?lhs (LogicalAdd ?rhs ?outer)))
  )
  :ruleset main_ruleset :name "add/rewrite_2: associativity of LogicalAdd, Int only"
)
(rule
  (
    (= ?sum (LogicalAdd (LogicalAdd ?lhs ?rhs) ?outer))
    (= (Int64) (dtype-of ?sum))
  )
  (
    (union ?sum (LogicalAdd ?lhs (LogicalAdd ?rhs ?outer)))
  )
  :ruleset main_ruleset :name "add/rewrite_2: associativity of LogicalAdd, Int64 only"
)
