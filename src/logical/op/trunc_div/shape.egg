; Shape Propagation : LogicalTruncDiv — positively gated (see LogicalAdd).
(rule
  (
    (= ?out_logical (LogicalTruncDiv ?in1_logical ?in2_logical))
    (= ?shape (shape-of ?in1_logical))
    (= ?shape (shape-of ?in2_logical))
  )
  (
    (set (shape-of ?out_logical) ?shape)
  )
  :ruleset prop
  :name "trunc_div/shape: shape of LogicalTruncDiv at agreeing operand shapes"
)
