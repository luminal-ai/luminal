; Value bounds : LogicalTruncDiv — truncating-quotient corners, divisor
; bounds excluding zero (fail-closed; the scalar IntTruncDiv shape).
(rule
  (
    (= ?out (LogicalTruncDiv ?lhs ?rhs))
    (= ?lhs_lower (value-lower-bound-of ?lhs))
    (= ?lhs_upper (value-upper-bound-of ?lhs))
    (= ?rhs_lower (value-lower-bound-of ?rhs))
    (= ?rhs_upper (value-upper-bound-of ?rhs))
    (>= ?rhs_lower (bigint 1))
  )
  (
    (set (value-lower-bound-of ?out)
      (min (min (/ ?lhs_lower ?rhs_lower) (/ ?lhs_lower ?rhs_upper))
           (min (/ ?lhs_upper ?rhs_lower) (/ ?lhs_upper ?rhs_upper))))
    (set (value-upper-bound-of ?out)
      (max (max (/ ?lhs_lower ?rhs_lower) (/ ?lhs_lower ?rhs_upper))
           (max (/ ?lhs_upper ?rhs_lower) (/ ?lhs_upper ?rhs_upper))))
  )
)
(rule
  (
    (= ?out (LogicalTruncDiv ?lhs ?rhs))
    (= ?lhs_lower (value-lower-bound-of ?lhs))
    (= ?lhs_upper (value-upper-bound-of ?lhs))
    (= ?rhs_lower (value-lower-bound-of ?rhs))
    (= ?rhs_upper (value-upper-bound-of ?rhs))
    (<= ?rhs_upper (bigint -1))
  )
  (
    (set (value-lower-bound-of ?out)
      (min (min (/ ?lhs_lower ?rhs_lower) (/ ?lhs_lower ?rhs_upper))
           (min (/ ?lhs_upper ?rhs_lower) (/ ?lhs_upper ?rhs_upper))))
    (set (value-upper-bound-of ?out)
      (max (max (/ ?lhs_lower ?rhs_lower) (/ ?lhs_lower ?rhs_upper))
           (max (/ ?lhs_upper ?rhs_lower) (/ ?lhs_upper ?rhs_upper))))
  )
)
