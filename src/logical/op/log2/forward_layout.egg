; Forward LayoutTensor Propagation : Logical Log2
(rule
  (
    (= ?out_logical (LogicalLog2 ?in_logical))
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
  )
  (
    (let new_out_layout_tensor (LayoutTensorLit ?out_logical ?in_layout)) ; Forward Propagation
  )
  :ruleset main_ruleset :name "log2/forward_layout: LogicalLog2 forwards the input layout"
)
