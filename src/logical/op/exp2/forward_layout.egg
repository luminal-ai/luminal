; Forward LayoutTensor Propagation : Logical Exp2
(rule
  (
    (= ?out_logical (LogicalExp2 ?in_logical))
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
  )
  (
    (let new_out_layout_tensor (LayoutTensorLit ?out_logical ?in_layout)) ; Forward Propagation
  )
  :ruleset main_ruleset :name "exp2/forward_layout: LogicalExp2 forwards the input layout"
)
