;Dtype Propagation : LogicalLessThan — the result is Bool, always; the
; operand dtypes must agree with EACH OTHER (atom tripwire — legal for
; atoms, which can never become equal later).
(rule
  (
    (= ?out_logical_tensor (LogicalLessThan ?in1_logical ?in2_logical))
  )
  (
    (set (dtype-of ?out_logical_tensor) (Bool))
  )
  :ruleset prop
)
