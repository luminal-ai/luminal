; Forward LayoutTensor Propagation : Logical LessThan — the result is
; Bool (8-bit), so the operands' layouts CANNOT be forwarded (their bit
; widths belong to the operand dtypes): the canonical layout is minted
; from the output's own shape and dtype, the Cast pattern.
(rule
  (
    (= ?out_logical (LogicalLessThan ?in1_logical ?in2_logical))
    (= ?in1_layout_tensor (LayoutTensorLit ?in1_logical ?in1_layout))
    (= ?bits (bits-of (dtype-of ?out_logical)))
    (= ?shape (shape-of ?out_logical))
  )
  (
    (let out_layout_tensor (LayoutTensorLit ?out_logical (RightMajorContiguousElementLayoutLit ?shape ?bits)))
  )
)
