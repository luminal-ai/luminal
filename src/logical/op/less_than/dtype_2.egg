(rule
  (
    (= ?out_logical_tensor (LogicalLessThan ?in1_logical ?in2_logical))
    (= ?in1_dtype (dtype-of ?in1_logical))
    (= ?in2_dtype (dtype-of ?in2_logical))
    (!= ?in1_dtype ?in2_dtype)
  )
  (
    (panic "LogicalLessThan operands must share one dtype")
  )
  :ruleset main_ruleset :name "less_than/dtype_2: refuse LogicalLessThan on disagreeing operand dtypes"
)
