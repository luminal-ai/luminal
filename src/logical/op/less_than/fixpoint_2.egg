(rule
  (
    (= ?out_logical (LogicalLessThan ?in1_logical ?in2_logical))
    (= ?out_shape (shape-of ?out_logical))
  )
  (
    (set (shape-of ?in1_logical) ?out_shape)
    (set (shape-of ?in2_logical) ?out_shape)
  )
  :ruleset fixpoint-invariants
  :name "less_than/fixpoint_2: LogicalLessThan shape closure, output to operands"
)
