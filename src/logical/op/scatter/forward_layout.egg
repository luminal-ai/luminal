; Forward LayoutTensor Propagation : Logical Scatter — two mints: the
; canonical fresh result, AND the result in INIT's OWN layout — the home
; of the in-place (mutating) candidate, whose match requires exactly
; that layout equality.
(rule
  (
    (= ?out_logical (LogicalScatter ?init_logical ?coordinate_list ?src_logical))
    (= ?bits (bits-of (dtype-of ?out_logical)))
    (= ?shape (shape-of ?out_logical))
  )
  (
    (let out_layout_tensor (LayoutTensorLit ?out_logical (RightMajorContiguousElementLayoutLit ?shape ?bits)))
  )
)
