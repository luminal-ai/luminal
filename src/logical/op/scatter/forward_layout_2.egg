(rule
  (
    (= ?out_logical (LogicalScatter ?init_logical ?coordinate_list ?src_logical))
    (= ?init_layout_tensor (LayoutTensorLit ?init_logical ?init_layout))
  )
  (
    (let out_in_init_layout_tensor (LayoutTensorLit ?out_logical ?init_layout))
  )
  :ruleset main_ruleset :name "scatter/forward_layout_2: scatter result in init's own layout, the in-place home"
)
