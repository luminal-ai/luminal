; Relations preserve independently proved readings. The normalization cell is
; keyed by BOTH extent and input witness; it does not choose between live-axis
; coefficients. Only a static IntLit(1) proof can introduce Any.
(function element-stride-normalized-axis (IntExpr ElementStride) ElementStride
  :merge (element-stride-prefer-any old new))
(relation element-stride-coordinate-free-expression (IntExpr))
(rule ((= ?e (IntLit ?n))) ((element-stride-coordinate-free-expression ?e)) :ruleset main_ruleset)
(rule ((= ?e (IntVar ?n))) ((element-stride-coordinate-free-expression ?e)) :ruleset main_ruleset)
(rule ((= ?e (IntAdd ?a ?b)) (element-stride-coordinate-free-expression ?a) (element-stride-coordinate-free-expression ?b))
 ((element-stride-coordinate-free-expression ?e)) :ruleset main_ruleset)
(rule ((= ?e (IntMul ?a ?b)) (element-stride-coordinate-free-expression ?a) (element-stride-coordinate-free-expression ?b))
 ((element-stride-coordinate-free-expression ?e)) :ruleset main_ruleset)
(rule ((= ?e (IntTruncDiv ?a ?b)) (element-stride-coordinate-free-expression ?a) (element-stride-coordinate-free-expression ?b))
 ((element-stride-coordinate-free-expression ?e)) :ruleset main_ruleset)
(rule ((= ?e (IntTruncRem ?a ?b)) (element-stride-coordinate-free-expression ?a) (element-stride-coordinate-free-expression ?b))
 ((element-stride-coordinate-free-expression ?e)) :ruleset main_ruleset)
(rule ((= ?e (IntCeilDiv ?a ?b)) (element-stride-coordinate-free-expression ?a) (element-stride-coordinate-free-expression ?b))
 ((element-stride-coordinate-free-expression ?e)) :ruleset main_ruleset)
(rule ((= ?e (IntMin ?a ?b)) (element-stride-coordinate-free-expression ?a) (element-stride-coordinate-free-expression ?b))
 ((element-stride-coordinate-free-expression ?e)) :ruleset main_ruleset)
(rule ((= ?e (IntMax ?a ?b)) (element-stride-coordinate-free-expression ?a) (element-stride-coordinate-free-expression ?b))
 ((element-stride-coordinate-free-expression ?e)) :ruleset main_ruleset)
(rule ((= ?e (IntCastFromBool (BoolLessThanInt ?a ?b))) (element-stride-coordinate-free-expression ?a) (element-stride-coordinate-free-expression ?b))
 ((element-stride-coordinate-free-expression ?e)) :ruleset main_ruleset)
(relation element-stride-normalization-demand (IntExprList ElementStrideList))
(relation element-stride-normalized-list (IntExprList ElementStrideList ElementStrideList))
(rule ((element-stride-normalization-demand (IntExprNil) (ElementStrideNil)))
 ((element-stride-normalized-list (IntExprNil) (ElementStrideNil) (ElementStrideNil))) :ruleset main_ruleset)
(rule ((element-stride-normalization-demand (IntExprCons ?e ?et) (ElementStrideCons ?s ?st)))
 ((element-stride-normalization-demand ?et ?st)) :ruleset main_ruleset)
(rule ((element-stride-normalization-demand (IntExprCons ?e ?et)
          (ElementStrideCons (ElementStrideExact ?s) ?st))
       (element-stride-coordinate-free-expression ?s) (>= (lower-bound-of ?s) (bigint 0)))
 ((set (element-stride-normalized-axis ?e (ElementStrideExact ?s)) (ElementStrideExact ?s)))
 :ruleset main_ruleset :name "element-stride: retain a valid exact coefficient")
(rule ((element-stride-normalization-demand (IntExprCons (IntLit 1) ?et) (ElementStrideCons ?s ?st)))
 ((set (element-stride-normalized-axis (IntLit 1) ?s) (ElementStrideAny)))
 :ruleset main_ruleset :name "element-stride: only a static singleton normalizes to Any")
(rule ((element-stride-normalization-demand (IntExprCons ?e ?et) (ElementStrideCons ?s ?st))
       (= ?n (element-stride-normalized-axis ?e ?s)) (element-stride-normalized-list ?et ?st ?nt))
 ((element-stride-normalized-list (IntExprCons ?e ?et) (ElementStrideCons ?s ?st) (ElementStrideCons ?n ?nt)))
 :ruleset main_ruleset)
(rule ((= ?l (ElementStridedLayoutLit (ShapeLit ?dims) ?ss ?w)))
 ((element-stride-normalization-demand ?dims ?ss)) :ruleset main_ruleset)
(rule ((= ?l (ElementStridedLayoutLit ?shape ?ss ?w)) (= ?shape (ShapeLit ?dims))
       (element-stride-normalized-list ?dims ?ss ?ns))
 ((union ?l (ElementStridedLayoutLit ?shape ?ns ?w))) :ruleset main_ruleset)

; Existing authored scalar strides are a trusted source of exact coefficients,
; including dynamic extents spanning one. No factor is recovered from a zero class.
(relation element-stride-list-from-expressions-demand (IntExprList))
(relation element-stride-list-from-expressions (IntExprList ElementStrideList))
(rule ((element-stride-list-from-expressions-demand (IntExprNil)))
 ((element-stride-list-from-expressions (IntExprNil) (ElementStrideNil))) :ruleset main_ruleset)
(rule ((element-stride-list-from-expressions-demand (IntExprCons ?s ?ss))) ((element-stride-list-from-expressions-demand ?ss)) :ruleset main_ruleset)
(rule ((element-stride-list-from-expressions-demand (IntExprCons ?s ?ss)) (element-stride-list-from-expressions ?ss ?packed))
 ((element-stride-list-from-expressions (IntExprCons ?s ?ss) (ElementStrideCons (ElementStrideExact ?s) ?packed)))
 :ruleset main_ruleset)
(rule ((strided-lists ?l ?shape ?dims ?ss ?w)) ((element-stride-list-from-expressions-demand ?ss)) :ruleset main_ruleset)
(rule ((strided-lists ?l ?shape ?dims ?ss ?w) (element-stride-list-from-expressions ?ss ?packed))
 ((union ?l (ElementStridedLayoutLit ?shape ?packed ?w))) :ruleset main_ruleset)

; The reverse bridge selects zero for a singleton Any. It is an address-equivalent
; representative, never an equality between global Any and Exact(0) values.
(relation element-stride-expressions-from-list-demand (IntExprList ElementStrideList))
(relation element-stride-expressions-from-list (IntExprList ElementStrideList IntExprList))
(rule ((element-stride-expressions-from-list-demand (IntExprNil) (ElementStrideNil)))
 ((element-stride-expressions-from-list (IntExprNil) (ElementStrideNil) (IntExprNil))) :ruleset main_ruleset)
(rule ((element-stride-expressions-from-list-demand (IntExprCons ?e ?et) (ElementStrideCons ?s ?st)))
 ((element-stride-expressions-from-list-demand ?et ?st)) :ruleset main_ruleset)
(rule ((element-stride-expressions-from-list-demand (IntExprCons ?e ?et) (ElementStrideCons (ElementStrideExact ?s) ?st))
       (element-stride-coordinate-free-expression ?s) (>= (lower-bound-of ?s) (bigint 0)) (element-stride-expressions-from-list ?et ?st ?tail))
 ((element-stride-expressions-from-list (IntExprCons ?e ?et) (ElementStrideCons (ElementStrideExact ?s) ?st)
    (IntExprCons ?s ?tail))) :ruleset main_ruleset)
(rule ((element-stride-expressions-from-list-demand (IntExprCons (IntLit 1) ?et) (ElementStrideCons (ElementStrideAny) ?st))
       (element-stride-expressions-from-list ?et ?st ?tail))
 ((element-stride-expressions-from-list (IntExprCons (IntLit 1) ?et) (ElementStrideCons (ElementStrideAny) ?st)
    (IntExprCons (IntLit 0) ?tail))) :ruleset main_ruleset)
(rule ((= ?l (ElementStridedLayoutLit (ShapeLit ?dims) ?ss ?w)))
 ((element-stride-expressions-from-list-demand ?dims ?ss)) :ruleset main_ruleset)
(rule ((= ?l (ElementStridedLayoutLit ?shape ?ss ?w)) (= ?shape (ShapeLit ?dims))
       (element-stride-expressions-from-list ?dims ?ss ?plain))
 ((strided-lists ?l ?shape ?dims ?plain ?w)) :ruleset main_ruleset)

; Contiguity is a comparison between contextual stride-list presentations.
; Mint candidate constructors, then let their ordinary source seams produce
; normalized lists. These are equality proofs, not compatibility/wildcard tests.
(rule ((= ?l (ElementStridedLayoutLit ?shape ?ss ?w)))
 ((RightMajorContiguousElementLayoutLit ?shape ?w)
  (LeftMajorContiguousElementLayoutLit ?shape ?w)) :ruleset main_ruleset)
(rule ((= ?l (ElementStridedLayoutLit ?shape ?ss ?w))
       (= ?r (RightMajorContiguousElementLayoutLit ?shape ?w))
       (= ?r (ElementStridedLayoutLit ?shape ?ss ?w)))
 ((union ?l ?r)) :ruleset main_ruleset :name "element-stride: right-major equality")
(rule ((= ?l (ElementStridedLayoutLit ?shape ?ss ?w))
       (= ?r (LeftMajorContiguousElementLayoutLit ?shape ?w))
       (= ?r (ElementStridedLayoutLit ?shape ?ss ?w)))
 ((union ?l ?r)) :ruleset main_ruleset :name "element-stride: left-major equality")

; A layout/axis query preserves every independently proved reading as a fact.
; Validate the complete list before exposing any axis, so malformed ranks and
; live-axis Any witnesses cannot contribute a valid-looking prefix.
(relation element-stride-axis-walk (Layout IntExprList ElementStrideList))
(relation element-stride-readings-of (Layout i64 ElementStride))
(rule ((= ?layout (ElementStridedLayoutLit (ShapeLit ?dimensions) ?strides ?width))
       (element-stride-expressions-from-list ?dimensions ?strides ?plain))
 ((element-stride-axis-walk ?layout ?dimensions ?strides)) :ruleset main_ruleset)
(rule ((element-stride-axis-walk ?layout (IntExprCons ?extent ?extents) (ElementStrideCons ?stride ?strides))
       (= ?axis (expr-list-length-of ?extents)) (= ?normalized (element-stride-normalized-axis ?extent ?stride)))
 ((element-stride-readings-of ?layout ?axis ?normalized)
  (element-stride-axis-walk ?layout ?extents ?strides)) :ruleset main_ruleset)

; Backend-facing tensor facts retain the shape and dtype checks at the seam.
(relation element-stride-reading (LayoutTensor i64 ElementStride))
(rule ((= ?tensor (LayoutTensorLit ?value ?layout)) (= ?layout (ElementStridedLayoutLit ?shape ?strides ?width))
       (= ?shape (shape-of ?value)) (= ?width (bits-of (dtype-of ?value)))
       (element-stride-readings-of ?layout ?axis ?stride))
 ((element-stride-reading ?tensor ?axis ?stride)) :ruleset main_ruleset)

; Native view composition. It needs no parent offset-expression presentation.
; This initial grammar handles permutations, broadcasts, zero selections and
; diagonals. Arithmetic entries (e.g. a nonzero slice origin) deliberately stall.
(relation element-stride-zero-list (IntExprList ElementStrideList))
(rule ((= ?dims (IntExprNil))) ((element-stride-zero-list ?dims (ElementStrideNil))) :ruleset main_ruleset)
(rule ((= ?dims (IntExprCons ?e ?et)) (element-stride-zero-list ?et ?tail))
 ((element-stride-zero-list ?dims (ElementStrideCons (ElementStrideExact (IntLit 0)) ?tail))) :ruleset main_ruleset)
(relation element-stride-list-length (ElementStrideList i64))
(rule ((= ?ss (ElementStrideNil))) ((element-stride-list-length ?ss 0)) :ruleset main_ruleset)
(rule ((= ?ss (ElementStrideCons ?s ?st)) (element-stride-list-length ?st ?n))
 ((element-stride-list-length ?ss (+ ?n 1))) :ruleset main_ruleset)
(relation element-stride-accumulate-at-axis-demand (ElementStrideList i64 IntExpr))
(relation element-stride-accumulated-at-axis (ElementStrideList i64 IntExpr ElementStrideList))
(rule ((element-stride-accumulate-at-axis-demand (ElementStrideCons ?s ?st) ?axis ?value)
       (element-stride-list-length ?st ?n) (> ?n ?axis))
 ((element-stride-accumulate-at-axis-demand ?st ?axis ?value)) :ruleset main_ruleset)
(rule ((element-stride-accumulate-at-axis-demand (ElementStrideCons (ElementStrideExact ?s) ?st) ?axis ?value)
       (element-stride-list-length ?st ?axis))
 ((element-stride-accumulated-at-axis (ElementStrideCons (ElementStrideExact ?s) ?st) ?axis ?value
    (ElementStrideCons (ElementStrideExact (IntAdd ?s ?value)) ?st))) :ruleset main_ruleset)
(rule ((element-stride-accumulate-at-axis-demand (ElementStrideCons ?s ?st) ?axis ?value)
       (element-stride-list-length ?st ?n) (> ?n ?axis) (element-stride-accumulated-at-axis ?st ?axis ?value ?tail))
 ((element-stride-accumulated-at-axis (ElementStrideCons ?s ?st) ?axis ?value (ElementStrideCons ?s ?tail))) :ruleset main_ruleset)
(relation element-stride-view-composition-state (LogicalTensor Shape BitWidth IntExprList ElementStrideList ElementStrideList))
(rule ((= ?out (LogicalIndexMapApply ?in (IndexMapLit ?entries ?inshape) ?outshape))
       (= ?parent (LayoutTensorLit ?in (ElementStridedLayoutLit ?inshape ?ss ?w)))
       (= ?inshape (ShapeLit ?indims)) (element-stride-expressions-from-list ?indims ?ss ?plain)
       (= ?outshape (ShapeLit ?dims)) (element-stride-zero-list ?dims ?zeros))
 ((element-stride-view-composition-state ?out ?outshape ?w ?entries ?ss ?zeros))
 :ruleset main_ruleset :name "element-stride: seed view composition during saturation")
(rule ((element-stride-view-composition-state ?out ?shape ?w (IntExprCons ?e ?et)
          (ElementStrideCons (ElementStrideAny) ?st) ?partial))
 ((element-stride-view-composition-state ?out ?shape ?w ?et ?st ?partial)) :ruleset main_ruleset)
(rule ((element-stride-view-composition-state ?out ?shape ?w (IntExprCons (IntLit 0) ?et)
          (ElementStrideCons (ElementStrideExact ?s) ?st) ?partial))
 ((element-stride-view-composition-state ?out ?shape ?w ?et ?st ?partial)) :ruleset main_ruleset)
(rule ((element-stride-view-composition-state ?out ?shape ?w (IntExprCons (CoordVar ?shape ?axis) ?et)
          (ElementStrideCons (ElementStrideExact ?s) ?st) ?partial))
 ((element-stride-accumulate-at-axis-demand ?partial ?axis ?s)) :ruleset main_ruleset)
(rule ((element-stride-view-composition-state ?out ?shape ?w (IntExprCons (CoordVar ?shape ?axis) ?et)
          (ElementStrideCons (ElementStrideExact ?s) ?st) ?partial)
       (element-stride-accumulated-at-axis ?partial ?axis ?s ?placed))
 ((element-stride-view-composition-state ?out ?shape ?w ?et ?st ?placed)) :ruleset main_ruleset)
(rule ((element-stride-view-composition-state ?out ?shape ?w (IntExprNil) (ElementStrideNil) ?final))
 ((LayoutTensorLit ?out (ElementStridedLayoutLit ?shape ?final ?w)))
 :ruleset main_ruleset :name "element-stride: publish the composed view's layout")
