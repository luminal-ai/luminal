; Separately scheduled experiment. No production schedule runs element-stride-discovery.
; Whole linear certificates replace independently merged coefficient/constant
; cells. Arithmetic stays in BigInt, outside IntExpr ring rewriting, until a
; complete nonnegative zero-origin presentation has been proved.
(ruleset element-stride-discovery)
(datatype ElementStrideLiteralCoefficients
  (ElementStrideLiteralCoefficientsNil)
  (ElementStrideLiteralCoefficientsCons BigInt ElementStrideLiteralCoefficients))
(relation element-stride-discovery-demand (Layout))
(relation element-stride-discovered (Layout))
(relation element-stride-linear-certificate-demand (IntExpr Shape))
(relation element-stride-linear-certificate (IntExpr Shape ElementStrideLiteralCoefficients BigInt))
(relation element-stride-literal-zero-coefficients (IntExprList ElementStrideLiteralCoefficients))
(rule ((= ?dims (IntExprNil))) ((element-stride-literal-zero-coefficients ?dims (ElementStrideLiteralCoefficientsNil))) :ruleset element-stride-discovery)
(rule ((= ?dims (IntExprCons ?e ?et)) (element-stride-literal-zero-coefficients ?et ?tail))
 ((element-stride-literal-zero-coefficients ?dims (ElementStrideLiteralCoefficientsCons (bigint 0) ?tail))) :ruleset element-stride-discovery)
(relation element-stride-literal-basis-coefficients (IntExprList i64 ElementStrideLiteralCoefficients))
(rule ((= ?dims (IntExprCons ?e ?et)) (= ?axis (expr-list-length-of ?et))
       (>= (lower-bound-of ?e) (bigint 2)) (element-stride-literal-zero-coefficients ?et ?tail))
 ((element-stride-literal-basis-coefficients ?dims ?axis (ElementStrideLiteralCoefficientsCons (bigint 1) ?tail))) :ruleset element-stride-discovery)
(rule ((= ?dims (IntExprCons ?e ?et)) (> (expr-list-length-of ?et) ?axis)
       (element-stride-literal-basis-coefficients ?et ?axis ?tail))
 ((element-stride-literal-basis-coefficients ?dims ?axis (ElementStrideLiteralCoefficientsCons (bigint 0) ?tail))) :ruleset element-stride-discovery)

(relation element-stride-coefficient-addition-demand (ElementStrideLiteralCoefficients ElementStrideLiteralCoefficients))
(relation element-stride-coefficients-added (ElementStrideLiteralCoefficients ElementStrideLiteralCoefficients ElementStrideLiteralCoefficients))
(rule ((element-stride-coefficient-addition-demand (ElementStrideLiteralCoefficientsNil) (ElementStrideLiteralCoefficientsNil)))
 ((element-stride-coefficients-added (ElementStrideLiteralCoefficientsNil) (ElementStrideLiteralCoefficientsNil) (ElementStrideLiteralCoefficientsNil))) :ruleset element-stride-discovery)
(rule ((element-stride-coefficient-addition-demand (ElementStrideLiteralCoefficientsCons ?a ?at) (ElementStrideLiteralCoefficientsCons ?b ?bt)))
 ((element-stride-coefficient-addition-demand ?at ?bt)) :ruleset element-stride-discovery)
(rule ((element-stride-coefficient-addition-demand (ElementStrideLiteralCoefficientsCons ?a ?at) (ElementStrideLiteralCoefficientsCons ?b ?bt))
       (element-stride-coefficients-added ?at ?bt ?tail))
 ((element-stride-coefficients-added (ElementStrideLiteralCoefficientsCons ?a ?at) (ElementStrideLiteralCoefficientsCons ?b ?bt)
    (ElementStrideLiteralCoefficientsCons (+ ?a ?b) ?tail))) :ruleset element-stride-discovery)
(relation element-stride-coefficient-scaling-demand (ElementStrideLiteralCoefficients BigInt))
(relation element-stride-coefficients-scaled (ElementStrideLiteralCoefficients BigInt ElementStrideLiteralCoefficients))
(rule ((element-stride-coefficient-scaling-demand (ElementStrideLiteralCoefficientsNil) ?s))
 ((element-stride-coefficients-scaled (ElementStrideLiteralCoefficientsNil) ?s (ElementStrideLiteralCoefficientsNil))) :ruleset element-stride-discovery)
(rule ((element-stride-coefficient-scaling-demand (ElementStrideLiteralCoefficientsCons ?h ?t) ?s))
 ((element-stride-coefficient-scaling-demand ?t ?s)) :ruleset element-stride-discovery)
(rule ((element-stride-coefficient-scaling-demand (ElementStrideLiteralCoefficientsCons ?h ?t) ?s) (element-stride-coefficients-scaled ?t ?s ?tail))
 ((element-stride-coefficients-scaled (ElementStrideLiteralCoefficientsCons ?h ?t) ?s (ElementStrideLiteralCoefficientsCons (* ?h ?s) ?tail))) :ruleset element-stride-discovery)

(rule ((element-stride-discovery-demand ?layout) (= ?layout (ElementOffsetExpressionLayoutLit ?e ?shape ?w)))
 ((element-stride-linear-certificate-demand ?e ?shape)) :ruleset element-stride-discovery)
(rule ((element-stride-linear-certificate-demand ?e (ShapeLit ?dims)) (= ?e (IntLit ?n))
       (element-stride-literal-zero-coefficients ?dims ?zeros))
 ((element-stride-linear-certificate ?e (ShapeLit ?dims) ?zeros (bigint ?n))) :ruleset element-stride-discovery)
(rule ((element-stride-linear-certificate-demand ?e ?shape) (= ?shape (ShapeLit ?dims))
       (= ?e (CoordVar ?shape ?axis)) (element-stride-literal-basis-coefficients ?dims ?axis ?basis))
 ((element-stride-linear-certificate ?e ?shape ?basis (bigint 0))) :ruleset element-stride-discovery)
(rule ((element-stride-linear-certificate-demand (IntAdd ?a ?b) ?shape))
 ((element-stride-linear-certificate-demand ?a ?shape) (element-stride-linear-certificate-demand ?b ?shape)) :ruleset element-stride-discovery)
(rule ((element-stride-linear-certificate-demand ?e ?shape) (= ?e (IntAdd ?a ?b))
       (element-stride-linear-certificate ?a ?shape ?ac ?ao) (element-stride-linear-certificate ?b ?shape ?bc ?bo))
 ((element-stride-coefficient-addition-demand ?ac ?bc)) :ruleset element-stride-discovery)
(rule ((element-stride-linear-certificate-demand ?e ?shape) (= ?e (IntAdd ?a ?b))
       (element-stride-linear-certificate ?a ?shape ?ac ?ao) (element-stride-linear-certificate ?b ?shape ?bc ?bo)
       (element-stride-coefficients-added ?ac ?bc ?coeffs))
 ((element-stride-linear-certificate ?e ?shape ?coeffs (+ ?ao ?bo))) :ruleset element-stride-discovery)
; IntMul is commutative in core; one spelling suffices after main_ruleset runs.
(rule ((element-stride-linear-certificate-demand (IntMul (IntLit ?s) ?e) ?shape))
 ((element-stride-linear-certificate-demand ?e ?shape)) :ruleset element-stride-discovery)
(rule ((element-stride-linear-certificate-demand ?e ?shape) (= ?e (IntMul (IntLit ?s) ?a))
       (element-stride-linear-certificate ?a ?shape ?coeffs ?origin))
 ((element-stride-coefficient-scaling-demand ?coeffs (bigint ?s))) :ruleset element-stride-discovery)
(rule ((element-stride-linear-certificate-demand ?e ?shape) (= ?e (IntMul (IntLit ?s) ?a))
       (element-stride-linear-certificate ?a ?shape ?coeffs ?origin) (element-stride-coefficients-scaled ?coeffs (bigint ?s) ?result))
 ((element-stride-linear-certificate ?e ?shape ?result (* (bigint ?s) ?origin))) :ruleset element-stride-discovery)

(relation element-stride-coefficient-publication-demand (ElementStrideLiteralCoefficients))
(relation element-stride-coefficients-published (ElementStrideLiteralCoefficients ElementStrideList))
(rule ((element-stride-coefficient-publication-demand (ElementStrideLiteralCoefficientsNil)))
 ((element-stride-coefficients-published (ElementStrideLiteralCoefficientsNil) (ElementStrideNil))) :ruleset element-stride-discovery)
(rule ((element-stride-coefficient-publication-demand (ElementStrideLiteralCoefficientsCons ?h ?t)) (>= ?h (bigint 0)))
 ((element-stride-coefficient-publication-demand ?t)) :ruleset element-stride-discovery)
(rule ((element-stride-coefficient-publication-demand (ElementStrideLiteralCoefficientsCons ?h ?t)) (>= ?h (bigint 0))
       (= ?n (bigint-to-i64 ?h)) (element-stride-coefficients-published ?t ?tail))
 ((element-stride-coefficients-published (ElementStrideLiteralCoefficientsCons ?h ?t)
    (ElementStrideCons (ElementStrideExact (IntLit ?n)) ?tail))) :ruleset element-stride-discovery)
(rule ((element-stride-discovery-demand ?layout) (= ?layout (ElementOffsetExpressionLayoutLit ?e ?shape ?w))
       (element-stride-linear-certificate ?e ?shape ?coeffs (bigint 0)))
 ((element-stride-coefficient-publication-demand ?coeffs)) :ruleset element-stride-discovery)
(rule ((element-stride-discovery-demand ?layout) (= ?layout (ElementOffsetExpressionLayoutLit ?e ?shape ?w))
       (element-stride-linear-certificate ?e ?shape ?coeffs (bigint 0)) (element-stride-coefficients-published ?coeffs ?strides))
 ((union ?layout (ElementStridedLayoutLit ?shape ?strides ?w)) (element-stride-discovered ?layout))
 :ruleset element-stride-discovery :name "element-stride: publish only complete zero-origin certificates")
