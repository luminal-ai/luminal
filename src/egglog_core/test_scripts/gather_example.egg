;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Coordinate-form gather pins (Stage R8): LogicalGather(data, coords) —
; one Int coordinate tensor PER DATA AXIS, all sharing one shape, which
; IS the output shape: out[c] = data[coord_0[c], .., coord_{r-1}[c]].
; The consumer shape is the EMBEDDING LOOKUP: table [6, 4] indexed by ids
; on the vocab axis with the column axis passed through — and the
; passthrough coordinate is supplied by an IOTA (Stage R7), pinning the
; composition the coordinate form was designed for: statically-known axes
; are iotas, data-dependent axes are tensors, one op shape covers both.
; Out-of-bounds coordinate VALUES are undefined behavior (user ruling);
; the Int tripwire on coordinate dtypes must stay silent all run.

; The embedding table: vocab 6, width 4, F32.
(let table_shape (ShapeLit (IntExprCons (IntLit 6) (IntExprCons (IntLit 4) (IntExprNil)))))
(let table_logical (LogicalTensorInputLit (LogicalIdLit "embedding_table") table_shape (F32)))

; The output/coordinate shape: batch 3, width 4.
(let lookup_shape (ShapeLit (IntExprCons (IntLit 3) (IntExprCons (IntLit 4) (IntExprNil)))))

; Axis-0 coordinate (vocab rows): token ids, already broadcast to the
; lookup shape — data-dependent Int index data.
(let token_ids_logical (LogicalTensorInputLit (LogicalIdLit "token_ids") lookup_shape (Int)))

; Axis-1 coordinate (table columns): the passthrough — an iota of the
; inner output coordinate (axis 0 = innermost, extent 4).
(let column_iota_logical (LogicalIota (CoordVar lookup_shape 0) lookup_shape))

(let coordinate_list
  (LogicalTensorCons token_ids_logical
    (LogicalTensorCons column_iota_logical (LogicalTensorNil))))

(let lookup_logical (LogicalGather table_logical coordinate_list))

; The canonical layout the forward mint must produce for the result.
(let lookup_layout (RightMajorContiguousElementLayoutLit lookup_shape (bits-of (F32))))

; Input layout tensors, declared the way a boundary would declare them —
; bare LogicalTensorInputLits get no layout tensor by themselves (propagation starts
; from declared ones; only SOURCE ops like iota and gather's own output
; mint canonically).
(let table_layout (RightMajorContiguousElementLayoutLit table_shape (bits-of (F32))))
(let ids_layout (RightMajorContiguousElementLayoutLit lookup_shape (bits-of (Int))))
(let table_layout_tensor (LayoutTensorLit table_logical table_layout))
(let ids_layout_tensor (LayoutTensorLit token_ids_logical ids_layout))

; --- the gather⇄view unification material: the SAME transpose of the
; table written as an all-iota gather and as a direct index-map view.
; The unification rule must land both in ONE logical class — the
; two-routes-one-class pin, and the doorway to zero-copy extraction of
; all-static gathers.
(let transpose_shape (ShapeLit (IntExprCons (IntLit 4) (IntExprCons (IntLit 6) (IntExprNil)))))
(let row_coordinate_iota (LogicalIota (CoordVar transpose_shape 0) transpose_shape))
(let column_coordinate_iota (LogicalIota (CoordVar transpose_shape 1) transpose_shape))
(let transposed_gather
  (LogicalGather table_logical
    (LogicalTensorCons row_coordinate_iota
      (LogicalTensorCons column_coordinate_iota (LogicalTensorNil)))))
(let transposed_view
  (LogicalIndexMapApply table_logical
    (IndexMapLit
      (IntExprCons (CoordVar transpose_shape 0)
        (IntExprCons (CoordVar transpose_shape 1) (IntExprNil)))
      table_shape)
    transpose_shape))

(run-schedule (saturate (saturate (run)) (run subst-walk)) (saturate (run fixpoint-invariants)))

; Iota authoring contract: every constructed iota demands its expression's
; bounds — an absent entry fails the check loudly at the fixpoint.
(check (= ?demanded_lower (lower-bound-of (CoordVar lookup_shape 0))))
(check (= ?demanded_upper (upper-bound-of (CoordVar lookup_shape 0))))

; --- dtype: the result carries the DATA's dtype ---
(check (= (dtype-of lookup_logical) (F32)))

; --- shape: the coordinates' common shape IS the output shape ---
(check (= (coords-common-shape coordinate_list) lookup_shape))
(check (= (shape-of lookup_logical) lookup_shape))

; --- the forward mint: canonical layout tensor exists and is injective ---
(check (= (layout-of (LayoutTensorLit lookup_logical lookup_layout)) lookup_layout))
(check (= (injectivity-of (LayoutTensorLit lookup_logical lookup_layout)) (Injective)))

; --- the variable-arity op match: data first, then one coordinate layout
; tensor per axis, one written output ---
(check
  (= (LayoutTensorOpGatherGeneric
       (LayoutTensorLit table_logical table_layout)
       (LayoutTensorCons (LayoutTensorLit token_ids_logical ids_layout)
         (LayoutTensorCons (LayoutTensorLit column_iota_logical ids_layout)
           (LayoutTensorNil)))
       lookup_layout)
     (LayoutTensorOpLit
       (LayoutTensorCons (LayoutTensorLit table_logical table_layout)
         (LayoutTensorCons (LayoutTensorLit token_ids_logical ids_layout)
           (LayoutTensorCons (LayoutTensorLit column_iota_logical ids_layout)
             (LayoutTensorNil))))
       (LayoutTensorCons (LayoutTensorLit lookup_logical lookup_layout) (LayoutTensorNil)))))

; Iota authoring contract for the transpose coordinates.
(check (= ?demanded_lower (lower-bound-of (CoordVar transpose_shape 0))))
(check (= ?demanded_upper (upper-bound-of (CoordVar transpose_shape 0))))
(check (= ?demanded_lower2 (lower-bound-of (CoordVar transpose_shape 1))))
(check (= ?demanded_upper2 (upper-bound-of (CoordVar transpose_shape 1))))

; --- the unification: two routes, one class ---
(check (= transposed_gather transposed_view))
; ...and the MIXED gather (data-dependent ids coordinate) must NOT have
; collapsed into any view — its class carries no IndexMapApply route, so
; it is not equal to, e.g., the identity view of the table.
(fail (check (= lookup_logical transposed_view)))
