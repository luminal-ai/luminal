;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Coordinate-form scatter pins (Stage R8 dual): LogicalScatter(init,
; coords, src) — out[coords(c)] = src[c] for c over SRC's shape,
; elsewhere out = init. The consumer shape is the KV-CACHE ROW UPDATE:
; a [6, 4] cache, a [1, 4] new row, the row position as a data-dependent
; Int coordinate and the column as an IOTA passthrough. Pinned: dtype
; carried from init AND src (the atom tripwire stays silent — they
; agree), the result taking INIT's shape, the positive well-formedness
; gate (coords' common shape ≡ src's shape, bound to one variable), and
; BOTH implementations coexisting: the functional form on the canonical
; destination and the mutating form on init's own layout. Duplicate and
; out-of-bounds coordinate VALUES are undefined behavior (user ruling).

(let cache_shape (ShapeLit (IntExprCons (IntLit 6) (IntExprCons (IntLit 4) (IntExprNil)))))
(let cache_logical (LogicalTensorInputLit (LogicalIdLit "kv_cache") cache_shape (F32)))
(let cache_layout (RightMajorContiguousElementLayoutLit cache_shape (bits-of (F32))))
(let cache_layout_tensor (LayoutTensorLit cache_logical cache_layout))

(let row_shape (ShapeLit (IntExprCons (IntLit 1) (IntExprCons (IntLit 4) (IntExprNil)))))
(let new_row_logical (LogicalTensorInputLit (LogicalIdLit "new_row") row_shape (F32)))
(let row_layout (RightMajorContiguousElementLayoutLit row_shape (bits-of (F32))))
(let new_row_layout_tensor (LayoutTensorLit new_row_logical row_layout))

; Axis-0 coordinate (cache rows): the write position, data-dependent,
; already broadcast to src's shape.
(let position_logical (LogicalTensorInputLit (LogicalIdLit "write_position") row_shape (Int)))
(let position_layout (RightMajorContiguousElementLayoutLit row_shape (bits-of (Int))))
(let position_layout_tensor (LayoutTensorLit position_logical position_layout))

; Axis-1 coordinate (cache columns): the iota passthrough (axis 0 =
; innermost, extent 4).
(let column_iota_logical (LogicalIota (CoordVar row_shape 0) row_shape))

(let coordinate_list
  (LogicalTensorCons position_logical
    (LogicalTensorCons column_iota_logical (LogicalTensorNil))))

(let updated_logical (LogicalScatter cache_logical coordinate_list new_row_logical))

(run-schedule (saturate (saturate (run)) (run subst-walk)) (saturate (run fixpoint-invariants)))

; Iota authoring contract: every constructed iota demands its expression's
; bounds — an absent entry fails the check loudly at the fixpoint.
(check (= ?demanded_lower (lower-bound-of (CoordVar row_shape 0))))
(check (= ?demanded_upper (upper-bound-of (CoordVar row_shape 0))))

; --- dtype: carried from init AND src, duplicatively (atoms — the
; tripwire is legal, and its silence here IS the agreement proof) ---
(check (= (dtype-of updated_logical) (F32)))

; --- shape: the result preserves INIT's geometry ---
(check (= (shape-of updated_logical) cache_shape))

; --- the well-formedness gate held: coords' common shape ≡ src's shape ---
(check (= (coords-common-shape coordinate_list) row_shape))

; --- the FUNCTIONAL implementation, on the canonical destination ---
(check
  (= (LayoutTensorOpScatterFunctionalGeneric
       cache_layout_tensor
       new_row_layout_tensor
       (LayoutTensorCons position_layout_tensor
         (LayoutTensorCons (LayoutTensorLit column_iota_logical position_layout)
           (LayoutTensorNil)))
       cache_layout)
     (LayoutTensorOpLit
       (LayoutTensorCons cache_layout_tensor
         (LayoutTensorCons new_row_layout_tensor
           (LayoutTensorCons position_layout_tensor
             (LayoutTensorCons (LayoutTensorLit column_iota_logical position_layout)
               (LayoutTensorNil)))))
       (LayoutTensorCons (LayoutTensorLit updated_logical cache_layout) (LayoutTensorNil)))))
