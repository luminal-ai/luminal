;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Associativity-fence pins (Stage I3). Guarded associativity cannot
; regress the plan suite (the review proved today's fixtures pass with
; associativity DELETED), so a regression gate alone would be vacuous.
; These pins are the real gate:
;   - POSITIVE: certified reassociations actually merge (a fail-closed
;     rule is only useful if it opens where it must);
;   - NEGATIVE: an uncertified inner does not regroup;
;   - CONVERGENCE: the historical cancellation-pair seeds — which made
;     the UNGUARDED base system diverge structurally with no
;     distributivity involved (forensics record: additive-cancellation
;     pair + AC + fold = the classic assoc+annihilation divergence) —
;     now saturate. This fixture TERMINATING is itself the pin.

(let coord_inner
  (CoordVar (ShapeLit (IntExprCons (IntLit 2) (IntExprCons (IntLit 2) (IntExprNil)))) 0))
(let coord_outer
  (CoordVar (ShapeLit (IntExprCons (IntLit 2) (IntExprCons (IntLit 2) (IntExprNil)))) 1))

; --- the historical killer seeds (cancellation pairs + rich soup) ---
; Two folding pairs, a strided-offset soup around them, and the exact
; shapes from the recorded reproducers: a zero-summand product under a
; bit-width multiplier, nested fold intermediates, and slice offsets.
(let cancel_pair_three (IntAdd (IntLit 3) (IntLit -3)))
(let cancel_pair_seven (IntAdd (IntLit 7) (IntLit -7)))
(let killer_bit_offset
  (IntMul (IntAdd coord_inner (IntMul cancel_pair_three (IntLit 5))) (IntLit 32)))
(let killer_bit_offset_second
  (IntMul (IntAdd (IntMul coord_outer (IntLit 2)) (IntMul cancel_pair_seven (IntLit 3))) (IntLit 32)))
(let killer_mixed_sum
  (IntMul (IntAdd cancel_pair_three (IntAdd coord_inner cancel_pair_seven)) (IntLit 8)))
(let fold_intermediate
  (IntAdd (IntMul coord_outer (IntLit 2)) (IntAdd (IntMul coord_inner (IntLit 1)) (IntLit 0))))
(let fold_bit_offset (IntMul fold_intermediate (IntLit 32)))
(let slice_bit_offset (IntMul (IntAdd (IntLit 2) coord_inner) (IntLit 32)))

; --- positive-pin material: certified nested sums and products ---
(let certified_sum_left
  (IntAdd (IntAdd (IntLit 5) coord_inner) coord_outer))
(let certified_product_left
  (IntMul (IntMul coord_inner (IntLit 4)) coord_outer))

; --- negative-pin material: an inner that is neither provably zero nor
; certifiable (maybe-zero IntVar minus a constant spans zero, mentions no
; coordinate, so every route refuses it) ---
(let maybe_empty_dim (IntVar "maybe_empty_dim"))
(set (lower-bound-of maybe_empty_dim) (bigint 0))
(set (upper-bound-of maybe_empty_dim) (bigint 64))
(let uncertifiable_inner (IntAdd maybe_empty_dim (IntLit -3)))
(let blocked_regroup (IntAdd uncertifiable_inner (IntLit 5)))

(run-schedule (saturate (saturate (run)) (run subst-walk)) (saturate (run fixpoint-invariants)))

; POSITIVE: the certified inner (5 + v0) regroups — both association
; orders land in one class...
(check (= certified_sum_left (IntAdd (IntLit 5) (IntAdd coord_inner coord_outer))))
; ...and so does the certified product (v0 * 4) * v1.
(check (= certified_product_left (IntMul coord_inner (IntMul (IntLit 4) coord_outer))))

; NEGATIVE: the uncertifiable inner never regroups — the right-associated
; form is never minted (its lookup fails, so the equality is unprovable).
(fail
  (check (= blocked_regroup (IntAdd maybe_empty_dim (IntAdd (IntLit -3) (IntLit 5))))))

; CONVERGENCE side-pins: the cancellation pairs folded into the zero
; class and stayed there quietly.
(check (= cancel_pair_three (IntLit 0)))
(check (= cancel_pair_seven (IntLit 0)))
(fail (check (provably-cannot-union-with-zero cancel_pair_three)))

; The killer soup still computes the equalities that matter: the
; zero-summand collapses out of the first killer offset...
(check (= killer_bit_offset (IntMul coord_inner (IntLit 32))))
; ...and the fold intermediate's identities collapse to the plain
; strided offset under the bit multiplier.
(check (= fold_bit_offset
          (IntMul (IntAdd (IntMul coord_outer (IntLit 2)) coord_inner) (IntLit 32))))
