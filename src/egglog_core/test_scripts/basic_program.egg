;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Actual Program

; Logical Program Definition
; x = [4x2]
(let x_shape (ShapeLit (IntExprCons (IntLit 4) (IntExprCons (IntLit 2) (IntExprNil)))))
(let x_dtype (F32))

(let x_logical (LogicalTensorInputLit (LogicalIdLit "input_0") x_shape x_dtype))
(let y_logical (LogicalSqrt x_logical))

; z = [2x4]
(let z_shape (ShapeLit (IntExprCons (IntLit 2) (IntExprCons (IntLit 4) (IntExprNil)))))
(let left_input_logical (LogicalTensorInputLit (LogicalIdLit "input_1") z_shape x_dtype))

; Define Index Maps
; x_in = (0 * x_out) + (1 * y_out)
; y_in = (1 * x_out) + (0 * y_out)
; A map's entries range over the OUTPUT's coordinates and coordinate
; variables are OWNED by the output shape, so one logical transpose needs
; one map term per output shape (the map's domain IS the output index box).

; Transpose onto z = [2x4]: output var 0 spans 4, var 1 spans 2.
(let x_to_z_transpose_map
  (IndexMapLit
    (IntExprCons (CoordVar z_shape 0)
      (IntExprCons (CoordVar z_shape 1)
        (IntExprNil)))
    x_shape)
)

; Transpose onto the [4x2] view of left_input: var 0 spans 2, var 1 spans 4.
(let left_to_view_transpose_map
  (IndexMapLit
    (IntExprCons (CoordVar x_shape 0)
      (IntExprCons (CoordVar x_shape 1)
        (IntExprNil)))
    z_shape)
)

; This is our version of view ops
(let z_logical (LogicalIndexMapApply x_logical x_to_z_transpose_map z_shape))
(let left_view_logical (LogicalIndexMapApply left_input_logical left_to_view_transpose_map x_shape))

; Define Index
(let w_logical (LogicalAdd x_logical y_logical))





; Input Layout / Buffer Definition

; The input buffer is intentionally non-contiguous:
;   shape   = [4, 2]
;   strides = [8, 2]
;   element offset = (CoordVar x_shape 1) * 8 + (CoordVar x_shape 0) * 2
(let x_input_strides
  (IntExprCons (IntLit 8)
    (IntExprCons (IntLit 2)
      (IntExprNil))))

(let x_input_element_offset
  (IntAdd
    (IntMul (CoordVar x_shape 1) (IntLit 8))
    (IntMul (CoordVar x_shape 0) (IntLit 2))))

(let x_input_layout (StridedElementLayoutLit x_shape
    (IntAffineExprCons (IntMul (CoordVar x_shape 1) (IntLit 8))
      (IntAffineExprCons (IntMul (CoordVar x_shape 0) (IntLit 2))
      (IntAffineExprNil)))
    (bits-of x_dtype)))
(let x_input_layout_tensor (LayoutTensorLit x_logical x_input_layout))

(let x_input_buffer_id (BufferLit 6))
(set (buffer-access-of x_input_buffer_id) (ReadWrite))
(set (buffer-freed-by x_input_buffer_id) (CallerFrees))
(let x_input_buffer_tensor (BufferTensorLit x_input_layout_tensor x_input_buffer_id))

; This input is left-major contiguous:
;   shape = [2, 4]
;   element offset = (CoordVar z_shape 1) + (CoordVar z_shape 0) * 2
(let left_input_element_offset
  (IntAdd
    (CoordVar z_shape 1)
    (IntMul (CoordVar z_shape 0) (IntLit 2))))

(let left_input_layout (LeftMajorContiguousElementLayoutLit z_shape (bits-of x_dtype)))
(let left_input_layout_tensor (LayoutTensorLit left_input_logical left_input_layout))

(let left_input_buffer_id (BufferLit 9))
(set (buffer-access-of left_input_buffer_id) (ReadWrite))
(set (buffer-freed-by left_input_buffer_id) (CallerFrees))
(let left_input_buffer_tensor (BufferTensorLit left_input_layout_tensor left_input_buffer_id))

; Input join: the storage that EXISTS at launch (existence = BufferInputLit
; membership). The output buffers below (7, 8, 10) are deliberately NOT
; listed here — they appear only in BufferOutputLit, which makes them
; must-allocate outputs: the program is responsible for creating that
; storage and returning it.
(let input_boundary
  (BufferInputLit
    (BufferTensorCons x_input_buffer_tensor
      (BufferTensorCons left_input_buffer_tensor
        (BufferTensorNil)))))

; Output Spec Definition
; z output specs
(let z_output_layout (RightMajorContiguousElementLayoutLit z_shape (bits-of x_dtype)))
(let z_output_layout_tensor (LayoutTensorLit z_logical z_output_layout))

(let z_output_buffer_id (BufferLit 7))
(set (buffer-access-of z_output_buffer_id) (ReadWrite))
(set (buffer-freed-by z_output_buffer_id) (CallerFrees))
(let z_output_buffer_tensor (BufferTensorLit z_output_layout_tensor z_output_buffer_id))

; w output specs
(let w_output_layout (RightMajorContiguousElementLayoutLit x_shape (bits-of x_dtype)))
(let w_output_layout_tensor (LayoutTensorLit w_logical w_output_layout))

(let w_output_buffer_id (BufferLit 8))
(set (buffer-access-of w_output_buffer_id) (ReadWrite))
(set (buffer-freed-by w_output_buffer_id) (CallerFrees))
(let w_output_buffer_tensor (BufferTensorLit w_output_layout_tensor w_output_buffer_id))

; left-major input view output specs
(let left_view_output_layout (RightMajorContiguousElementLayoutLit x_shape (bits-of x_dtype)))
(let left_view_output_layout_tensor (LayoutTensorLit left_view_logical left_view_output_layout))

(let left_view_output_buffer_id (BufferLit 10))
(set (buffer-access-of left_view_output_buffer_id) (ReadWrite))
(set (buffer-freed-by left_view_output_buffer_id) (CallerFrees))
(let left_view_output_buffer_tensor (BufferTensorLit left_view_output_layout_tensor left_view_output_buffer_id))

; output join
(let output
  (BufferOutputLit
    (BufferTensorCons z_output_buffer_tensor
      (BufferTensorCons w_output_buffer_tensor
        (BufferTensorCons left_view_output_buffer_tensor
          (BufferTensorNil))))))

; Substitution pin (the SWAP case — sequential substitution would botch a
; transpose): compose the strided input offset with the transpose map.
(int-subst-demand x_input_element_offset x_to_z_transpose_map)


; SOURCE SEAM rows for list-authored strided layouts (affine migration)
(strided-lists x_input_layout x_shape (IntExprCons (IntLit 4) (IntExprCons (IntLit 2) (IntExprNil))) x_input_strides (bits-of x_dtype))

(run-schedule (saturate (saturate (run)) (run subst-walk)) (run materializing-copy-mint) (run layout-tensor-op-metadata) (saturate (run fixpoint-invariants)))

; The transpose substitution swaps both variables SIMULTANEOUSLY:
; x offset v1*8 + v0*2 over x's coords becomes 8*z_v0 + 2*z_v1 over z's
; (entry 0 = z_v1 spans 2, entry 1 = z_v0 spans 4).
(check
  (= (int-subst-of x_input_element_offset x_to_z_transpose_map)
     (IntAdd
       (IntMul (CoordVar z_shape 0) (IntLit 8))
       (IntMul (CoordVar z_shape 1) (IntLit 2)))))

; The strided input layout lowers to element-offset and bit-offset forms.
(check
  (= x_input_layout
     (ElementOffsetExpressionLayoutLit x_input_element_offset x_shape (bits-of x_dtype))))

(check
  (= x_input_layout
     (BitOffsetExpressionLayoutLit
       (IntMul x_input_element_offset (IntLit 32))
       x_shape
       (bits-of x_dtype))))

; The transpose/view materialization can consume the strided input tensor directly.
(check
  (= (input-layout-tensor-list-of
       (LayoutTensorOpIndexMapApplyMaterialize
         x_input_layout_tensor
         x_to_z_transpose_map
         z_shape
         z_output_layout))
     (LayoutTensorCons x_input_layout_tensor (LayoutTensorNil))))

(check
  (= (output-layout-tensor-list-of
       (LayoutTensorOpIndexMapApplyMaterialize
         x_input_layout_tensor
         x_to_z_transpose_map
         z_shape
         z_output_layout))
     (LayoutTensorCons z_output_layout_tensor (LayoutTensorNil))))

; The left-major input layout lowers to element-offset and bit-offset forms.
(check
  (= left_input_layout
     (ElementOffsetExpressionLayoutLit left_input_element_offset z_shape (bits-of x_dtype))))

(check
  (= left_input_layout
     (BitOffsetExpressionLayoutLit
       (IntMul left_input_element_offset (IntLit 32))
       z_shape
       (bits-of x_dtype))))

; A view can also consume a left-major input tensor directly.
(check
  (= (input-layout-tensor-list-of
       (LayoutTensorOpIndexMapApplyMaterialize
         left_input_layout_tensor
         left_to_view_transpose_map
         x_shape
         left_view_output_layout))
     (LayoutTensorCons left_input_layout_tensor (LayoutTensorNil))))

(check
  (= (output-layout-tensor-list-of
       (LayoutTensorOpIndexMapApplyMaterialize
         left_input_layout_tensor
         left_to_view_transpose_map
         x_shape
         left_view_output_layout))
     (LayoutTensorCons left_view_output_layout_tensor (LayoutTensorNil))))
