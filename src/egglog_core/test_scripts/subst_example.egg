;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Adversarial substitution pins (int-subst-of): the cases most likely to
; expose an unsound or non-simultaneous substitution. Every expected
; result is hand-computed. Conventions under test:
;   - entries: first list element <-> HIGHEST input axis; nth-from-end
;     is ZERO-based (luminal-aligned, ruling 2026-07-24): axis k reads
;     entry k directly
;   - simultaneity: all variables substituted against the ORIGINAL map,
;     never against already-substituted results
;   - union-merge: images of different representatives of one class are
;     unioned (sound by the function-identity contract, under the
;     CoordVar arm's in-range instantiation guard)
;   - identification (ruling 2026-07-29): a substitution is
;     (expr, map, SOURCE SHAPE) — the shape names σ's domain (WHICH
;     coordinates are rewritten) and rides in the map itself
;     (IndexMapLit's source-shape tag), keeping it in the key; under
;     scoped CoordVar a coordinate CARRIES its owner shape, so domain
;     membership is structural (owner = source shape) and instantiation
;     legality (range) is the separate premise group
;   - ownership: parent-expression coordinates are owned by the SOURCE
;     shape; map ENTRIES are written in the consuming view's OUT box,
;     so their coordinates are owned by the out shape

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P1 — SQUARE transpose: the formal-collision case. Input and output
; formals are the SAME terms (the out box is [3,3], the same shape
; class as the source), so any sequential scheme corrupts
; (v0 -> v1 -> v0 again); only simultaneous survives.
(let p1_source_shape
  (ShapeLit (IntExprCons (IntLit 3) (IntExprCons (IntLit 3) (IntExprNil)))))
(let p1_parent
  (IntAdd (IntMul (CoordVar p1_source_shape 1) (IntLit 3)) (CoordVar p1_source_shape 0)))
(let p1_map
  (IndexMapLit
    (IntExprCons (CoordVar p1_source_shape 0)
      (IntExprCons (CoordVar p1_source_shape 1)
        (IntExprNil))) p1_source_shape))
(int-subst-demand p1_parent p1_map)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P2 — rank-3 FULL PERMUTATION (a 3-cycle), all sizes distinct so any
; axis/size mix-up changes the answer. Also exercises the middle index
; of a 3-entry list (the nth-from-end upward-propagation fix).
; Parent [2,3,5], right-major: offset = 15*v2 + 5*v1 + v0.
; Map: dim0(5)<-v1, dim1(3)<-v2, dim2(2)<-v0; output shape [3,5,2].
(let p2_source_shape
  (ShapeLit
    (IntExprCons (IntLit 2)
      (IntExprCons (IntLit 3) (IntExprCons (IntLit 5) (IntExprNil))))))
(let p2_out_shape
  (ShapeLit
    (IntExprCons (IntLit 3)
      (IntExprCons (IntLit 5) (IntExprCons (IntLit 2) (IntExprNil))))))
(let p2_parent
  (IntAdd (IntMul (CoordVar p2_source_shape 2) (IntLit 15))
    (IntAdd (IntMul (CoordVar p2_source_shape 1) (IntLit 5))
      (CoordVar p2_source_shape 0))))
(let p2_map
  (IndexMapLit
    (IntExprCons (CoordVar p2_out_shape 0)
      (IntExprCons (CoordVar p2_out_shape 2)
        (IntExprCons (CoordVar p2_out_shape 1)
          (IntExprNil)))) p2_source_shape))
(int-subst-demand p2_parent p2_map)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P3 — DIAGONAL: one output variable feeds BOTH input axes (repeated
; entries). Parent [4,4]: offset = 4*v1 + v0; both dims <- v0 of the
; rank-1 out box [4].
(let p3_source_shape
  (ShapeLit (IntExprCons (IntLit 4) (IntExprCons (IntLit 4) (IntExprNil)))))
(let p3_out_shape (ShapeLit (IntExprCons (IntLit 4) (IntExprNil))))
(let p3_parent
  (IntAdd (IntMul (CoordVar p3_source_shape 1) (IntLit 4)) (CoordVar p3_source_shape 0)))
(let p3_map
  (IndexMapLit
    (IntExprCons (CoordVar p3_out_shape 0)
      (IntExprCons (CoordVar p3_out_shape 0)
        (IntExprNil))) p3_source_shape))
(int-subst-demand p3_parent p3_map)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P4 — COMPOUND entries + cross-axis mapping: dim0(8) <- 2*v1 + 1 (a
; strided, shifted window), dim1(4) <- v0(2). Parent [4,8]: 8*v1 + v0.
; Output [3,2].
(let p4_source_shape
  (ShapeLit (IntExprCons (IntLit 4) (IntExprCons (IntLit 8) (IntExprNil)))))
(let p4_out_shape
  (ShapeLit (IntExprCons (IntLit 3) (IntExprCons (IntLit 2) (IntExprNil)))))
(let p4_parent
  (IntAdd (IntMul (CoordVar p4_source_shape 1) (IntLit 8)) (CoordVar p4_source_shape 0)))
(let p4_map
  (IndexMapLit
    (IntExprCons (CoordVar p4_out_shape 0)
      (IntExprCons (IntAdd (IntMul (CoordVar p4_out_shape 1) (IntLit 2)) (IntLit 1))
        (IntExprNil))) p4_source_shape))
(int-subst-demand p4_parent p4_map)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P5 — MULTI-REPRESENTATIVE agreement: the parent class is given TWO
; syntactically different, function-equal representatives (a script
; union — a distributivity instance the rule set no longer derives).
; Substitution images of BOTH representatives must land in ONE class:
; the union-merge soundness of subst-of, exercised deliberately.
; Parent reps: (v1 + v0) * 2  ==  v1*2 + v0*2, both over [6,6].
; Map: dim1 <- 2 (a slice), dim0 <- v0(6); output [6].
(let p5_source_shape
  (ShapeLit (IntExprCons (IntLit 6) (IntExprCons (IntLit 6) (IntExprNil)))))
(let p5_out_shape (ShapeLit (IntExprCons (IntLit 6) (IntExprNil))))
(let p5_parent
  (IntMul (IntAdd (CoordVar p5_source_shape 1) (CoordVar p5_source_shape 0)) (IntLit 2)))
(let p5_parent_alt
  (IntAdd (IntMul (CoordVar p5_source_shape 1) (IntLit 2))
    (IntMul (CoordVar p5_source_shape 0) (IntLit 2))))
(union p5_parent p5_parent_alt)
(let p5_map
  (IndexMapLit
    (IntExprCons (IntLit 2)
      (IntExprCons (CoordVar p5_out_shape 0)
        (IntExprNil))) p5_source_shape))
(int-subst-demand p5_parent p5_map)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P6 — IDENTITY / BROADCAST rank-up: rank-1 parent viewed inside [4,5]
; by the out box's own inner coordinate. Pre-scoping the composed
; expression was term-identical to the parent's and the domain
; distinction was the LAYOUT's job; scoped ownership carries the
; distinction in the expression itself — the image is the OUT box's
; inner coordinate, a different term from the parent's.
(let p6_source_shape (ShapeLit (IntExprCons (IntLit 5) (IntExprNil))))
(let p6_out_shape
  (ShapeLit (IntExprCons (IntLit 4) (IntExprCons (IntLit 5) (IntExprNil)))))
(let p6_parent (CoordVar p6_source_shape 0))
(let p6_map
  (IndexMapLit
    (IntExprCons (CoordVar p6_out_shape 0)
      (IntExprNil)) p6_source_shape))
(int-subst-demand p6_parent p6_map)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P7 — OUT-OF-RANGE axis: the parent mentions v2 but the map has two
; entries (and the source shape has rank 2), so the root substitution
; must never complete (silent incompleteness, never a panic or a
; partial result). Unsetness of the root is pinned by fail-check; the
; in-range subterm's image is checked positively.
(let p7_source_shape
  (ShapeLit (IntExprCons (IntLit 7) (IntExprCons (IntLit 5) (IntExprNil)))))
; Out box: dim1 sliced to 0, dim0 read by the out box's coordinate.
(let p7_out_shape (ShapeLit (IntExprCons (IntLit 5) (IntExprNil))))
; Axis 2 of the rank-2 source box: the deliberately unanswerable
; coordinate (no such dim), scoped form of the old extent-7 v2.
(let p7_parent (IntAdd (CoordVar p7_source_shape 2) (CoordVar p7_source_shape 0)))
(let p7_map
  (IndexMapLit
    (IntExprCons (IntLit 0)
      (IntExprCons (CoordVar p7_out_shape 0)
        (IntExprNil))) p7_source_shape))
(int-subst-demand p7_parent p7_map)
; ARM C delta: the P7 subterm check below reads this coordinate's own
; memo row — demand it as a root (root-only substitution mints no
; per-subterm rows).
(int-subst-demand (CoordVar p7_source_shape 0) p7_map)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P8 — DOMAIN TARGETING (ruling 2026-07-29): a FOREIGN coordinate —
; same axis, different owner box — is NOT in σ's domain and must be
; left fixed even though its entry is in-range for the foreign box
; (entry 1 fits in [0,4]); only the signature (ownership) premise can
; be the blocker here, which is exactly what this pins. The source
; box's own coordinate substitutes normally.
(let p8_source_shape (ShapeLit (IntExprCons (IntLit 3) (IntExprNil))))
(let p8_map (IndexMapLit (IntExprCons (IntLit 1) (IntExprNil)) p8_source_shape))
(let p8_own (CoordVar p8_source_shape 0))
(let p8_foreign (CoordVar (ShapeLit (IntExprCons (IntLit 5) (IntExprNil))) 0))
(int-subst-demand p8_own p8_map)
(int-subst-demand p8_foreign p8_map)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P9 — BOOL BRIDGE traversal (ruling 2026-07-29): substitution crosses
; IntCastFromBool through the bool-level mirror (bool-subst-of),
; re-entering the integer machinery at the comparison's children.
; Parent: cast(v0 < 2) over [3]; map: the reversal v0 <- 2 - v0.
; Image: cast((2 - v0) < 2) — undecided over the box (true at v0=1,2;
; false at v0=0), so it stays a bit; the pin is the structural image.
; The reversal's out box is [3] too — the same shape class as the
; source, so entry and parent coordinates share one term.
(let p9_source_shape (ShapeLit (IntExprCons (IntLit 3) (IntExprNil))))
(let p9_entry (IntAdd (IntLit 2) (IntMul (IntLit -1) (CoordVar p9_source_shape 0))))
(let p9_map (IndexMapLit (IntExprCons p9_entry (IntExprNil)) p9_source_shape))
(let p9_parent
  (IntCastFromBool (BoolLessThanInt (CoordVar p9_source_shape 0) (IntLit 2))))
(int-subst-demand p9_parent p9_map)

(run-schedule (saturate (saturate (run)) (run subst-walk)) (saturate (run fixpoint-invariants)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; P1: swap lands both variables at once: 3*v0 + v1.
(check
  (= (int-subst-of p1_parent p1_map)
     (IntAdd (IntMul (CoordVar p1_source_shape 0) (IntLit 3)) (CoordVar p1_source_shape 1))))

; P2: the 3-cycle: 15*v0 + 5*v2 + v1, all out-box [3,5,2] coordinates.
(check
  (= (int-subst-of p2_parent p2_map)
     (IntAdd (IntMul (CoordVar p2_out_shape 0) (IntLit 15))
       (IntAdd (IntMul (CoordVar p2_out_shape 2) (IntLit 5))
         (CoordVar p2_out_shape 1)))))

; P3: the diagonal: 4*v0 + v0, exactly this form (no ring folding —
; distributivity is deliberately absent).
(check
  (= (int-subst-of p3_parent p3_map)
     (IntAdd (IntMul (CoordVar p3_out_shape 0) (IntLit 4)) (CoordVar p3_out_shape 0))))

; P4: compound entry lands intact: 8*v0 + (2*v1 + 1), out-box [3,2].
(check
  (= (int-subst-of p4_parent p4_map)
     (IntAdd (IntMul (CoordVar p4_out_shape 0) (IntLit 8))
       (IntAdd (IntMul (CoordVar p4_out_shape 1) (IntLit 2)) (IntLit 1)))))

; P5: BOTH representatives' images are in the one result class — the
; factored image verbatim, and the expanded image with its constant
; folded (2*2 -> 4).
(check
  (= (int-subst-of p5_parent p5_map)
     (IntMul (IntAdd (IntLit 2) (CoordVar p5_out_shape 0)) (IntLit 2))))
(check
  (= (int-subst-of p5_parent p5_map)
     (IntAdd (IntLit 4) (IntMul (CoordVar p5_out_shape 0) (IntLit 2)))))

; P6: composition lands on the out box's inner coordinate — same axis
; and extent as the parent's, but OWNED by [4,5] (pre-scoping this was
; term-identical to p6_parent; ownership now separates the boxes).
(check (= (int-subst-of p6_parent p6_map) (CoordVar p6_out_shape 0)))

; P7: the in-range subterm resolves to the out box's coordinate...
(check
  (= (int-subst-of (CoordVar p7_source_shape 0) p7_map)
     (CoordVar p7_out_shape 0)))
; ...and the root never completes: axis 2 has no map entry and no
; source dim, which downstream consumers see as "composition not
; derivable" — the fail-safe.
(fail (check (= ?p7_image (int-subst-of p7_parent p7_map))))

; P8: the source box's own coordinate substitutes; the foreign
; coordinate's slot never fills — domain membership, not range, is the
; refusal (the entry is in-range for both boxes).
(check (= (int-subst-of p8_own p8_map) (IntLit 1)))
(fail (check (= ?p8_image (int-subst-of p8_foreign p8_map))))

; P9: the cast crosses: image = cast((2 - v0) < 2), structurally.
(check
  (= (int-subst-of p9_parent p9_map)
     (IntCastFromBool (BoolLessThanInt p9_entry (IntLit 2)))))
