;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Boundary condition: two aliased input views, with one view mutated in place.
;
; Semantics:
; - both inputs are distinct logical/layout views of shared storage
; - the first view is mutated in place
; - the second alias is returned unchanged

(let storage_shape (ShapeLit (IntExprCons (IntLit 2) (IntExprCons (IntLit 2) (IntExprNil)))))
(let view_shape (ShapeLit (IntExprCons (IntLit 2) (IntExprNil))))
(let view_dtype (F32))

(let storage_logical
  (LogicalTensorInputLit (LogicalIdLit "aliased_mut_storage") storage_shape view_dtype))

(let row0_index_map
  (IndexMapLit
    (IntExprCons (IntLit 0)
      (IntExprCons (CoordVar view_shape 0)
        (IntExprNil)))
    storage_shape))

(let row1_index_map
  (IndexMapLit
    (IntExprCons (IntLit 1)
      (IntExprCons (CoordVar view_shape 0)
        (IntExprNil)))
    storage_shape))

(let row0_view_logical
  (LogicalIndexMapApply storage_logical row0_index_map view_shape))

(let row1_view_logical
  (LogicalIndexMapApply storage_logical row1_index_map view_shape))

(let mutated_row0_logical
  (LogicalSqrt row0_view_logical))

(let row0_element_offset
  (CoordVar view_shape 0))

(let row1_element_offset
  (IntAdd (IntLit 2) (CoordVar view_shape 0)))

(let row0_view_layout
  (ElementOffsetExpressionLayoutLit row0_element_offset view_shape (bits-of view_dtype)))

(let row1_view_layout
  (ElementOffsetExpressionLayoutLit row1_element_offset view_shape (bits-of view_dtype)))

(let row0_view_layout_tensor
  (LayoutTensorLit row0_view_logical row0_view_layout))

(let row1_view_layout_tensor
  (LayoutTensorLit row1_view_logical row1_view_layout))

; The mutated value is written through the row-0 view's layout.
(let mutated_row0_layout_tensor
  (LayoutTensorLit mutated_row0_logical row0_view_layout))

(let shared_buffer_id (BufferLit 230))
(set (buffer-access-of shared_buffer_id) (ReadWrite))
(set (buffer-freed-by shared_buffer_id) (CallerFrees))

(let row0_input_buffer_tensor
  (BufferTensorLit row0_view_layout_tensor shared_buffer_id))

(let row1_input_buffer_tensor
  (BufferTensorLit row1_view_layout_tensor shared_buffer_id))

(let mutated_row0_output_buffer_tensor
  (BufferTensorLit mutated_row0_layout_tensor shared_buffer_id))

(let row1_output_buffer_tensor
  (BufferTensorLit row1_view_layout_tensor shared_buffer_id))

(let input_boundary
  (BufferInputLit
    (BufferTensorCons row0_input_buffer_tensor
      (BufferTensorCons row1_input_buffer_tensor
        (BufferTensorNil)))))

(let output
  (BufferOutputLit
    (BufferTensorCons mutated_row0_output_buffer_tensor
      (BufferTensorCons row1_output_buffer_tensor
        (BufferTensorNil)))))

(run-schedule (saturate (saturate (run)) (run subst-walk)) (run materializing-copy-mint) (run layout-tensor-op-metadata) (saturate (run fixpoint-invariants)))

; The inputs alias each other, and the output writes into that same storage.
(check (= (buffer-id-of row0_input_buffer_tensor)
          (buffer-id-of row1_input_buffer_tensor)))

(check (= (buffer-id-of row0_input_buffer_tensor)
          (buffer-id-of mutated_row0_output_buffer_tensor)))

(check (= row1_input_buffer_tensor row1_output_buffer_tensor))

; The output buffer points at the post-mutation value.
(check (= (layout-tensor-of mutated_row0_output_buffer_tensor)
          mutated_row0_layout_tensor))

; Both inputs are derived views of the same storage logical tensor.
(check (= (shape-of row0_view_logical) view_shape))
(check (= (shape-of row1_view_logical) view_shape))

; The value computation mutates one aliased view in place.
(check
  (= (input-layout-tensor-list-of
       (LayoutTensorOpSqrtFunctionalGeneric
         row0_view_layout_tensor
         row0_view_layout))
     (LayoutTensorCons row0_view_layout_tensor (LayoutTensorNil))))

(check
  (= (output-layout-tensor-list-of
       (LayoutTensorOpSqrtFunctionalGeneric
         row0_view_layout_tensor
         row0_view_layout))
     (LayoutTensorCons mutated_row0_layout_tensor
       (LayoutTensorNil))))

; The two input layouts still describe different views over one BufferId.
(check
  (= row0_view_layout
     (BitOffsetExpressionLayoutLit
       (IntMul row0_element_offset (IntLit 32))
       view_shape
       (bits-of view_dtype))))

(check
  (= row1_view_layout
     (BitOffsetExpressionLayoutLit
       (IntMul row1_element_offset (IntLit 32))
       view_shape
       (bits-of view_dtype))))
