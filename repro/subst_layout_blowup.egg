(ruleset pytorch-declared)
(relation pytorch-declared-dtype (LogicalTensor Dtype))
(rule
  (
    (pytorch-declared-dtype ?tensor ?declared)
  )
  (
    (set (dtype-of ?tensor) ?declared)
  )
  :ruleset pytorch-declared
  :name "pytorch: declared dtype applies"
)
(relation pytorch-declared-dim-min (IntExpr BigInt))
(relation pytorch-declared-dim-max (IntExpr BigInt))
(rule
  (
    (pytorch-declared-dim-min ?dim ?bound)
  )
  (
    (set (lower-bound-of ?dim) ?bound)
  )
  :ruleset pytorch-declared
  :name "pytorch: declared dim min applies"
)
(rule
  (
    (pytorch-declared-dim-max ?dim ?bound)
  )
  (
    (set (upper-bound-of ?dim) ?bound)
  )
  :ruleset pytorch-declared
  :name "pytorch: declared dim max applies"
)
