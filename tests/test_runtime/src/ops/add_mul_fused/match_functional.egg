; Layout Tensor Op Add Mul Fused Generic
(rule
  (
    (= ?in1_layout_tensor (LayoutTensorLit ?in1_logical ?in1_layout))
    (= ?in2_layout_tensor (LayoutTensorLit ?in2_logical ?in2_layout))
    (= ?out1_layout_tensor (LayoutTensorLit ?out1_logical ?out1_layout))
    (= ?out2_layout_tensor (LayoutTensorLit ?out2_logical ?out2_layout))
    (= ?out1_logical (LogicalAdd ?in1_logical ?in2_logical))
    (= ?out2_logical (LogicalMul ?in1_logical ?in2_logical))
    (= (injectivity-of ?out1_layout_tensor) (Injective))
    (= (injectivity-of ?out2_layout_tensor) (Injective))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in1_layout_tensor (LayoutTensorCons ?in2_layout_tensor (LayoutTensorNil)))
        (LayoutTensorCons ?out1_layout_tensor (LayoutTensorCons ?out2_layout_tensor (LayoutTensorNil)))
      )
    )
    (union ?layout_tensor_op
      (LayoutTensorOpAddMulFusedGeneric ?in1_layout_tensor ?in2_layout_tensor ?out1_layout ?out2_layout)
    )
  )
  :ruleset backend
)
