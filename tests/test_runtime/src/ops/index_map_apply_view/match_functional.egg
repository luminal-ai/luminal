; Layout Tensor Op Index Map Apply View — the zero-movement lowering of
; LogicalIndexMapApply. The output value IS the parent's storage seen
; through the composed offset function, so the op's Layout field must BE
; the composed layout: the parent's bit-offset expression precomposed with
; the index map (the subst-of premise waits silently until the composition
; machinery has derived it), over the view's own domain shape. Matching on
; that composed class — rather than on any injective output layout, as
; Materialize does — is what makes the reinterpretation faithful: every
; representative of that class describes the same bytes the parent put
; there.
;
; Deliberately NO injectivity premise: a view writes nothing, and reads
; through non-injective layouts (broadcast views, stride 0) are legal.
(rule
  (
    (= ?out_logical (LogicalIndexMapApply ?in_logical ?index_map ?out_shape))
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
    (= ?in_layout (BitOffsetExpressionLayoutLit ?parent_bit_offset ?in_shape ?bit_width))
    (= ?composed_bit_offset (int-subst-of ?parent_bit_offset ?index_map))
    (= ?out_layout (BitOffsetExpressionLayoutLit ?composed_bit_offset ?out_shape ?bit_width))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?out_layout))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in_layout_tensor (LayoutTensorNil))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpIndexMapApplyViewGeneric ?in_layout_tensor ?index_map ?out_shape ?out_layout))
  )
  :ruleset backend
)
