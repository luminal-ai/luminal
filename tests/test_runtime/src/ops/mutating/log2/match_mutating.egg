; Layout Tensor Op Log2 Mutating
(rule
  (
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?layout))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?layout))
    (= ?out_logical (LogicalLog2 ?in_logical))
    (= (injectivity-of ?out_layout_tensor) (Injective))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in_layout_tensor (LayoutTensorNil))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op (LayoutTensorOpLog2MutatingGeneric ?in_layout_tensor))
  )
  :ruleset backend
  :name "test_runtime/ops/mutating/log2/match_mutating: Log2 mutating in-place on its one operand"
)
