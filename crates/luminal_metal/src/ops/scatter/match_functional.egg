(rule
  (
    (= ?out_logical (LogicalScatter ?init_logical ?coordinate_list ?src_logical))
    (= ?init_layout_tensor (LayoutTensorLit ?init_logical ?init_layout))
    (= ?src_layout_tensor (LayoutTensorLit ?src_logical ?src_layout))
    (coordinate-layout-tensors ?coordinate_list ?coordinate_layout_tensors)
    (= ?src_shape (shape-of ?src_logical))
    (= ?src_shape (coords-common-shape ?coordinate_list))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?out_layout))
    (= ?out_layout (RightMajorContiguousElementLayoutLit ?out_rm_shape ?out_rm_bits))
    (= (injectivity-of ?out_layout_tensor) (Injective))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?init_layout_tensor
          (LayoutTensorCons ?src_layout_tensor ?coordinate_layout_tensors))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpScatterFunctionalGeneric ?init_layout_tensor ?src_layout_tensor ?coordinate_layout_tensors ?out_layout))
  )
)
