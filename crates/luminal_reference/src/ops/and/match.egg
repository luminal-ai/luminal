(rule ((= ?out (LogicalAnd ?a ?b))
 (= ?it (LayoutTensorLit ?a ?il))
 (= ?bt (LayoutTensorLit ?b ?bl))
 (= ?os (shape-of ?out)) (= ?ow (bits-of (dtype-of ?out)))
 (= ?ol (RightMajorContiguousElementLayoutLit ?os ?ow))
 (= ?ot (LayoutTensorLit ?out ?ol))
)
 ((let op (LayoutTensorOpLit (LayoutTensorCons ?it (LayoutTensorCons ?bt (LayoutTensorNil))) (LayoutTensorCons ?ot (LayoutTensorNil))))
  (union op (LayoutTensorOpAndGeneric ?it ?bt ?ol)))
 :ruleset backend :name "reference/and/materialize")
