; Match the established matrix-product helper in egglog. The floating
; multiply and reduction execute at the declared storage width.
(rule
 ((= ?out (LogicalHelperMatrixMultiply ?a ?b))
  (= ?dtype (dtype-of ?out))
  (= ?dtype (F32))
  (= (dtype-of ?a) ?dtype)
  (= (dtype-of ?b) ?dtype)
  (= ?al (LayoutTensorLit ?a ?ax))
  (= ?bl (LayoutTensorLit ?b ?bx))
  (= ?ol (LayoutTensorLit ?out ?ox))
  (= (injectivity-of ?ol) (Injective)))
 ((let ?op (LayoutTensorOpLit (LayoutTensorCons ?al (LayoutTensorCons ?bl (LayoutTensorNil))) (LayoutTensorCons ?ol (LayoutTensorNil))))
  (union ?op (LayoutTensorOpMatrixMultiplyGeneric ?al ?bl ?ox)))
 :ruleset backend :name "reference/matrix_multiply: F32 matrix product without broadcast materialization")
(rule
 ((= ?out (LogicalHelperMatrixMultiply ?a ?b))
  (= ?dtype (dtype-of ?out))
  (= ?dtype (F64))
  (= (dtype-of ?a) ?dtype)
  (= (dtype-of ?b) ?dtype)
  (= ?al (LayoutTensorLit ?a ?ax))
  (= ?bl (LayoutTensorLit ?b ?bx))
  (= ?ol (LayoutTensorLit ?out ?ox))
  (= (injectivity-of ?ol) (Injective)))
 ((let ?op (LayoutTensorOpLit (LayoutTensorCons ?al (LayoutTensorCons ?bl (LayoutTensorNil))) (LayoutTensorCons ?ol (LayoutTensorNil))))
  (union ?op (LayoutTensorOpMatrixMultiplyGeneric ?al ?bl ?ox)))
 :ruleset backend :name "reference/matrix_multiply: F64 matrix product without broadcast materialization")

; Absorb exact half-to-F32 operand casts into GEMM's accounted scratch.
(rule
 ((= ?out (LogicalHelperMatrixMultiply ?a ?b))
  (= ?a (LogicalCast ?sa (F32)))
  (= ?b (LogicalCast ?sb (F32)))
  (= (dtype-of ?out) (F32))
  (= (dtype-of ?sa) (F16))
  (= (dtype-of ?sb) (F16))
  (= ?al (LayoutTensorLit ?sa ?ax))
  (= ?bl (LayoutTensorLit ?sb ?bx))
  (= ?ol (LayoutTensorLit ?out ?ox))
  (= (injectivity-of ?ol) (Injective)))
 ((let ?op (LayoutTensorOpLit (LayoutTensorCons ?al (LayoutTensorCons ?bl (LayoutTensorNil))) (LayoutTensorCons ?ol (LayoutTensorNil))))
  (union ?op (LayoutTensorOpMatrixMultiplyGeneric ?al ?bl ?ox)))
 :ruleset backend :name "reference/matrix_multiply: F16 input opmath casts")

; Absorb exact half-to-F32 operand casts into GEMM's accounted scratch.
(rule
 ((= ?out (LogicalHelperMatrixMultiply ?a ?b))
  (= ?a (LogicalCast ?sa (F32)))
  (= ?b (LogicalCast ?sb (F32)))
  (= (dtype-of ?out) (F32))
  (= (dtype-of ?sa) (Bf16))
  (= (dtype-of ?sb) (Bf16))
  (= ?al (LayoutTensorLit ?sa ?ax))
  (= ?bl (LayoutTensorLit ?sb ?bx))
  (= ?ol (LayoutTensorLit ?out ?ox))
  (= (injectivity-of ?ol) (Injective)))
 ((let ?op (LayoutTensorOpLit (LayoutTensorCons ?al (LayoutTensorCons ?bl (LayoutTensorNil))) (LayoutTensorCons ?ol (LayoutTensorNil))))
  (union ?op (LayoutTensorOpMatrixMultiplyGeneric ?al ?bl ?ox)))
 :ruleset backend :name "reference/matrix_multiply: Bf16 input opmath casts")
