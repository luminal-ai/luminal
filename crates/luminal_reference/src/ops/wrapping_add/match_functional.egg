; Two's-complement arithmetic is total: the wrapping op mints at every
; injective right-major destination, with no value-bounds proof (contrast
; the proof-gated exact LogicalAdd).
(rule
  (
    (= ?in1_layout_tensor (LayoutTensorLit ?in1_logical ?in1_layout))
    (= ?in2_layout_tensor (LayoutTensorLit ?in2_logical ?in2_layout))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?out_layout))
    (= ?out_logical (LogicalWrappingAdd ?in1_logical ?in2_logical))
    (= (injectivity-of ?out_layout_tensor) (Injective))
    (= ?out_layout (RightMajorContiguousElementLayoutLit ?reference_write_shape ?reference_write_bits))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in1_layout_tensor
          (LayoutTensorCons ?in2_layout_tensor (LayoutTensorNil)))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpWrappingAddFunctionalGeneric ?in1_layout_tensor ?in2_layout_tensor ?out_layout))
  )
  :ruleset backend
  :name "reference/wrapping_add/match_functional: WrappingAddFunctionalGeneric mint, total"
)
