; Layout Tensor Op Index Map Apply View — the zero-movement lowering of
; LogicalIndexMapApply. The output value IS the parent's storage seen
; through the composed offset function, so the op's Layout field must BE
; the composed layout: the parent's bit-offset expression precomposed with
; the index map (the subst-of premise waits silently until the composition
; machinery has derived it), over the view's own domain shape. Matching on
; that composed class — rather than on any injective output layout, as
; Materialize does — is what makes the reinterpretation faithful: every
; representative of that class describes the same bytes the parent put
; there.
;
; Deliberately NO injectivity premise: a view writes nothing, and reads
; through non-injective layouts (broadcast views, stride 0) are legal.
;
; Deliberately EXEMPT from the write-capability guard (ruling 2026-09-01,
; "only do the code gen'd kernels"): every codegen'd kernel match requires
; a right-major contiguous out spelling because its kernel writes `out[i]`
; — but a view IS NOT a kernel. It writes nothing; its out layout is
; REQUIRED above to be the composed bit-offset spelling, the exact
; opposite constraint, and that is what makes the reinterpretation
; faithful.
(rule
  (
    (= ?out_logical (LogicalIndexMapApply ?in_logical ?index_map ?out_shape))
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
    (= ?in_layout (BitOffsetExpressionLayoutLit ?parent_bit_offset ?in_shape ?bit_width))
    (= ?composed_bit_offset (int-subst-of ?parent_bit_offset ?index_map))
    (= ?out_layout (BitOffsetExpressionLayoutLit ?composed_bit_offset ?out_shape ?bit_width))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?out_layout))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in_layout_tensor (LayoutTensorNil))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpIndexMapApplyViewGeneric ?in_layout_tensor ?index_map ?out_shape ?out_layout))
  )
  :ruleset backend
  :name "cuda_lite/index_map_apply_view/match_functional: IndexMapApply as a view on the composed layout"
)

; An exact native stride-composition certificate is an equivalent proof of
; the same zero-movement view. Keep the parent LayoutTensor and IndexMap in the
; certificate state so this cannot pair a result layout with a different
; physical presentation of the same logical parent.
(rule
  (
    (element-stride-view-composition-state ?in-layout-tensor ?index-map
      ?out-logical ?out-shape ?width (IntExprNil) (ElementStrideNil) ?strides)
    (= ?out-layout (ElementStridedLayoutLit ?out-shape ?strides ?width))
    (= ?out-layout-tensor (LayoutTensorLit ?out-logical ?out-layout))
  )
  (
    (let ?layout-tensor-op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in-layout-tensor (LayoutTensorNil))
        (LayoutTensorCons ?out-layout-tensor (LayoutTensorNil))))
    (union ?layout-tensor-op
      (LayoutTensorOpIndexMapApplyViewGeneric
        ?in-layout-tensor ?index-map ?out-shape ?out-layout))
  )
  :ruleset backend
  :name "cuda_lite/index_map_apply_view/match_functional: exact stride certificate is a view"
)

; A bound alias output must rejoin the exact layout authored at the boundary.
; Demand the separately scheduled whole-expression affine certificate only for
; those layouts.  It publishes one canonical ElementStridedLayoutLit without
; adding unrestricted scalar reassociation to the global e-graph.
(rule
  (
    (index-map-bound-read-only-alias-output ?out-logical)
    (= ?out-layout-tensor (LayoutTensorLit ?out-logical ?out-layout))
  )
  ((element-stride-discovery-demand ?out-layout))
  :ruleset main_ruleset
  :name "cuda_lite/index_map_apply_view/match_functional: demand affine proof for a bound output layout"
)
