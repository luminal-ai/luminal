; Layout Tensor Op Copy Generic
(rule
  (
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
    (= ?out_layout_tensor (LayoutTensorLit ?in_logical ?out_layout))
    ; CopyGeneric walks the logical row-major coordinates and indexes both
    ; endpoints through their elected layouts, so every injective destination
    ; is writable. Non-injective sinks remain forbidden below.
    (!= ?in_layout_tensor ?out_layout_tensor)
    (= (injectivity-of ?out_layout_tensor) (Injective))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in_layout_tensor (LayoutTensorNil))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op (LayoutTensorOpCopyGeneric ?in_layout_tensor ?out_layout))
  )
  :ruleset materializing-copy-mint
)
