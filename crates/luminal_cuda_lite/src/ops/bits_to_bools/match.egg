(rule ((= ?out (LogicalBitsToBools ?a))
 (= ?it (LayoutTensorLit ?a ?il))
 (= (bits-of (dtype-of ?a)) (BitWidthLit ?w))
 (= ?os (shape-of ?out)) (= ?ow (bits-of (dtype-of ?out)))
 (= ?ol (RightMajorContiguousElementLayoutLit ?os ?ow))
 (= ?ot (LayoutTensorLit ?out ?ol))
 (= (injectivity-of ?ot) (Injective)))
 ((let op (LayoutTensorOpLit
   (LayoutTensorCons ?it (LayoutTensorNil))
   (LayoutTensorCons ?ot (LayoutTensorNil))))
  (union op (LayoutTensorOpBitsToBoolsGeneric ?it ?w ?ol)))
 :ruleset backend :name "cuda_lite/bits_to_bools/materialize")
