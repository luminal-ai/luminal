; TruncRemFunctionalGeneric — Int. The result WRAPS and mints unproven
; (LUM-833, temporary: torch wraps at every width; the gate returns with
; provenance, LUM-802). The divisor's bounds must still exclude zero
; (fail-closed: no facts, no fire).
(rule
  (
    (= ?in1_layout_tensor (LayoutTensorLit ?in1_logical ?in1_layout))
    (= ?in2_layout_tensor (LayoutTensorLit ?in2_logical ?in2_layout))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?out_layout))
    ; WRITE CAPABILITY (ruling 2026-09-01): this backend's kernels write
    ; `out[i]`, so the rewrite fires only when the out class carries the
    ; right-major contiguous spelling. The e-graph joins equivalent
    ; spellings; the matcher matches the hardware's literal one.
    (= ?out_layout (RightMajorContiguousElementLayoutLit ?out_rm_shape ?out_rm_bits))
    (= ?out_logical (LogicalTruncRem ?in1_logical ?in2_logical))
    (= (injectivity-of ?out_layout_tensor) (Injective))
    (= (dtype-of ?out_logical) (Int))
    (= ?div_lower (value-lower-bound-of ?in2_logical))
    (= ?div_upper (value-upper-bound-of ?in2_logical))
    (>= ?div_lower (bigint 1))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in1_layout_tensor
          (LayoutTensorCons ?in2_layout_tensor (LayoutTensorNil)))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpTruncRemFunctionalGeneric ?in1_layout_tensor ?in2_layout_tensor ?out_layout))
  )
  :ruleset backend
)

