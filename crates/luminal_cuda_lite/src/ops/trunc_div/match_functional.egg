    (= ?out_logical (LogicalTruncDiv ?in1_logical ?in2_logical))
    (= (injectivity-of ?out_layout_tensor) (Injective))
    (= (dtype-of ?out_logical) (Int))
    (= ?lo (value-lower-bound-of ?out_logical))
    (= ?hi (value-upper-bound-of ?out_logical))
    (>= ?lo (bigint -2147483648))
    (<= ?hi (bigint 2147483647))
    (= ?div_lower (value-lower-bound-of ?in2_logical))
    (= ?div_upper (value-upper-bound-of ?in2_logical))
    (>= ?div_lower (bigint 1))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in1_layout_tensor
          (LayoutTensorCons ?in2_layout_tensor (LayoutTensorNil)))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpTruncDivFunctionalGeneric ?in1_layout_tensor ?in2_layout_tensor ?out_layout))
  )
  :ruleset backend
)

