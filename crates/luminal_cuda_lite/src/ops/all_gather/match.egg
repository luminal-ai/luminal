(rule ((= ?out_logical (LogicalAllGather ?in_logical ?group ?width ?sequence))
       (= ?input (LayoutTensorLit ?in_logical ?in_layout))
       (= ?in_layout (RightMajorContiguousElementLayoutLit ?in_shape ?bits))
       (= ?output (LayoutTensorLit ?out_logical ?out_layout))
       (= ?out_layout (RightMajorContiguousElementLayoutLit ?shape ?bits))
       (= (injectivity-of ?output) (Injective)))
      ((let ?op (LayoutTensorOpLit (LayoutTensorCons ?input (LayoutTensorNil))
                                 (LayoutTensorCons ?output (LayoutTensorNil))))
       (union ?op (LayoutTensorOpAllGather ?input ?group ?width ?sequence ?out_layout)))
      :ruleset backend)
