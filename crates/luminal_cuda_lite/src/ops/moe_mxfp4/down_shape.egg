; Shape Propagation : LogicalMoeDownMxfp4 — [s, top_k, hidden] (the
; per-route weighted partials), s from the hidden activations' leading
; axis, top_k and hidden from the term.
(rule
  (
    (= ?out (LogicalMoeDownMxfp4 ?hidden ?ids ?weights ?blocks ?scales ?bias ?hidden_dim ?top_k))
    (= (shape-of ?hidden) (ShapeLit (IntExprCons ?s ?hidden_rest)))
  )
  (
    (set (shape-of ?out) (ShapeLit (IntExprCons ?s (IntExprCons (IntLit ?top_k) (IntExprCons (IntLit ?hidden_dim) (IntExprNil))))))
  )
  :ruleset prop
)
