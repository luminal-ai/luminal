; MoE down host op: six dense read operands, two metadata literals, one
; fresh written output.
(constructor LayoutTensorOpMoeDownMxfp4 (LayoutTensor LayoutTensor LayoutTensor LayoutTensor LayoutTensor LayoutTensor i64 i64 Layout) LayoutTensorOp)

; Layout Tensor Op MoE Down — every operand DENSE (right-major
; contiguous).
(rule
  (
    (= ?out_logical (LogicalMoeDownMxfp4 ?hidden ?ids ?weights ?blocks ?scales ?bias ?hidden_dim ?top_k))
    (= ?hidden_lt (LayoutTensorLit ?hidden ?hidden_layout))
    (= ?hidden_layout (RightMajorContiguousElementLayoutLit ?hidden_shape ?hidden_bits))
    (= ?ids_lt (LayoutTensorLit ?ids ?ids_layout))
    (= ?ids_layout (RightMajorContiguousElementLayoutLit ?ids_shape ?ids_bits))
    (= ?weights_lt (LayoutTensorLit ?weights ?weights_layout))
    (= ?weights_layout (RightMajorContiguousElementLayoutLit ?weights_shape ?weights_bits))
    (= ?blocks_lt (LayoutTensorLit ?blocks ?blocks_layout))
    (= ?blocks_layout (RightMajorContiguousElementLayoutLit ?blocks_shape ?blocks_bits))
    (= ?scales_lt (LayoutTensorLit ?scales ?scales_layout))
    (= ?scales_layout (RightMajorContiguousElementLayoutLit ?scales_shape ?scales_bits))
    (= ?bias_lt (LayoutTensorLit ?bias ?bias_layout))
    (= ?bias_layout (RightMajorContiguousElementLayoutLit ?bias_shape ?bias_bits))
    (= ?out_lt (LayoutTensorLit ?out_logical ?out_layout))
    (= ?out_layout (RightMajorContiguousElementLayoutLit ?out_shape ?out_bits))
    (= (injectivity-of ?out_lt) (Injective))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?hidden_lt
          (LayoutTensorCons ?ids_lt
            (LayoutTensorCons ?weights_lt
              (LayoutTensorCons ?blocks_lt
                (LayoutTensorCons ?scales_lt
                  (LayoutTensorCons ?bias_lt (LayoutTensorNil)))))))
        (LayoutTensorCons ?out_lt (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpMoeDownMxfp4 ?hidden_lt ?ids_lt ?weights_lt ?blocks_lt ?scales_lt ?bias_lt ?hidden_dim ?top_k ?out_layout))
  )
)
