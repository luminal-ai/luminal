; Forward LayoutTensor Propagation : LogicalMoeDownMxfp4 — a fresh
; materialized result in the canonical right-major layout.
(rule
  (
    (= ?out (LogicalMoeDownMxfp4 ?hidden ?ids ?weights ?blocks ?scales ?bias ?hidden_dim ?top_k))
    (= ?hidden_layout_tensor (LayoutTensorLit ?hidden ?hidden_layout))
    (= ?bits (bits-of (dtype-of ?out)))
    (= ?shape (shape-of ?out))
  )
  (
    (let out_layout_tensor (LayoutTensorLit ?out (RightMajorContiguousElementLayoutLit ?shape ?bits)))
  )
)
