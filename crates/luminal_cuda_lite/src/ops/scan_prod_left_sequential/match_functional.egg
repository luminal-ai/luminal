; NON-INT dtypes: ungated (float arithmetic carries its own
; semantics).
; Layout Tensor Op Scan Prod Left Sequential
(rule
  (
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?out_layout))
    ; WRITE CAPABILITY: this backend's kernels write
    ; `out[i]`, so the rewrite fires only when the out class carries the
    ; right-major contiguous spelling. The e-graph joins equivalent
    ; spellings; the matcher matches the hardware's literal one.
    (= ?out_layout (RightMajorContiguousElementLayoutLit ?out_rm_shape ?out_rm_bits))
    (= ?out_logical (LogicalScanProdUnspecified ?in_logical ?axis))
    (= ?value_dtype (dtype-of ?out_logical))
    (!= ?value_dtype (Int))
    (!= ?value_dtype (Int64))
    (= (injectivity-of ?out_layout_tensor) (Injective))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in_layout_tensor (LayoutTensorNil))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpScanProdLeftSequential ?in_layout_tensor ?axis ?out_layout))
  )
  :ruleset backend
  :name "cuda_lite/scan_prod_left_sequential/match_functional: ScanProdLeftSequential functional match, non-Int dtypes"
)

; Int: WRAPS, and mints unproven — torch wraps integer
; arithmetic at every width, so an in-width proof would refuse
; programs eager execution accepts.
; Layout Tensor Op Scan Prod Left Sequential
(rule
  (
    (= ?in_layout_tensor (LayoutTensorLit ?in_logical ?in_layout))
    (= ?out_layout_tensor (LayoutTensorLit ?out_logical ?out_layout))
    ; WRITE CAPABILITY: this backend's kernels write
    ; `out[i]`, so the rewrite fires only when the out class carries the
    ; right-major contiguous spelling. The e-graph joins equivalent
    ; spellings; the matcher matches the hardware's literal one.
    (= ?out_layout (RightMajorContiguousElementLayoutLit ?out_rm_shape ?out_rm_bits))
    (= ?out_logical (LogicalScanProdUnspecified ?in_logical ?axis))
    (= (dtype-of ?out_logical) (Int))
    (= (injectivity-of ?out_layout_tensor) (Injective))
  )
  (
    (let ?layout_tensor_op
      (LayoutTensorOpLit
        (LayoutTensorCons ?in_layout_tensor (LayoutTensorNil))
        (LayoutTensorCons ?out_layout_tensor (LayoutTensorNil))))
    (union ?layout_tensor_op
      (LayoutTensorOpScanProdLeftSequential ?in_layout_tensor ?axis ?out_layout))
  )
  :ruleset backend
  :name "cuda_lite/scan_prod_left_sequential/match_functional: ScanProdLeftSequential functional match, Int wraps unproven"
)

