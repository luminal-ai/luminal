; Scalar values and pointer location are independent of matrix storage types.
; FP32 and TF32 computation require FP32 scales; FP64 requires FP64 scales.
; A tensor scalar stays on the device; no host readback is introduced.
(relation cublaslt-host-scalar-arguments (CublasLtScalarArguments))
(rule
  ((= ?arguments (CublasLtHostScalarArguments ?alpha ?beta)))
  ((cublaslt-host-scalar-arguments ?arguments))
  :ruleset backend
  :name "cublaslt: FP32 host arguments have no scalar read operands")
(rule
  ((= ?arguments (CublasLtHostFloat64ScalarArguments ?alpha ?beta)))
  ((cublaslt-host-scalar-arguments ?arguments))
  :ruleset backend
  :name "cublaslt: FP64 host arguments have no scalar read operands")
(rule
  ((cublaslt-expression-frame
     (CublasLtExpressionFrameOf ?root ?out ?A ?B ?C ?bias ?epilogue ?alpha ?beta)))
  ((cublaslt-scalar-demand ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: demand only scalars owned by an expression frame")
(rule
  ((= ?scaled (LogicalMul ?value ?broadcast))
   (= ?broadcast (LogicalIndexMapApply ?scalar
     (IndexMapLit (IntExprNil) (ShapeLit (IntExprNil))) ?shape))
   (= (shape-of ?scalar) (ShapeLit (IntExprNil)))
   (= ?arithmetic_type (dtype-of ?value))
   (cublaslt-arithmetic-type ?arithmetic_type ?zero ?one)
   (= (dtype-of ?scalar) ?arithmetic_type)
   (= (dtype-of ?scaled) ?arithmetic_type)
   (= (shape-of ?value) ?shape)
   (= (shape-of ?scaled) ?shape))
  ((cublaslt-scalar-multiplication ?scaled ?value ?scalar))
  :ruleset backend
  :name "cublaslt: one typed scalar multiplication at its authored position")
(rule
  ((= ?scaled (LogicalMul ?broadcast ?value))
   (= ?broadcast (LogicalIndexMapApply ?scalar
     (IndexMapLit (IntExprNil) (ShapeLit (IntExprNil))) ?shape))
   (= (shape-of ?scalar) (ShapeLit (IntExprNil)))
   (= ?arithmetic_type (dtype-of ?value))
   (cublaslt-arithmetic-type ?arithmetic_type ?zero ?one)
   (= (dtype-of ?scalar) ?arithmetic_type)
   (= (dtype-of ?scaled) ?arithmetic_type)
   (= (shape-of ?value) ?shape)
   (= (shape-of ?scaled) ?shape))
  ((cublaslt-scalar-multiplication ?scaled ?value ?scalar))
  :ruleset backend
  :name "cublaslt: typed scalar on the left at its authored position")
(rule
  ((cublaslt-logical-matrix-product ?product ?A ?B)
   (cublaslt-arithmetic-type (dtype-of ?product) ?zero ?one))
  ((cublaslt-scaled-matrix-product ?product ?A ?B ?one))
  :ruleset backend
  :name "cublaslt: an unscaled product has alpha one")
(rule
  ((cublaslt-logical-matrix-product ?product ?A ?B)
   (cublaslt-scalar-multiplication ?scaled_product ?product ?alpha))
  ((cublaslt-scaled-matrix-product ?scaled_product ?A ?B ?alpha))
  :ruleset backend
  :name "cublaslt: alpha scales the completed product")
(rule
  ((cublaslt-scaled-matrix-product ?product ?A ?B ?alpha)
   (cublaslt-arithmetic-type (dtype-of ?product) ?zero ?one))
  ((cublaslt-product-with-C-matrix ?product ?A ?B (CublasLtNoCMatrix)
     ?alpha ?zero))
  :ruleset backend
  :name "cublaslt: absent C requires literal beta zero")
(rule
  ((cublaslt-scaled-matrix-product ?product ?A ?B ?alpha)
   (= ?expression (LogicalAdd ?product ?scaled_C))
   (cublaslt-scalar-multiplication ?scaled_C ?C ?beta)
   (= (shape-of ?product) (shape-of ?C)))
  ((cublaslt-product-with-C-matrix ?expression ?A ?B (CublasLtCMatrixOf ?C) ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: beta scales C before its addition to the product")
(rule
  ((cublaslt-scaled-matrix-product ?product ?A ?B ?alpha)
   (= ?expression (LogicalAdd ?scaled_C ?product))
   (cublaslt-scalar-multiplication ?scaled_C ?C ?beta)
   (= (shape-of ?product) (shape-of ?C)))
  ((cublaslt-product-with-C-matrix ?expression ?A ?B (CublasLtCMatrixOf ?C) ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: scaled C precedes the product in the authored addition")
(rule
  ((cublaslt-scalar-demand ?alpha ?beta)
   (= ?alpha (LogicalConstant ?alpha_value))
   (= ?beta (LogicalConstant ?beta_value)))
  ((cublaslt-scalar-arguments ?alpha ?beta (F32) (CublasLtHostScalarPointerMode)
     (CublasLtHostScalarArguments ?alpha_value ?beta_value) (LayoutTensorNil)))
  :ruleset backend
  :name "cublaslt: literal FP32 alpha and beta use host scalar pointers")
(rule
  ((cublaslt-scalar-demand ?alpha ?beta)
   (= (shape-of ?alpha) (ShapeLit (IntExprNil)))
   (= (shape-of ?beta) (ShapeLit (IntExprNil)))
   (= ?scalar_type (dtype-of ?alpha))
   (cublaslt-arithmetic-type ?scalar_type ?zero ?one)
   (= (dtype-of ?beta) ?scalar_type)
   (= ?scalar_bits (bits-of ?scalar_type)))
  ((let ?scalar_layout
     (RightMajorContiguousElementLayoutLit (ShapeLit (IntExprNil)) ?scalar_bits))
   (let ?alpha_tensor (LayoutTensorLit ?alpha ?scalar_layout))
   (let ?beta_tensor (LayoutTensorLit ?beta ?scalar_layout))
   (cublaslt-scalar-arguments ?alpha ?beta ?scalar_type (CublasLtDeviceScalarPointerMode)
     (CublasLtDeviceScalarArguments ?alpha_tensor ?beta_tensor)
     (LayoutTensorCons ?alpha_tensor (LayoutTensorCons ?beta_tensor (LayoutTensorNil)))))
  :ruleset backend
  :name "cublaslt: rank zero typed alpha and beta use device scalar pointers")

(rule
  ((cublaslt-scalar-demand ?alpha ?beta)
   (= ?alpha (LogicalConstantF64 ?alpha_value))
   (= ?beta (LogicalConstantF64 ?beta_value)))
  ((cublaslt-scalar-arguments ?alpha ?beta (F64) (CublasLtHostScalarPointerMode)
     (CublasLtHostFloat64ScalarArguments ?alpha_value ?beta_value) (LayoutTensorNil)))
  :ruleset backend
  :name "cublaslt: literal FP64 alpha and beta use host double pointers")
