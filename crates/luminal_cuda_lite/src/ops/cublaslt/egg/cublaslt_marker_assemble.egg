; Stage 3 (base), round 4 
 ; assembly from descriptor READING terms into the
; NO-FEATURE contract: LayoutTensorOpCublasLt (site, descA, descB, descD,
; epilogue), Lit [a, b] -> [out]. One coherent reading set => one base
; candidate whose Lit points at that set's specific layout tensors.
;
; The base op claims the site's OWN output: the LayoutTensorLit tie below
; excludes decorator-minted D readings for MOVED outputs (the round-3
; D-leak; without it a plain-matmul Lit could claim a decorated output).
; ============================================================================
; ROUND 10 (unswapped roles): descriptor A carries the site's a and
; descriptor B the site's b, so the Lit order [a, b] binds descA's operand
; first — the variable names now agree with the descriptors they come
; from. (Round 9 bound descA's tensor as ?b_lt because the roles were
; swapped; keeping that naming under unswapped arms would invert the Lit
; and the executor would swap the operands — a miscompile, caught by the
; round-2 u1 slot audit.)
(rule
  (
    (= ?site (CublasLtLogicalMatmulSite ?a ?b ?out))
    (= ?desc_a (CublasLtOperandADescriptor ?site ?a_lt ?a_operation))
    (= ?desc_b (CublasLtOperandBDescriptor ?site ?b_lt ?b_operation))
    (= ?desc_d (CublasLtOutputDDescriptor ?site ?out_lt))
    (= ?out_lt (LayoutTensorLit ?out ?out_layout))
    (= (injectivity-of ?out_lt) (Injective))
  )
  (
    (let ?op (LayoutTensorOpLit
      (LayoutTensorCons ?a_lt (LayoutTensorCons ?b_lt (LayoutTensorNil)))
      (LayoutTensorCons ?out_lt (LayoutTensorNil))))
    (union ?op (LayoutTensorOpCublasLt ?site ?desc_a ?desc_b ?desc_d
      (CublasLtEpilogueDefault)))
  )
  :ruleset backend
)
