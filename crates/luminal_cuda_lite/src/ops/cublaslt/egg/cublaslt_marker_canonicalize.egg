; ============================================================================
; ROUND 11 — CANONICALIZATION TO THE ONE LOGICAL FORM (Austin, 2026-08-26):
; "we need to stop using N and T [for logical rules], those are descriptions
; of layouts and have no business being associated with logical transforms...
; let's just have the three rewrites that target the logical form that
; cublas expects, then we'll match on different layouts in a single logical
; form."
;
; THE CANONICAL LOGICAL FORM:   A[m,k], B[k,n] -> out[m,n],  spelled as
;   out = ReduceSum( apply(A, (c2 c0), P) * apply(B, (c0 c1), P), 0 )
; over the product P = [m, n, k] (ShapeLit outermost-first; CoordVar /
; ReduceSum axes count from the END: axis 0 = k, the reduced innermost;
; axis 1 = n; axis 2 = m).
;
; Every rule below is named by the LOGICAL SHAPES of its left-hand side —
; never by layout letters, which belong to the descriptor stratum only.
; A non-canonically-stored operand reaches the canonical form as a rank-2
; TRANSPOSE VIEW (a LogicalIndexMapApply through the transpose map) of the
; stored tensor, read through the STANDARD canonical map. The view mints no
; bytes: the views machinery (preamble) composes its layout over the stored
; operand's own buffer, and the transpose-view injectivity transport
; (cublaslt_marker_rewrite.egg) carries the admission fact through to the
; descriptor arms.
;
; ONE-SHOT BY CONSTRUCTION: every right-hand side spells the canonical
; chain (canonical rank-3-product maps only) plus rank-2 transpose views
; (rank-2 maps over rank-2 shapes). Every left-hand side requires a
; NON-canonical rank-3-product map ((c1 c0) in the b role or (c0 c2) in
; the a role), so no rule here can match anything a rule here has minted;
; the set saturates in one generation per recorded chain.
;
; GUARD CENSUS (in exact parity with the round-5 site-rule census these
; grew out of): logical-shape unification only — ?m ?n ?k bound ONCE
; across operand storage shapes, product shape, and out shape (the
; sliced-source attack — storage k=7, product k=3 — dies here); dtype F32
; (prototype scope, kept identical to the site rule so canonicalization
; fires precisely where round 10's per-spelling site rules fired). No
; layout data, no bounds guards.
; ============================================================================
; --- "A[m,k], B[n,k] -> A[m,k], B[k,n]" ------------------------------------
; The recorder's folded-permute spelling
; x.matmul(w.permute((1,0))): b stored [n,k], read through map (c1 c0).
; RHS: the b position holds the rank-2 transpose VIEW of b (shape [k,n])
; read through the standard canonical map (c0 c1); the a position is
; reused unchanged; the two outs are the same value — union them.
(rule
  (
    (= ?out (LogicalReduceSum ?prod 0))
    (= ?prod (LogicalMul ?a_bcast ?b_bcast))
    (= ?a_bcast (LogicalIndexMapApply ?a ?a_map ?prod_shape))
    (= ?b_bcast (LogicalIndexMapApply ?b ?b_map ?prod_shape))
    (= ?a_map (IndexMapLit
        (IntExprCons (CoordVar ?prod_shape 2)
          (IntExprCons (CoordVar ?prod_shape 0) (IntExprNil)))
        ?a_shape))
    (= ?b_map (IndexMapLit
        (IntExprCons (CoordVar ?prod_shape 1)
          (IntExprCons (CoordVar ?prod_shape 0) (IntExprNil)))
        ?b_shape))
    (= ?prod_shape (ShapeLit
        (IntExprCons ?m (IntExprCons ?n (IntExprCons ?k (IntExprNil))))))
    (= (shape-of ?a) ?a_shape)
    (= ?a_shape (ShapeLit (IntExprCons ?m (IntExprCons ?k (IntExprNil)))))
    (= (shape-of ?b) ?b_shape)
    (= ?b_shape (ShapeLit (IntExprCons ?n (IntExprCons ?k (IntExprNil)))))
    (= (shape-of ?out) (ShapeLit (IntExprCons ?m (IntExprCons ?n (IntExprNil)))))
    (= (dtype-of ?a) (F32))
    (= (dtype-of ?b) (F32))
    (= (dtype-of ?out) (F32))
  )
  (
    ; the transpose view of b: [n,k] storage presented as [k,n]. Map-tag
    ; coherence: the map is tagged ?b_shape = shape-of(b), as required.
    (let ?bview_shape (ShapeLit (IntExprCons ?k (IntExprCons ?n (IntExprNil)))))
    (let ?b_view (LogicalIndexMapApply ?b
      (IndexMapLit
        (IntExprCons (CoordVar ?bview_shape 0)
          (IntExprCons (CoordVar ?bview_shape 1) (IntExprNil)))
        ?b_shape)
      ?bview_shape))
    ; the canonical chain: same a position, viewed b via the standard map.
    (let ?canon_out (LogicalReduceSum
      (LogicalMul ?a_bcast
        (LogicalIndexMapApply ?b_view
          (IndexMapLit
            (IntExprCons (CoordVar ?prod_shape 0)
              (IntExprCons (CoordVar ?prod_shape 1) (IntExprNil)))
            ?bview_shape)
          ?prod_shape))
      0))
    (union ?out ?canon_out)
  )
)
; --- "A[k,m], B[k,n] -> A[m,k], B[k,n]" ------------------------------------
; a stored [k,m], read through map (c0 c2). RHS: the a position holds the
; rank-2 transpose VIEW of a (shape [m,k]) read through the standard
; canonical map (c2 c0); the b position is reused unchanged.
(rule
  (
    (= ?out (LogicalReduceSum ?prod 0))
    (= ?prod (LogicalMul ?a_bcast ?b_bcast))
    (= ?a_bcast (LogicalIndexMapApply ?a ?a_map ?prod_shape))
    (= ?b_bcast (LogicalIndexMapApply ?b ?b_map ?prod_shape))
    (= ?a_map (IndexMapLit
        (IntExprCons (CoordVar ?prod_shape 0)
          (IntExprCons (CoordVar ?prod_shape 2) (IntExprNil)))
        ?a_shape))
    (= ?b_map (IndexMapLit
        (IntExprCons (CoordVar ?prod_shape 0)
          (IntExprCons (CoordVar ?prod_shape 1) (IntExprNil)))
        ?b_shape))
    (= ?prod_shape (ShapeLit
        (IntExprCons ?m (IntExprCons ?n (IntExprCons ?k (IntExprNil))))))
    (= (shape-of ?a) ?a_shape)
    (= ?a_shape (ShapeLit (IntExprCons ?k (IntExprCons ?m (IntExprNil)))))
    (= (shape-of ?b) ?b_shape)
    (= ?b_shape (ShapeLit (IntExprCons ?k (IntExprCons ?n (IntExprNil)))))
    (= (shape-of ?out) (ShapeLit (IntExprCons ?m (IntExprCons ?n (IntExprNil)))))
    (= (dtype-of ?a) (F32))
    (= (dtype-of ?b) (F32))
    (= (dtype-of ?out) (F32))
  )
  (
    (let ?aview_shape (ShapeLit (IntExprCons ?m (IntExprCons ?k (IntExprNil)))))
    (let ?a_view (LogicalIndexMapApply ?a
      (IndexMapLit
        (IntExprCons (CoordVar ?aview_shape 0)
          (IntExprCons (CoordVar ?aview_shape 1) (IntExprNil)))
        ?a_shape)
      ?aview_shape))
    (let ?canon_out (LogicalReduceSum
      (LogicalMul
        (LogicalIndexMapApply ?a_view
          (IndexMapLit
            (IntExprCons (CoordVar ?prod_shape 2)
              (IntExprCons (CoordVar ?prod_shape 0) (IntExprNil)))
            ?aview_shape)
          ?prod_shape)
        ?b_bcast)
      0))
    (union ?out ?canon_out)
  )
)
; --- "A[k,m], B[n,k] -> A[m,k], B[k,n]" ------------------------------------
; Both operands stored transposed to the canonical form; both reach it as
; rank-2 transpose views read through the standard maps.
(rule
  (
    (= ?out (LogicalReduceSum ?prod 0))
    (= ?prod (LogicalMul ?a_bcast ?b_bcast))
    (= ?a_bcast (LogicalIndexMapApply ?a ?a_map ?prod_shape))
    (= ?b_bcast (LogicalIndexMapApply ?b ?b_map ?prod_shape))
    (= ?a_map (IndexMapLit
        (IntExprCons (CoordVar ?prod_shape 0)
          (IntExprCons (CoordVar ?prod_shape 2) (IntExprNil)))
        ?a_shape))
    (= ?b_map (IndexMapLit
        (IntExprCons (CoordVar ?prod_shape 1)
          (IntExprCons (CoordVar ?prod_shape 0) (IntExprNil)))
        ?b_shape))
    (= ?prod_shape (ShapeLit
        (IntExprCons ?m (IntExprCons ?n (IntExprCons ?k (IntExprNil))))))
    (= (shape-of ?a) ?a_shape)
    (= ?a_shape (ShapeLit (IntExprCons ?k (IntExprCons ?m (IntExprNil)))))
    (= (shape-of ?b) ?b_shape)
    (= ?b_shape (ShapeLit (IntExprCons ?n (IntExprCons ?k (IntExprNil)))))
    (= (shape-of ?out) (ShapeLit (IntExprCons ?m (IntExprCons ?n (IntExprNil)))))
    (= (dtype-of ?a) (F32))
    (= (dtype-of ?b) (F32))
    (= (dtype-of ?out) (F32))
  )
  (
    (let ?aview_shape (ShapeLit (IntExprCons ?m (IntExprCons ?k (IntExprNil)))))
    (let ?a_view (LogicalIndexMapApply ?a
      (IndexMapLit
        (IntExprCons (CoordVar ?aview_shape 0)
          (IntExprCons (CoordVar ?aview_shape 1) (IntExprNil)))
        ?a_shape)
      ?aview_shape))
    (let ?bview_shape (ShapeLit (IntExprCons ?k (IntExprCons ?n (IntExprNil)))))
    (let ?b_view (LogicalIndexMapApply ?b
      (IndexMapLit
        (IntExprCons (CoordVar ?bview_shape 0)
          (IntExprCons (CoordVar ?bview_shape 1) (IntExprNil)))
        ?b_shape)
      ?bview_shape))
    (let ?canon_out (LogicalReduceSum
      (LogicalMul
        (LogicalIndexMapApply ?a_view
          (IndexMapLit
            (IntExprCons (CoordVar ?prod_shape 2)
              (IntExprCons (CoordVar ?prod_shape 0) (IntExprNil)))
            ?aview_shape)
          ?prod_shape)
        (LogicalIndexMapApply ?b_view
          (IndexMapLit
            (IntExprCons (CoordVar ?prod_shape 0)
              (IntExprCons (CoordVar ?prod_shape 1) (IntExprNil)))
            ?bview_shape)
          ?prod_shape))
      0))
    (union ?out ?canon_out)
  )
)
; ============================================================================
; THE DOUBLE-TRANSPOSE COLLAPSE — the termination anchor (round 11).
;
; A rank-2 transpose view of a rank-2 transpose view is the original
; tensor: transpose is an involution on index space, so ?w below reads
; exactly ?x's elements at exactly ?x's coordinates. The conclusion is
; UNION-ONLY — it mints no terms and can never diverge.
;
; WHY IT IS LOAD-BEARING: the transpose-sandwich rewrite
; (cublaslt_marker_rewrite.egg) fires on the canonical form and mints a
; sibling whose operands are transpose VIEWS — and the sibling is itself
; canonical, so the sandwich fires on it too, minting views-of-views.
; Without this rule those are NEW values every generation and saturation
; never closes (demonstrated by the round-11 revert probe,
; tests/r11_collapse_revert_probe.rs — bounded runs grow without bound).
; With it, generation-3 operands collapse into generation 1, every
; generation-3 chain term hash-conses into the original chain, and the
; sandwich closes in two generations. The same collapse closes the
; canonicalization/sandwich composition: the sandwich's transpose view of
; a canonicalization view rejoins the stored operand.
;
; WELD-SOUNDNESS (extent-1 corners): on an extent-1 axis the coordinate
; class is welded to zero, so a map entry spelled some other way can fall
; into the classes this pattern matches. Every such match has the welded
; axis at extent 1, where the coordinate contributes the single value 0 —
; the matched maps still denote the transpose bijection on their domain
; (a 1-point axis has exactly one index), so the union still unites equal
; values. Same argument as the round-10 transport rule's weld note.
; ============================================================================
(rule
  (
    (= ?w (LogicalIndexMapApply ?v ?tmap2 ?xshape))
    (= ?tmap2 (IndexMapLit
        (IntExprCons (CoordVar ?xshape 0)
          (IntExprCons (CoordVar ?xshape 1) (IntExprNil)))
        ?vshape))
    (= ?v (LogicalIndexMapApply ?x ?tmap1 ?vshape))
    (= ?tmap1 (IndexMapLit
        (IntExprCons (CoordVar ?vshape 0)
          (IntExprCons (CoordVar ?vshape 1) (IntExprNil)))
        ?xshape))
  )
  (
    (union ?w ?x)
  )
)
; ============================================================================
