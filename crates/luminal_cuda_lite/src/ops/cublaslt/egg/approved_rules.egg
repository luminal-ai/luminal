; Production proof relations. None of these helper facts is an executable call.
(relation cublaslt-approved-configuration (CublasLtConfiguration))
(relation cublaslt-layout-axis (LayoutTensor Shape i64 IntExpr IntExpr))
(relation cublaslt-layout-axis-walk (LayoutTensor Shape IntExprList IntAffineExprList))
(relation cublaslt-element-stride-reading (LayoutTensor i64 ElementStride))
(relation cublaslt-positive-extent (IntExpr))
(relation cublaslt-greater-than-or-equal (IntExpr IntExpr))
(relation cublaslt-greater-than-or-equal-demand (IntExpr IntExpr))
(relation cublaslt-unit-element-stride (ElementStride))
(relation cublaslt-leading-dimension-demand (ElementStride IntExpr))
(relation cublaslt-legal-leading-dimension (ElementStride IntExpr IntExpr))
; Reading: tensor, logical rows/cols, storage type, API order/op, API descriptor.
(relation cublaslt-matrix-reading
  (LayoutTensor IntExpr IntExpr Dtype CublasLtMatrixOrder CublasLtMatrixOperation CublasLtMatrixDescriptor))
(relation cublaslt-destination-reading
  (LayoutTensor IntExpr IntExpr Dtype CublasLtMatrixOrder CublasLtMatrixDescriptor))
(relation cublaslt-logical-matrix-product (LogicalTensor LogicalTensor LogicalTensor))
(relation cublaslt-scaled-matrix-product (LogicalTensor LogicalTensor LogicalTensor LogicalTensor))
(relation cublaslt-scalar-multiplication (LogicalTensor LogicalTensor LogicalTensor))
(relation cublaslt-scalar-demand (LogicalTensor LogicalTensor))
(relation cublaslt-scalar-arguments
  (LogicalTensor LogicalTensor CublasLtScalarPointerMode CublasLtScalarArguments LayoutTensorList))
(relation cublaslt-product-with-C-matrix
  (LogicalTensor LogicalTensor LogicalTensor CublasLtLogicalCMatrix LogicalTensor LogicalTensor))
(relation cublaslt-logical-expression
  (LogicalTensor LogicalTensor LogicalTensor CublasLtLogicalCMatrix CublasLtLogicalBias CublasLtEpilogue LogicalTensor LogicalTensor))
(relation cublaslt-rectified-linear-activation (LogicalTensor LogicalTensor))
(relation cublaslt-expression-frame (CublasLtExpressionFrame))
(relation cublaslt-C-matrix-argument
  (CublasLtExpressionFrame CublasLtMatrixDescriptor CublasLtCMatrixArgument CublasLtCMatrixDataType
    LayoutTensorList))
(relation cublaslt-bias-argument
  (CublasLtExpressionFrame IntExpr CublasLtBiasArgument CublasLtBiasDataType LayoutTensorList))
; Complete, whitelist-approved call descriptions are proof facts, not ops.
; Executable forms consume this same admission result without reinterpreting it.
(relation cublaslt-approved-call
  (CublasLtConfiguration CublasLtMatrixDescriptor CublasLtMatrixDescriptor
    CublasLtCMatrixArgument CublasLtBiasArgument CublasLtMatrixDescriptor
    CublasLtExpressionFrame CublasLtScalarArguments))
(relation cublaslt-approved-inputs
  (CublasLtConfiguration CublasLtMatrixDescriptor CublasLtMatrixDescriptor
    CublasLtCMatrixArgument CublasLtBiasArgument CublasLtMatrixDescriptor
    CublasLtExpressionFrame CublasLtScalarArguments LayoutTensorList))

; Exact F32 values may use their own storage or an authored narrow-to-F32
; widening. This relation never bypasses TF32 input rounding.
(relation cublaslt-f32-storage-reading (LogicalTensor LogicalTensor))
(relation cublaslt-output-storage-reading (LogicalTensor LogicalTensor))
(relation cublaslt-narrow-storage-data-type (Dtype))
(cublaslt-narrow-storage-data-type (Bf16))
(cublaslt-narrow-storage-data-type (F16))
(rule
  ((= (dtype-of ?arithmetic_expression) (F32)))
  ((cublaslt-output-storage-reading ?arithmetic_expression ?arithmetic_expression))
  :ruleset backend
  :name "cublaslt: F32 output preserves the arithmetic expression")
(rule
  ((= ?stored_expression (LogicalCast ?arithmetic_expression ?storage_data_type))
   (cublaslt-narrow-storage-data-type ?storage_data_type)
   (= (dtype-of ?arithmetic_expression) (F32))
   (= (dtype-of ?stored_expression) ?storage_data_type)
   (= (shape-of ?arithmetic_expression) (shape-of ?stored_expression)))
  ((cublaslt-output-storage-reading ?arithmetic_expression ?stored_expression))
  :ruleset backend
  :name "cublaslt: authored final cast rounds the complete F32 expression")

; Read complete, shape-owned stride certificates. A singleton Any stays local
; to its axis; compatibility never unions coefficient expressions.
(rule
  ((element-stride-reading ?layout_tensor ?axis ?element_stride))
  ((cublaslt-element-stride-reading ?layout_tensor ?axis ?element_stride))
  :ruleset backend)
(rule
  ((element-stride-axis-walk ?layout (IntExprCons ?extent ?remaining_extents) ?stride_expressions)
   (>= (lower-bound-of ?extent) (bigint 1)))
  ((cublaslt-positive-extent ?extent))
  :ruleset backend)
(cublaslt-unit-element-stride (ElementStrideAny))
(cublaslt-unit-element-stride (ElementStrideExact (IntLit 1)))
(rule
  ((cublaslt-greater-than-or-equal-demand ?left_expression ?left_expression))
  ((cublaslt-greater-than-or-equal ?left_expression ?left_expression))
  :ruleset backend
  :name "cublaslt: correlated symbolic bound")
(rule
  ((cublaslt-greater-than-or-equal-demand ?left_expression ?right_expression)
   (>= (lower-bound-of ?left_expression) (upper-bound-of ?right_expression)))
  ((cublaslt-greater-than-or-equal ?left_expression ?right_expression))
  :ruleset backend
  :name "cublaslt: interval bound")
(rule
  ((cublaslt-leading-dimension-demand (ElementStrideExact ?LeadingDimension) ?minor_extent))
  ((cublaslt-greater-than-or-equal-demand ?LeadingDimension ?minor_extent))
  :ruleset backend
  :name "cublaslt: exact pitch requires legal leading dimension")
(rule
  ((cublaslt-leading-dimension-demand (ElementStrideExact ?LeadingDimension) ?minor_extent)
   (cublaslt-greater-than-or-equal ?LeadingDimension ?minor_extent))
  ((cublaslt-legal-leading-dimension (ElementStrideExact ?LeadingDimension) ?minor_extent ?LeadingDimension))
  :ruleset backend
  :name "cublaslt: legal exact pitch")
(rule
  ((cublaslt-leading-dimension-demand (ElementStrideAny) ?minor_extent)
   (cublaslt-positive-extent ?minor_extent))
  ((cublaslt-legal-leading-dimension (ElementStrideAny) ?minor_extent ?minor_extent))
  :ruleset backend
  :name "cublaslt: choose canonical singleton pitch")

; Two stride orientations, each with two equivalent API readings.
(rule
  ((cublaslt-element-stride-reading ?layout_tensor 1 ?outer_stride)
   (cublaslt-element-stride-reading ?layout_tensor 0 ?inner_stride)
   (cublaslt-unit-element-stride ?inner_stride)
   (= ?layout_tensor (LayoutTensorLit ?logical_tensor ?layout))
   (= (shape-of ?logical_tensor) (ShapeLit (IntExprCons ?row_count (IntExprCons ?column_count (IntExprNil)))))
   (cublaslt-positive-extent ?row_count)
   (cublaslt-positive-extent ?column_count))
  ((cublaslt-leading-dimension-demand ?outer_stride ?column_count))
  :ruleset backend
  :name "cublaslt: demand row pitch")
(rule
  ((cublaslt-element-stride-reading ?layout_tensor 1 ?outer_stride)
   (cublaslt-element-stride-reading ?layout_tensor 0 ?inner_stride)
   (cublaslt-unit-element-stride ?outer_stride)
   (= ?layout_tensor (LayoutTensorLit ?logical_tensor ?layout))
   (= (shape-of ?logical_tensor) (ShapeLit (IntExprCons ?row_count (IntExprCons ?column_count (IntExprNil)))))
   (cublaslt-positive-extent ?row_count)
   (cublaslt-positive-extent ?column_count))
  ((cublaslt-leading-dimension-demand ?inner_stride ?row_count))
  :ruleset backend
  :name "cublaslt: demand column pitch")
(rule
  ((cublaslt-element-stride-reading ?layout_tensor 1 ?outer_stride)
   (cublaslt-element-stride-reading ?layout_tensor 0 ?inner_stride)
   (cublaslt-unit-element-stride ?inner_stride)
   (= ?layout_tensor (LayoutTensorLit ?logical_tensor ?layout))
   (= ?element_data_type (dtype-of ?logical_tensor))
   (= (shape-of ?logical_tensor) (ShapeLit (IntExprCons ?row_count (IntExprCons ?column_count (IntExprNil)))))
   (cublaslt-positive-extent ?row_count)
   (cublaslt-positive-extent ?column_count)
   (cublaslt-legal-leading-dimension ?outer_stride ?column_count ?LeadingDimension))
  ((cublaslt-matrix-reading ?layout_tensor ?row_count ?column_count ?element_data_type (CublasLtRowMajor)
     (CublasLtNoTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?element_data_type (CublasLtRowMajor) ?row_count
         ?column_count ?LeadingDimension (IntLit 1) (IntLit 0))))
   (cublaslt-matrix-reading ?layout_tensor ?row_count ?column_count ?element_data_type (CublasLtColumnMajor)
     (CublasLtTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?element_data_type (CublasLtColumnMajor) ?column_count
         ?row_count ?LeadingDimension (IntLit 1) (IntLit 0)))))
  :ruleset backend
  :name "cublaslt: row layout readings")
(rule
  ((cublaslt-element-stride-reading ?layout_tensor 1 ?outer_stride)
   (cublaslt-element-stride-reading ?layout_tensor 0 ?inner_stride)
   (cublaslt-unit-element-stride ?outer_stride)
   (= ?layout_tensor (LayoutTensorLit ?logical_tensor ?layout))
   (= ?element_data_type (dtype-of ?logical_tensor))
   (= (shape-of ?logical_tensor) (ShapeLit (IntExprCons ?row_count (IntExprCons ?column_count (IntExprNil)))))
   (cublaslt-positive-extent ?row_count)
   (cublaslt-positive-extent ?column_count)
   (cublaslt-legal-leading-dimension ?inner_stride ?row_count ?LeadingDimension))
  ((cublaslt-matrix-reading ?layout_tensor ?row_count ?column_count ?element_data_type (CublasLtColumnMajor)
     (CublasLtNoTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?element_data_type (CublasLtColumnMajor) ?row_count
         ?column_count ?LeadingDimension (IntLit 1) (IntLit 0))))
   (cublaslt-matrix-reading ?layout_tensor ?row_count ?column_count ?element_data_type (CublasLtRowMajor)
     (CublasLtTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?element_data_type (CublasLtRowMajor) ?column_count
         ?row_count ?LeadingDimension (IntLit 1) (IntLit 0)))))
  :ruleset backend
  :name "cublaslt: column layout readings")
; C is read-only: the vendor explicitly permits leading dimension zero to
; broadcast a packed row/column vector. This permission is confined to C;
; A/B and every destination still require the ordinary non-overlapping proof.
(relation cublaslt-C-matrix-reading
  (LayoutTensor IntExpr IntExpr Dtype CublasLtMatrixOrder CublasLtMatrixDescriptor))
(rule
  ((cublaslt-matrix-reading ?tensor ?rows ?columns ?data_type ?order
     (CublasLtNoTranspose) ?descriptor))
  ((cublaslt-C-matrix-reading ?tensor ?rows ?columns ?data_type ?order ?descriptor))
  :ruleset backend
  :name "cublaslt: ordinary matrix storage can be read as C")
(rule
  ((= ?tensor (LayoutTensorLit ?logical ?layout))
   (= ?data_type (dtype-of ?logical))
   (= (shape-of ?logical) (ShapeLit (IntExprCons ?rows (IntExprCons ?columns (IntExprNil)))))
   (cublaslt-positive-extent ?rows)
   (cublaslt-positive-extent ?columns)
   (cublaslt-element-stride-reading ?tensor 1 (ElementStrideExact (IntLit 0)))
   (cublaslt-element-stride-reading ?tensor 0 ?minor_stride)
   (cublaslt-unit-element-stride ?minor_stride))
  ((cublaslt-C-matrix-reading ?tensor ?rows ?columns ?data_type (CublasLtRowMajor)
     (CublasLtMatrixDescriptorOf ?tensor
       (CublasLtMatrixLayoutLit ?data_type (CublasLtRowMajor) ?rows ?columns
         (IntLit 0) (IntLit 1) (IntLit 0)))))
  :ruleset backend
  :name "cublaslt: read a packed feature bias as row-broadcast C")
(rule
  ((= ?tensor (LayoutTensorLit ?logical ?layout))
   (= ?data_type (dtype-of ?logical))
   (= (shape-of ?logical) (ShapeLit (IntExprCons ?rows (IntExprCons ?columns (IntExprNil)))))
   (cublaslt-positive-extent ?rows)
   (cublaslt-positive-extent ?columns)
   (cublaslt-element-stride-reading ?tensor 0 (ElementStrideExact (IntLit 0)))
   (cublaslt-element-stride-reading ?tensor 1 ?minor_stride)
   (cublaslt-unit-element-stride ?minor_stride))
  ((cublaslt-C-matrix-reading ?tensor ?rows ?columns ?data_type (CublasLtColumnMajor)
     (CublasLtMatrixDescriptorOf ?tensor
       (CublasLtMatrixLayoutLit ?data_type (CublasLtColumnMajor) ?rows ?columns
         (IntLit 0) (IntLit 1) (IntLit 0)))))
  :ruleset backend
  :name "cublaslt: read a packed row bias as column-broadcast C")

; A non-transposed reading proves positive rank-two extents, a unit minor
; stride, and LeadingDimension >= the minor extent. Together these prove non-overlapping
; writes, including a padded leading dimension. Keep the SAME LayoutTensor
; and descriptor: D is never transposed or rebound during extraction.
(rule
  ((cublaslt-matrix-reading ?layout_tensor ?row_count ?column_count ?element_data_type ?matrix_order
     (CublasLtNoTranspose) ?matrix_descriptor))
  ((cublaslt-destination-reading ?layout_tensor ?row_count ?column_count ?element_data_type ?matrix_order
     ?matrix_descriptor))
  :ruleset backend
  :name "cublaslt: proven strided destination")

; Recognize complete logical expressions; never match an existing library call.
(rule
  ((= ?matrix_product (LogicalHelperMatrixMultiply ?A_operand ?B_operand))
   (= (dtype-of ?A_operand) (F32))
   (= (dtype-of ?B_operand) (F32))
   (= (dtype-of ?matrix_product) (F32)))
  ((cublaslt-logical-matrix-product ?matrix_product ?A_operand ?B_operand))
  :ruleset backend
  :name "cublaslt: logical product")
(rule
  ((cublaslt-scaled-matrix-product ?matrix_product ?A_operand ?B_operand ?alpha)
   (= ?expression (LogicalAdd ?matrix_product ?C_matrix))
   (= (shape-of ?matrix_product) (shape-of ?C_matrix)))
  ((cublaslt-product-with-C-matrix ?expression ?A_operand ?B_operand (CublasLtCMatrixOf ?C_matrix)
     ?alpha (LogicalConstant 1.0)))
  :ruleset backend
  :name "cublaslt: product then C in one order")
(rule
  ((cublaslt-scaled-matrix-product ?matrix_product ?A_operand ?B_operand ?alpha)
   (= ?expression (LogicalAdd ?C_matrix ?matrix_product))
   (= (shape-of ?matrix_product) (shape-of ?C_matrix)))
  ((cublaslt-product-with-C-matrix ?expression ?A_operand ?B_operand (CublasLtCMatrixOf ?C_matrix)
     ?alpha (LogicalConstant 1.0)))
  :ruleset backend
  :name "cublaslt: C then product in one authored addition")
(rule
  ((cublaslt-product-with-C-matrix ?expression ?A_operand ?B_operand ?C_matrix ?alpha ?beta))
  ((cublaslt-logical-expression ?expression ?A_operand ?B_operand ?C_matrix (CublasLtNoBias)
     (CublasLtDefaultEpilogue) ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: expression without bias")
(rule
  ((cublaslt-product-with-C-matrix ?expression ?A_operand ?B_operand ?C_matrix ?alpha ?beta)
   (= ?output_expression (LogicalAdd ?expression ?broadcast_bias))
   (= (shape-of ?expression) (ShapeLit (IntExprCons ?m (IntExprCons ?n (IntExprNil)))))
   (= ?broadcast_bias (LogicalHelperBroadcastAxis ?bias 1 ?m))
   (= (shape-of ?bias) (ShapeLit (IntExprCons ?n (IntExprNil)))))
  ((cublaslt-logical-expression ?output_expression ?A_operand ?B_operand ?C_matrix (CublasLtBiasOf ?bias)
     (CublasLtBiasEpilogue) ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: add feature bias after C")
; Minimal explicit select spelling, useful for adversarial fixtures.
(rule
  ((= ?output_expression
     (LogicalSelect (LogicalLessThan ?activation_input ?zero_tensor) ?zero_tensor ?activation_input))
   (= ?zero_tensor (LogicalIndexMapApply (LogicalConstant 0.0) ?zero_broadcast_index_map ?activation_shape))
   (= ?zero_broadcast_index_map (IndexMapLit (IntExprNil) (ShapeLit (IntExprNil))))
   (= ?activation_shape (shape-of ?activation_input)))
  ((cublaslt-rectified-linear-activation ?output_expression ?activation_input))
  :ruleset backend
  :name "cublaslt: select ReLU")
; The frontend's full maximum_f32 spelling, including NaN propagation.
; Admission accepts the vendor ReLU sign-of-zero difference.
(rule
  ((= ?comparison_zero
     (LogicalIndexMapApply (LogicalConstant 0.0) ?comparison_zero_broadcast_index_map
       ?comparison_zero_broadcast_shape))
   (= ?nonnegative_or_original_value
     (LogicalSelect (LogicalLessThan ?activation_input ?comparison_zero) ?comparison_zero ?activation_input))
   (= ?input_not_a_number_comparison_float
     (LogicalCast (LogicalLessThan ?activation_input ?activation_input) (F32)))
   (= ?input_not_a_number_comparison_sum
     (LogicalAdd ?input_not_a_number_comparison_float ?input_not_a_number_comparison_float))
   (= ?input_indicator_zero
     (LogicalIndexMapApply (LogicalConstant 0.0) ?input_indicator_zero_broadcast_index_map
       ?input_indicator_zero_broadcast_shape))
   (= ?input_not_a_number_indicator
     (LogicalAdd
       (LogicalCast (LogicalLessThan ?input_indicator_zero ?input_not_a_number_comparison_sum) (F32))
       (LogicalCast (LogicalLessThan ?input_not_a_number_comparison_sum ?input_indicator_zero) (F32))))
   (= ?input_not_a_number_predicate_zero
     (LogicalIndexMapApply (LogicalConstant 0.0) ?input_not_a_number_predicate_zero_broadcast_index_map
       ?input_not_a_number_predicate_zero_broadcast_shape))
   (= ?input_is_not_a_number
     (LogicalLessThan ?input_not_a_number_predicate_zero ?input_not_a_number_indicator))
   (= ?input_not_a_number_value
     (LogicalIndexMapApply (LogicalConstant NaN) ?input_not_a_number_broadcast_index_map
       ?input_not_a_number_broadcast_shape))
   (= ?input_not_a_number_preserving_result
     (LogicalSelect ?input_is_not_a_number ?input_not_a_number_value ?nonnegative_or_original_value))
   (= ?comparison_zero_not_a_number_comparison_float
     (LogicalCast (LogicalLessThan ?comparison_zero ?comparison_zero) (F32)))
   (= ?comparison_zero_not_a_number_comparison_sum
     (LogicalAdd ?comparison_zero_not_a_number_comparison_float
       ?comparison_zero_not_a_number_comparison_float))
   (= ?comparison_zero_indicator_zero
     (LogicalIndexMapApply (LogicalConstant 0.0) ?comparison_zero_indicator_zero_broadcast_index_map
       ?comparison_zero_indicator_zero_broadcast_shape))
   (= ?comparison_zero_not_a_number_indicator
     (LogicalAdd
       (LogicalCast
         (LogicalLessThan ?comparison_zero_indicator_zero ?comparison_zero_not_a_number_comparison_sum) (F32))
       (LogicalCast
         (LogicalLessThan ?comparison_zero_not_a_number_comparison_sum ?comparison_zero_indicator_zero) (F32))))
   (= ?comparison_zero_not_a_number_predicate_zero
     (LogicalIndexMapApply (LogicalConstant 0.0)
       ?comparison_zero_not_a_number_predicate_zero_broadcast_index_map
       ?comparison_zero_not_a_number_predicate_zero_broadcast_shape))
   (= ?comparison_zero_is_not_a_number
     (LogicalLessThan ?comparison_zero_not_a_number_predicate_zero ?comparison_zero_not_a_number_indicator))
   (= ?comparison_zero_not_a_number_value
     (LogicalIndexMapApply (LogicalConstant NaN) ?comparison_zero_not_a_number_broadcast_index_map
       ?comparison_zero_not_a_number_broadcast_shape))
   (= ?output_expression
     (LogicalSelect ?comparison_zero_is_not_a_number ?comparison_zero_not_a_number_value
       ?input_not_a_number_preserving_result)))
  ((cublaslt-rectified-linear-activation ?output_expression ?activation_input))
  :ruleset backend
  :name "cublaslt: frontend ReLU")
(rule
  ((cublaslt-logical-expression ?expression ?A_operand ?B_operand ?C_matrix ?bias (CublasLtDefaultEpilogue) ?alpha ?beta)
   (cublaslt-rectified-linear-activation ?output_expression ?expression))
  ((cublaslt-logical-expression ?output_expression ?A_operand ?B_operand ?C_matrix ?bias
     (CublasLtRectifiedLinearEpilogue) ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: ReLU of expression without bias")
(rule
  ((cublaslt-logical-expression ?expression ?A_operand ?B_operand ?C_matrix ?bias (CublasLtBiasEpilogue) ?alpha ?beta)
   (cublaslt-rectified-linear-activation ?output_expression ?expression))
  ((cublaslt-logical-expression ?output_expression ?A_operand ?B_operand ?C_matrix ?bias
     (CublasLtRectifiedLinearBiasEpilogue) ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: ReLU of biased expression")
; GELU recognition is local to F32 matrix expressions. These facts describe
; existing frontend DAGs; they neither construct arithmetic nor union tensors.
; Both frontend GELU approximations may use the vendor tanh approximation.
; No cast is skipped, and every scalar is an exact F32 broadcast to this shape.
(relation cublaslt-gaussian-error-linear-input (LogicalTensor))
(relation cublaslt-gaussian-error-linear-activation (LogicalTensor LogicalTensor))
(relation cublaslt-float32-scalar-broadcast (LogicalTensor f64 Shape))
(rule
  ((= ?broadcast (LogicalIndexMapApply (LogicalConstant ?value)
       (IndexMapLit (IntExprNil) (ShapeLit (IntExprNil))) ?shape)))
  ((cublaslt-float32-scalar-broadcast ?broadcast ?value ?shape))
  :ruleset backend
  :name "cublaslt: exact scalar broadcast")
; The current frontend maximum(x, 0) keeps x when x is NaN and guards
; only the zero operand with isnan. Its exact ordered-comparison count is
; two, so that guard is false. Recognize the whole result, including this
; guard, so an authored final cast can round after the fused ReLU.
(rule
  ((= ?shape (shape-of ?activation_input))
   (= (dtype-of ?activation_input) (F32))
   (cublaslt-float32-scalar-broadcast ?zero 0.0 ?shape)
   (cublaslt-float32-scalar-broadcast ?one 1.0 ?shape)
   (cublaslt-float32-scalar-broadcast ?positive_infinity inf ?shape)
   (cublaslt-float32-scalar-broadcast ?negative_infinity -inf ?shape)
   (= ?ordered_count (LogicalAdd
     (LogicalCast (LogicalLessThan ?zero ?positive_infinity) (F32))
     (LogicalCast (LogicalLessThan ?negative_infinity ?zero) (F32))))
   (= ?output_expression (LogicalSelect (LogicalLessThan ?ordered_count ?one) ?zero
     (LogicalSelect (LogicalLessThan ?activation_input ?zero) ?zero ?activation_input))))
  ((cublaslt-rectified-linear-activation ?output_expression ?activation_input))
  :ruleset backend
  :name "cublaslt: frontend ReLU with zero operand NaN guard")
(rule
  ((cublaslt-logical-expression ?expression ?A_operand ?B_operand ?C_matrix ?bias
     (CublasLtDefaultEpilogue) ?alpha ?beta)
   (= (dtype-of ?expression) (F32)))
  ((cublaslt-gaussian-error-linear-input ?expression))
  :ruleset backend
  :name "cublaslt: examine default expression for GELU")
(rule
  ((cublaslt-logical-expression ?expression ?A_operand ?B_operand ?C_matrix ?bias
     (CublasLtBiasEpilogue) ?alpha ?beta)
   (= (dtype-of ?expression) (F32)))
  ((cublaslt-gaussian-error-linear-input ?expression))
  :ruleset backend
  :name "cublaslt: examine bias expression for GELU")
(rule
  ((cublaslt-gaussian-error-linear-input ?activation_input)
   (= ?activation_shape (shape-of ?activation_input))
   (cublaslt-float32-scalar-broadcast ?one 1.0 ?activation_shape)
   (cublaslt-float32-scalar-broadcast ?negative_one -1.0 ?activation_shape)
   (cublaslt-float32-scalar-broadcast ?exponential_scale 1.4426950216293335 ?activation_shape)
   (cublaslt-float32-scalar-broadcast ?tanh_scale 1.5957691669464111 ?activation_shape)
   (cublaslt-float32-scalar-broadcast ?cubic_coefficient 0.044714998453855515 ?activation_shape)
   (= ?scaled_input (LogicalMul ?activation_input ?cubic_coefficient))
   (= ?quadratic_term (LogicalMul ?scaled_input ?activation_input))
   (= ?linear_term (LogicalMul ?activation_input ?tanh_scale))
   (= ?one_plus_quadratic (LogicalAdd ?quadratic_term ?one))
   (= ?sigmoid_input (LogicalMul ?linear_term ?one_plus_quadratic))
   (= ?negative_sigmoid_input (LogicalMul ?sigmoid_input ?negative_one))
   (= ?negative_exponential_scaled (LogicalMul ?negative_sigmoid_input ?exponential_scale))
   (= ?negative_exponential (LogicalExp2 ?negative_exponential_scaled))
   (= ?sigmoid_denominator (LogicalAdd ?negative_exponential ?one))
   (= ?sigmoid (LogicalRecip ?sigmoid_denominator))
   (= ?output_expression (LogicalMul ?activation_input ?sigmoid)))
  ((cublaslt-gaussian-error-linear-activation ?output_expression ?activation_input))
  :ruleset backend
  :name "cublaslt: frontend tanh GELU")
(rule
  ((cublaslt-gaussian-error-linear-input ?activation_input)
   (= ?activation_shape (shape-of ?activation_input))
   (cublaslt-float32-scalar-broadcast ?one 1.0 ?activation_shape)
   (cublaslt-float32-scalar-broadcast ?negative_one -1.0 ?activation_shape)
   (cublaslt-float32-scalar-broadcast ?exponential_scale 1.4426950216293335 ?activation_shape)
   (cublaslt-float32-scalar-broadcast ?inverse_square_root_two 0.7071067690849304 ?activation_shape)
   (cublaslt-float32-scalar-broadcast ?zero 0.0 ?activation_shape)
   (cublaslt-float32-scalar-broadcast ?polynomial_scale 0.32759109139442444 ?activation_shape)
   (cublaslt-float32-scalar-broadcast ?sign_epsilon 1.000000013351432e-10 ?activation_shape)
   (cublaslt-float32-scalar-broadcast ?half 0.5 ?activation_shape)
   (= ?scaled_activation_input (LogicalMul ?activation_input ?inverse_square_root_two))
   (= ?negative_input_predicate (LogicalLessThan ?scaled_activation_input ?zero))
   (= ?negative_input (LogicalMul ?scaled_activation_input ?negative_one))
   (= ?absolute_input (LogicalSelect ?negative_input_predicate ?negative_input ?scaled_activation_input))
   (= ?scaled_absolute_input (LogicalMul ?absolute_input ?polynomial_scale))
   (= ?polynomial_denominator (LogicalAdd ?scaled_absolute_input ?one))
   (= ?polynomial_argument (LogicalRecip ?polynomial_denominator))
   (cublaslt-float32-scalar-broadcast ?polynomial_coefficient_five 1.0614054203033447 ?activation_shape)
   (= ?polynomial_degree_five (LogicalMul ?polynomial_argument ?polynomial_coefficient_five))
   (cublaslt-float32-scalar-broadcast ?polynomial_coefficient_4 -1.453152060508728 ?activation_shape)
   (= ?polynomial_sum_4 (LogicalAdd ?polynomial_degree_five ?polynomial_coefficient_4))
   (= ?polynomial_degree_4 (LogicalMul ?polynomial_sum_4 ?polynomial_argument))
   (cublaslt-float32-scalar-broadcast ?polynomial_coefficient_3 1.421413779258728 ?activation_shape)
   (= ?polynomial_sum_3 (LogicalAdd ?polynomial_degree_4 ?polynomial_coefficient_3))
   (= ?polynomial_degree_3 (LogicalMul ?polynomial_sum_3 ?polynomial_argument))
   (cublaslt-float32-scalar-broadcast ?polynomial_coefficient_2 -0.2844967246055603 ?activation_shape)
   (= ?polynomial_sum_2 (LogicalAdd ?polynomial_degree_3 ?polynomial_coefficient_2))
   (= ?polynomial_degree_2 (LogicalMul ?polynomial_sum_2 ?polynomial_argument))
   (cublaslt-float32-scalar-broadcast ?polynomial_coefficient_1 0.2548295855522156 ?activation_shape)
   (= ?polynomial_sum_1 (LogicalAdd ?polynomial_degree_2 ?polynomial_coefficient_1))
   (= ?polynomial_degree_1 (LogicalMul ?polynomial_sum_1 ?polynomial_argument))
   (= ?sign_denominator (LogicalAdd ?absolute_input ?sign_epsilon))
   (= ?sign_denominator_reciprocal (LogicalRecip ?sign_denominator))
   (= ?input_sign (LogicalMul ?scaled_activation_input ?sign_denominator_reciprocal))
   (= ?input_square (LogicalMul ?scaled_activation_input ?scaled_activation_input))
   (= ?negative_input_square (LogicalMul ?input_square ?negative_one))
   (= ?gaussian_exponential_scaled (LogicalMul ?negative_input_square ?exponential_scale))
   (= ?gaussian_exponential (LogicalExp2 ?gaussian_exponential_scaled))
   (= ?gaussian_polynomial (LogicalMul ?polynomial_degree_1 ?gaussian_exponential))
   (= ?negative_gaussian_polynomial (LogicalMul ?gaussian_polynomial ?negative_one))
   (= ?one_minus_gaussian_polynomial (LogicalAdd ?negative_gaussian_polynomial ?one))
   (= ?error_function (LogicalMul ?input_sign ?one_minus_gaussian_polynomial))
   (= ?half_input (LogicalMul ?activation_input ?half))
   (= ?one_plus_error_function (LogicalAdd ?error_function ?one))
   (= ?output_expression (LogicalMul ?half_input ?one_plus_error_function)))
  ((cublaslt-gaussian-error-linear-activation ?output_expression ?activation_input))
  :ruleset backend
  :name "cublaslt: frontend erf GELU")
(rule
  ((cublaslt-logical-expression ?expression ?A_operand ?B_operand ?C_matrix ?bias
     (CublasLtDefaultEpilogue) ?alpha ?beta)
   (cublaslt-gaussian-error-linear-activation ?output_expression ?expression))
  ((cublaslt-logical-expression ?output_expression ?A_operand ?B_operand ?C_matrix ?bias
     (CublasLtGaussianErrorLinearEpilogue) ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: GELU of default expression")
(rule
  ((cublaslt-logical-expression ?expression ?A_operand ?B_operand ?C_matrix ?bias
     (CublasLtBiasEpilogue) ?alpha ?beta)
   (cublaslt-gaussian-error-linear-activation ?output_expression ?expression))
  ((cublaslt-logical-expression ?output_expression ?A_operand ?B_operand ?C_matrix ?bias
     (CublasLtGaussianErrorLinearBiasEpilogue) ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: GELU of bias expression")
(rule
  ((cublaslt-logical-expression ?output_expression ?A_operand ?B_operand ?C_matrix (CublasLtNoBias) ?epilogue ?alpha ?beta))
  ((cublaslt-expression-frame
     (CublasLtExpressionFrameOf ?output_expression ?output_expression ?A_operand ?B_operand ?C_matrix
       (CublasLtNoBias) ?epilogue ?alpha ?beta)))
  :ruleset backend
  :name "cublaslt: direct expression frame")
; Transpose the COMPLETE expression once, so normal per-feature bias becomes
; the vendor's per-row bias. This is proof construction, not call decoration.
(rule
  ((cublaslt-logical-expression ?output_expression ?A_operand ?B_operand (CublasLtNoCMatrix) ?bias ?epilogue ?alpha ?beta))
  ((let ?transposed_expression (LogicalHelperMatrixTranspose ?output_expression))
   (union ?output_expression (LogicalHelperMatrixTranspose ?transposed_expression))
   (cublaslt-expression-frame
     (CublasLtExpressionFrameOf ?output_expression ?transposed_expression
       (LogicalHelperMatrixTranspose ?B_operand) (LogicalHelperMatrixTranspose ?A_operand)
       (CublasLtNoCMatrix) ?bias ?epilogue ?alpha ?beta)))
  :ruleset backend
  :name "cublaslt: transpose complete expression without C")
(rule
  ((cublaslt-logical-expression ?output_expression ?A_operand ?B_operand (CublasLtCMatrixOf ?C_matrix) ?bias
     ?epilogue ?alpha ?beta))
  ((let ?transposed_expression (LogicalHelperMatrixTranspose ?output_expression))
   (union ?output_expression (LogicalHelperMatrixTranspose ?transposed_expression))
   (cublaslt-expression-frame
     (CublasLtExpressionFrameOf ?output_expression ?transposed_expression
       (LogicalHelperMatrixTranspose ?B_operand) (LogicalHelperMatrixTranspose ?A_operand)
       (CublasLtCMatrixOf (LogicalHelperMatrixTranspose ?C_matrix)) ?bias ?epilogue ?alpha ?beta)))
  :ruleset backend
  :name "cublaslt: transpose complete expression with C")

; Output rounding stays after the complete FP32 expression. Keep the direct
; frame and the proven whole-expression transpose as separate proof steps.
(rule
  ((cublaslt-expression-frame
     (CublasLtExpressionFrameOf ?expression ?expression ?A_operand ?B_operand
       ?C_matrix ?bias ?epilogue ?alpha ?beta))
   (cublaslt-output-storage-reading ?expression ?rounded_expression)
   (cublaslt-narrow-storage-data-type (dtype-of ?rounded_expression)))
  ((cublaslt-expression-frame
     (CublasLtExpressionFrameOf ?rounded_expression ?rounded_expression ?A_operand ?B_operand
       ?C_matrix ?bias ?epilogue ?alpha ?beta)))
  :ruleset backend
  :name "cublaslt: authored final rounding of the direct expression frame")
(rule
  ((cublaslt-expression-frame
     (CublasLtExpressionFrameOf ?original_expression ?api_expression ?A_operand ?B_operand
       ?C_matrix ?bias ?epilogue ?alpha ?beta))
   (= ?original_expression (LogicalHelperMatrixTranspose ?api_expression))
   (cublaslt-output-storage-reading ?original_expression ?rounded_original)
   (cublaslt-narrow-storage-data-type (dtype-of ?rounded_original)))
  ((let ?rounded_api (LogicalHelperMatrixTranspose ?rounded_original))
   (union ?rounded_original (LogicalHelperMatrixTranspose ?rounded_api))
   (cublaslt-expression-frame
     (CublasLtExpressionFrameOf ?rounded_original ?rounded_api ?A_operand ?B_operand
       ?C_matrix ?bias ?epilogue ?alpha ?beta)))
  :ruleset backend
  :name "cublaslt: transpose the complete authored rounded output")

(rule
  ((cublaslt-expression-frame ?expression_frame)
   (= ?expression_frame
     (CublasLtExpressionFrameOf ?original_expression ?output_expression ?A_operand ?B_operand
       (CublasLtNoCMatrix) ?bias ?epilogue ?alpha ?beta))
   (cublaslt-destination-reading ?D_layout_tensor ?m ?n ?element_data_type ?matrix_order ?D_matrix_descriptor)
   (= ?D_layout_tensor (LayoutTensorLit ?output_expression ?layout)))
  ((cublaslt-C-matrix-argument ?expression_frame ?D_matrix_descriptor
     (CublasLtCMatrixAbsent) (CublasLtNoCMatrixDataType)
     (LayoutTensorNil)))
  :ruleset backend
  :name "cublaslt: prove absent C and beta zero")
(rule
  ((cublaslt-expression-frame ?expression_frame)
   (= ?expression_frame
     (CublasLtExpressionFrameOf ?original_expression ?output_expression ?A_operand ?B_operand
       (CublasLtCMatrixOf ?C_matrix) ?bias ?epilogue ?alpha ?beta))
   (= ?D_matrix_descriptor
     (CublasLtMatrixDescriptorOf ?D_layout_tensor
       (CublasLtMatrixLayoutLit ?element_data_type ?matrix_order ?m ?n
         ?D_LeadingDimension (IntLit 1) (IntLit 0))))
   (= ?D_layout_tensor (LayoutTensorLit ?output_expression ?layout))
   (cublaslt-destination-reading ?D_layout_tensor ?m ?n ?element_data_type ?matrix_order ?D_matrix_descriptor)
   (cublaslt-f32-storage-reading ?C_matrix ?C_storage_tensor)
   (= (shape-of ?C_matrix) (shape-of ?C_storage_tensor))
   (= ?C_layout_tensor (LayoutTensorLit ?C_storage_tensor ?C_layout))
   (cublaslt-C-matrix-reading ?C_layout_tensor ?m ?n ?element_data_type ?matrix_order
     ?C_matrix_descriptor))
  ((cublaslt-C-matrix-argument ?expression_frame ?D_matrix_descriptor
     (CublasLtCMatrixInput ?C_matrix_descriptor) (CublasLtCMatrixDataTypeOf ?element_data_type)
     (LayoutTensorCons ?C_layout_tensor (LayoutTensorNil))))
  :ruleset backend
  :name "cublaslt: out of place C permits a different leading dimension")
(rule
  ((cublaslt-expression-frame ?expression_frame)
   (= ?expression_frame
     (CublasLtExpressionFrameOf ?original_expression ?output_expression ?A_operand ?B_operand ?C_matrix
       (CublasLtNoBias) ?epilogue ?alpha ?beta))
   (= (shape-of ?output_expression) (ShapeLit (IntExprCons ?m (IntExprCons ?n (IntExprNil))))))
  ((cublaslt-bias-argument ?expression_frame ?m (CublasLtBiasAbsent) (CublasLtNoBiasDataType)
     (LayoutTensorNil)))
  :ruleset backend
  :name "cublaslt: explicit absent bias")
(rule
  ((cublaslt-expression-frame ?expression_frame)
   (= ?expression_frame
     (CublasLtExpressionFrameOf ?original_expression ?output_expression ?A_operand ?B_operand ?C_matrix
       (CublasLtBiasOf ?bias) ?epilogue ?alpha ?beta))
   (= (shape-of ?output_expression) (ShapeLit (IntExprCons ?m (IntExprCons ?n (IntExprNil)))))
   (= (shape-of ?bias) (ShapeLit (IntExprCons ?m (IntExprNil))))
   (cublaslt-f32-storage-reading ?bias ?bias_storage_tensor)
   (= (shape-of ?bias) (shape-of ?bias_storage_tensor))
   (= ?element_data_type (dtype-of ?bias_storage_tensor))
   (= ?bias_layout_tensor
     (LayoutTensorLit ?bias_storage_tensor
       (RightMajorContiguousElementLayoutLit (shape-of ?bias_storage_tensor) (bits-of ?element_data_type)))))
  ((cublaslt-bias-argument ?expression_frame ?m (CublasLtBiasInput ?bias_layout_tensor ?element_data_type)
     (CublasLtBiasDataTypeOf ?element_data_type) (LayoutTensorCons ?bias_layout_tensor (LayoutTensorNil))))
  :ruleset backend
  :name "cublaslt: packed bias with exact row length")
; Shared admission gate. Every API field and every precision boundary is proved here.
(rule
  ((cublaslt-expression-frame ?expression_frame)
   (= ?expression_frame
     (CublasLtExpressionFrameOf ?original_expression ?output_expression ?A_operand ?B_operand
       ?logical_C_matrix ?logical_bias ?epilogue ?alpha ?beta))
   (cublaslt-operand-storage-reading ?computation_type ?A_operand ?A_storage_tensor)
   (cublaslt-operand-storage-reading ?computation_type ?B_operand ?B_storage_tensor)
   (= (shape-of ?A_operand) (shape-of ?A_storage_tensor))
   (= (shape-of ?B_operand) (shape-of ?B_storage_tensor))
   (= ?A_layout_tensor (LayoutTensorLit ?A_storage_tensor ?A_operand_layout))
   (= ?B_layout_tensor (LayoutTensorLit ?B_storage_tensor ?B_operand_layout))
   (= ?D_layout_tensor (LayoutTensorLit ?output_expression ?D_layout))
   (cublaslt-matrix-reading ?A_layout_tensor ?m ?k ?A_storage_data_type ?A_matrix_order
     ?A_transpose_operation ?A_matrix_descriptor)
   (cublaslt-matrix-reading ?B_layout_tensor ?k ?n ?B_storage_data_type ?B_matrix_order
     ?B_transpose_operation ?B_matrix_descriptor)
   (cublaslt-destination-reading ?D_layout_tensor ?m ?n ?D_storage_data_type ?D_matrix_order
     ?D_matrix_descriptor)
   (= (dtype-of ?output_expression) ?D_storage_data_type)
   (= (dtype-of ?A_operand) (F32))
   (= (dtype-of ?B_operand) (F32))
   (cublaslt-C-matrix-argument ?expression_frame ?D_matrix_descriptor ?C_matrix_argument ?C_matrix_data_type
     ?C_input_tensors)
   (cublaslt-bias-argument ?expression_frame ?m ?bias_argument ?bias_data_type ?bias_input_tensors)
   (cublaslt-scalar-arguments ?alpha ?beta ?scalar_pointer_mode ?scalar_arguments ?scalar_input_tensors)
   (= ?scalar_data_type (F32))
   (= ?configuration
     (CublasLtConfigurationOf ?computation_type ?scalar_data_type ?A_storage_data_type ?B_storage_data_type
       ?C_matrix_data_type ?D_storage_data_type ?bias_data_type ?scalar_pointer_mode ?epilogue ?A_matrix_order
       ?B_matrix_order ?D_matrix_order ?A_transpose_operation ?B_transpose_operation))
   (cublaslt-approved-configuration ?configuration))
  ((cublaslt-approved-call ?configuration ?A_matrix_descriptor ?B_matrix_descriptor ?C_matrix_argument
     ?bias_argument ?D_matrix_descriptor  ?expression_frame ?scalar_arguments))
  :ruleset backend
  :name "cublaslt: approve one complete configuration with exact logical semantics")


; Storage never chooses arithmetic precision. Only an authored widening cast
; permits reading BF16 or FP16 directly, preserving any earlier source narrowing.
(rule
  ((= (dtype-of ?logical_operand) (F32)))
  ((cublaslt-f32-storage-reading ?logical_operand ?logical_operand))
  :ruleset backend)
(rule
  ((= ?logical_operand (LogicalCast ?storage_source (F32)))
   (= (dtype-of ?storage_source) (Bf16))
   (= (dtype-of ?logical_operand) (F32))
   (= (shape-of ?logical_operand) (shape-of ?storage_source)))
  ((cublaslt-f32-storage-reading ?logical_operand ?storage_source))
  :ruleset backend)
(rule
  ((= ?logical_operand (LogicalCast ?storage_source (F32)))
   (= (dtype-of ?storage_source) (F16))
   (= (dtype-of ?logical_operand) (F32))
   (= (shape-of ?logical_operand) (shape-of ?storage_source)))
  ((cublaslt-f32-storage-reading ?logical_operand ?storage_source))
  :ruleset backend)

(rule
  ((cublaslt-f32-storage-reading ?logical_operand ?storage_source))
  ((cublaslt-operand-storage-reading (CublasLtFloat32Computation) ?logical_operand ?storage_source))
  :ruleset backend
  :name "cublaslt: F32 computation reads exact widened storage")

; Both operands must separately prove this same computation contract before
; admission. TF32 casts adopt the device's conversion behavior, including tie
; handling. Only this computation mode may read the pre-cast F32 storage;
; ordinary F32 calls must consume materialized rounded values.
(rule
  ((= ?logical_operand (LogicalCast (LogicalCast ?storage_source (TF32)) (F32)))
   (= (dtype-of ?storage_source) (F32))
   (= (dtype-of ?logical_operand) (F32))
   (= (shape-of ?logical_operand) (shape-of ?storage_source)))
  ((cublaslt-operand-storage-reading (CublasLtTensorFloat32Computation)
     ?logical_operand ?storage_source))
  :ruleset backend
  :name "cublaslt: explicit device TF32 rounding then F32 arithmetic reads F32 storage")
