; ============================================================================
; Stage 3 (decoration) — ROUND 10: decorators with the TRANSPOSE BRIDGE.
;
; The contract family is unchanged (round 4):
;   C-fold : CublasLt        -> CublasLtAccumulate       (insert c at Lit#2)
;            CublasLtBias    -> CublasLtAccumulateBias   (insert c at Lit#2)
;   bias   : CublasLt        -> CublasLtBias             (append bias)
;            CublasLtAccumulate -> CublasLtAccumulateBias (append bias)
;   relu   : epilogue FIELD rewrite in place on any of the four.
; Legality by field premises carries over (C-fold and bias require epilogue
; Default — activation is LAST); termination: every rewrite moves to a
; strictly larger contract or flips Default->Relu; nothing reverts.
;
; THE BRIDGE (round 10): assembled ops now live on the SIBLING site minted
; by the transpose-sandwich rewrite — the claimed output ?y is the rank-2
; transpose VIEW of the recorder-frame value ?y_outer, and the decoration
; dances (Add-C, bias broadcast, the relu dance) are recorded on ?y_outer.
; Each decorator therefore:
;   1. opens the view: (= ?y (LogicalIndexMapApply ?y_outer ?tmap ?ishape))
;      with ?tmap pinned to the rank-2 transpose SPELLING — a structural
;      classification of a specific term, not an ordering read;
;   2. TIES the op's claimed layout to being ?y_outer's layout composed
;      through THIS ?tmap ((= ?inner_L (BitOffsetExpressionLayoutLit
;      (int-subst-of ?d_expr ?tmap) ...)) — the round-9 tie discipline,
;      which kills the wrong-parent binding: a foreign apply spelling of ?y
;      cannot satisfy the tie);
;   3. matches the dance on ?y_outer exactly as rounds 4-7 wrote it;
;   4. mints the decorated claim as the transpose view of the dance output
;      (apply ?dance_out ?tmap ?ishape — same map term: the dance output
;      shares ?y_outer's shape), rides it on the SAME inner layout class,
;      and unions the BACK view (?dance_out = apply of the new claim) so
;      the plan can route the sibling's result to the recorder's boundary
;      value;
;   5. keeps the injectivity gate on the OUTER dance-output layout tensor
;      (the recorder-frame one the preamble proves), and asserts it on the
;      minted inner claim — sound because a rank-2 transpose view of an
;      injective layout is injective (the round-10 transport argument; the
;      preamble's independent transport rule re-derives the same fact).
;
; The C payload is bridged too: the API requires C's descriptor to equal
; D's, so the folded C is the transpose VIEW of the recorded c riding the
; same inner layout class (same bytes as the recorder's c — the view op the
; preamble mints for the apply is the plan route). ldc = ldd by
; construction, as before. The BIAS payload is NOT bridged: the epilogue
; bias vector is rank-1 [n] indexed by the call's m' = n rows of D' — the
; same vector in either frame.
;
; ROUND 7 (E1+E2) relu inlining is unchanged: the dance premises are the
; ONE-LEVEL canonical fill forms, inlined per constructor, no recognizer
; relations.
; ============================================================================
; --- C-fold: CublasLt -> CublasLtAccumulate -------------------------------
(rule
  (
    (= ?op (LayoutTensorOpCublasLt ?site ?desc_a ?desc_b ?desc_d
        (CublasLtEpilogueDefault)))
    (= ?desc_d (CublasLtOutputDDescriptor ?site ?y_lt))
    (= ?op (LayoutTensorOpLit
        (LayoutTensorCons ?a_lt (LayoutTensorCons ?b_lt (LayoutTensorNil)))
        (LayoutTensorCons ?y_lt (LayoutTensorNil))))
    (= ?y_lt (LayoutTensorLit ?y ?inner_L))
    ; the bridge: y is the transpose view of the recorder-frame y_outer...
    (= ?y (LogicalIndexMapApply ?y_outer ?tmap ?ishape))
    (= ?tmap (IndexMapLit
        (IntExprCons (CoordVar ?ishape 0)
          (IntExprCons (CoordVar ?ishape 1) (IntExprNil)))
        ?d_shape))
    ; ...and the claimed layout IS y_outer's layout composed through tmap.
    (= ?y_outer_lt (LayoutTensorLit ?y_outer ?d_layout))
    (= ?d_layout (BitOffsetExpressionLayoutLit ?d_expr ?d_shape ?d_bits))
    (= ?composed_d (int-subst-of ?d_expr ?tmap))
    (= ?inner_L (BitOffsetExpressionLayoutLit ?composed_d ?ishape ?d_bits))
    ; the dance, in the recorder frame: out2 = y_outer + c.
    (= ?out2 (LogicalAdd ?y_outer ?c_logical))
    (= ?c_lt (LayoutTensorLit ?c_logical ?d_layout))
    (= ?out2_outer_lt (LayoutTensorLit ?out2 ?d_layout))
    (= (injectivity-of ?out2_outer_lt) (Injective))
  )
  (
    ; the decorated claim: the transpose view of out2, on the same bytes.
    (let ?inner_out2 (LogicalIndexMapApply ?out2 ?tmap ?ishape))
    (let ?out2_lt (LayoutTensorLit ?inner_out2 ?inner_L))
    (set (injectivity-of ?out2_lt) (Injective))
    ; the back view: the plan route from the sibling claim to the frame.
    (union ?out2 (LogicalIndexMapApply ?inner_out2
      (IndexMapLit
        (IntExprCons (CoordVar ?d_shape 0)
          (IntExprCons (CoordVar ?d_shape 1) (IntExprNil)))
        ?ishape)
      ?d_shape))
    ; the bridged C payload: c^T riding the same inner layout class.
    (let ?c_view_lt (LayoutTensorLit
      (LogicalIndexMapApply ?c_logical ?tmap ?ishape) ?inner_L))
    (let ?op2 (LayoutTensorOpLit
      (LayoutTensorCons ?a_lt (LayoutTensorCons ?b_lt
        (LayoutTensorCons ?c_view_lt (LayoutTensorNil))))
      (LayoutTensorCons ?out2_lt (LayoutTensorNil))))
    (union ?op2 (LayoutTensorOpCublasLtAccumulate ?site ?desc_a ?desc_b
      (CublasLtOutputDDescriptor ?site ?out2_lt)
      ?c_view_lt (CublasLtEpilogueDefault)))
  )
  :ruleset backend
)
; --- C-fold: CublasLtBias -> CublasLtAccumulateBias (c inserted at #2) ----
(rule
  (
    (= ?op (LayoutTensorOpCublasLtBias ?site ?desc_a ?desc_b ?desc_d
        ?bias_lt (CublasLtEpilogueDefault)))
    (= ?desc_d (CublasLtOutputDDescriptor ?site ?y_lt))
    (= ?op (LayoutTensorOpLit
        (LayoutTensorCons ?a_lt (LayoutTensorCons ?b_lt
          (LayoutTensorCons ?bias_lt (LayoutTensorNil))))
        (LayoutTensorCons ?y_lt (LayoutTensorNil))))
    (= ?y_lt (LayoutTensorLit ?y ?inner_L))
    (= ?y (LogicalIndexMapApply ?y_outer ?tmap ?ishape))
    (= ?tmap (IndexMapLit
        (IntExprCons (CoordVar ?ishape 0)
          (IntExprCons (CoordVar ?ishape 1) (IntExprNil)))
        ?d_shape))
    (= ?y_outer_lt (LayoutTensorLit ?y_outer ?d_layout))
    (= ?d_layout (BitOffsetExpressionLayoutLit ?d_expr ?d_shape ?d_bits))
    (= ?composed_d (int-subst-of ?d_expr ?tmap))
    (= ?inner_L (BitOffsetExpressionLayoutLit ?composed_d ?ishape ?d_bits))
    (= ?out2 (LogicalAdd ?y_outer ?c_logical))
    (= ?c_lt (LayoutTensorLit ?c_logical ?d_layout))
    (= ?out2_outer_lt (LayoutTensorLit ?out2 ?d_layout))
    (= (injectivity-of ?out2_outer_lt) (Injective))
  )
  (
    (let ?inner_out2 (LogicalIndexMapApply ?out2 ?tmap ?ishape))
    (let ?out2_lt (LayoutTensorLit ?inner_out2 ?inner_L))
    (set (injectivity-of ?out2_lt) (Injective))
    (union ?out2 (LogicalIndexMapApply ?inner_out2
      (IndexMapLit
        (IntExprCons (CoordVar ?d_shape 0)
          (IntExprCons (CoordVar ?d_shape 1) (IntExprNil)))
        ?ishape)
      ?d_shape))
    (let ?c_view_lt (LayoutTensorLit
      (LogicalIndexMapApply ?c_logical ?tmap ?ishape) ?inner_L))
    (let ?op2 (LayoutTensorOpLit
      (LayoutTensorCons ?a_lt (LayoutTensorCons ?b_lt
        (LayoutTensorCons ?c_view_lt (LayoutTensorCons ?bias_lt (LayoutTensorNil)))))
      (LayoutTensorCons ?out2_lt (LayoutTensorNil))))
    (union ?op2 (LayoutTensorOpCublasLtAccumulateBias ?site ?desc_a ?desc_b
      (CublasLtOutputDDescriptor ?site ?out2_lt)
      ?c_view_lt ?bias_lt (CublasLtEpilogueDefault)))
  )
  :ruleset backend
)
; --- bias: CublasLt -> CublasLtBias ---------------------------------------
; The bias vector is the per-output-feature n-vector, recognized by the
; recorder's true broadcast spelling in the RECORDER frame: rank-1 [n]
; applied through (CoordVar d_shape 0) into the [m,n] shape. In the
; sibling call frame the same vector indexes the rows of D' (call-m = n);
; it is NOT bridged.
(rule
  (
    (= ?op (LayoutTensorOpCublasLt ?site ?desc_a ?desc_b ?desc_d
        (CublasLtEpilogueDefault)))
    (= ?desc_d (CublasLtOutputDDescriptor ?site ?y_lt))
    (= ?op (LayoutTensorOpLit
        (LayoutTensorCons ?a_lt (LayoutTensorCons ?b_lt (LayoutTensorNil)))
        (LayoutTensorCons ?y_lt (LayoutTensorNil))))
    (= ?y_lt (LayoutTensorLit ?y ?inner_L))
    (= ?y (LogicalIndexMapApply ?y_outer ?tmap ?ishape))
    (= ?tmap (IndexMapLit
        (IntExprCons (CoordVar ?ishape 0)
          (IntExprCons (CoordVar ?ishape 1) (IntExprNil)))
        ?d_shape))
    (= ?y_outer_lt (LayoutTensorLit ?y_outer ?d_layout))
    (= ?d_layout (RightMajorContiguousElementLayoutLit ?d_shape ?d_bits))
    (= ?d_layout (BitOffsetExpressionLayoutLit ?d_expr ?d_shape2 ?d_bits2))
    (= ?composed_d (int-subst-of ?d_expr ?tmap))
    (= ?inner_L (BitOffsetExpressionLayoutLit ?composed_d ?ishape ?d_bits2))
    ; THE LAYOUT REQUIREMENT (Austin, 2026-09-01): the bias form is minted
    ; ONLY when the claimed D is provably LEFT-major contiguous over the
    ; sibling frame [n, m] -- the storage order the library accepts for
    ; BIAS/RELU_BIAS (ROW-order D is NOT_SUPPORTED, measured 2026-08-28)
    ; and the one that puts the per-feature vector on D's rows. Two
    ; (= ?inner_L ...) premises on one variable = the class holds BOTH
    ; spellings; downward discovery (preamble 3a/3c + native chain
    ; composition) supplies the literal, this rule never mints it.
    (= ?inner_L (LeftMajorContiguousElementLayoutLit ?ishape ?d_bits2))
    (= ?d_shape (ShapeLit (IntExprCons ?m (IntExprCons ?n (IntExprNil)))))
    (= ?out2 (LogicalAdd ?y_outer ?bias_bcast))
    (= ?bias_bcast (LogicalIndexMapApply ?bias_logical ?bias_map ?d_shape))
    (= ?bias_map (IndexMapLit
        (IntExprCons (CoordVar ?d_shape 0) (IntExprNil))
        ?bias_shape))
    (= (shape-of ?bias_logical) ?bias_shape)
    (= ?bias_shape (ShapeLit (IntExprCons ?n (IntExprNil))))
    (= ?bias_lt (LayoutTensorLit ?bias_logical ?bias_layout))
    (= ?bias_layout (RightMajorContiguousElementLayoutLit ?bias_shape ?bias_bits))
    (= ?out2_outer_lt (LayoutTensorLit ?out2 ?d_layout))
    (= (injectivity-of ?out2_outer_lt) (Injective))
  )
  (
    (let ?inner_out2 (LogicalIndexMapApply ?out2 ?tmap ?ishape))
    (let ?out2_lt (LayoutTensorLit ?inner_out2 ?inner_L))
    (set (injectivity-of ?out2_lt) (Injective))
    (union ?out2 (LogicalIndexMapApply ?inner_out2
      (IndexMapLit
        (IntExprCons (CoordVar ?d_shape 0)
          (IntExprCons (CoordVar ?d_shape 1) (IntExprNil)))
        ?ishape)
      ?d_shape))
    (let ?op2 (LayoutTensorOpLit
      (LayoutTensorCons ?a_lt (LayoutTensorCons ?b_lt
        (LayoutTensorCons ?bias_lt (LayoutTensorNil))))
      (LayoutTensorCons ?out2_lt (LayoutTensorNil))))
    (union ?op2 (LayoutTensorOpCublasLtBias ?site ?desc_a ?desc_b
      (CublasLtOutputDDescriptor ?site ?out2_lt)
      ?bias_lt (CublasLtEpilogueDefault)))
  )
  :ruleset backend
)
; --- bias: CublasLtAccumulate -> CublasLtAccumulateBias -------------------
(rule
  (
    (= ?op (LayoutTensorOpCublasLtAccumulate ?site ?desc_a ?desc_b ?desc_d
        ?c_lt (CublasLtEpilogueDefault)))
    (= ?desc_d (CublasLtOutputDDescriptor ?site ?y_lt))
    (= ?op (LayoutTensorOpLit
        (LayoutTensorCons ?a_lt (LayoutTensorCons ?b_lt
          (LayoutTensorCons ?c_lt (LayoutTensorNil))))
        (LayoutTensorCons ?y_lt (LayoutTensorNil))))
    (= ?y_lt (LayoutTensorLit ?y ?inner_L))
    (= ?y (LogicalIndexMapApply ?y_outer ?tmap ?ishape))
    (= ?tmap (IndexMapLit
        (IntExprCons (CoordVar ?ishape 0)
          (IntExprCons (CoordVar ?ishape 1) (IntExprNil)))
        ?d_shape))
    (= ?y_outer_lt (LayoutTensorLit ?y_outer ?d_layout))
    (= ?d_layout (RightMajorContiguousElementLayoutLit ?d_shape ?d_bits))
    (= ?d_layout (BitOffsetExpressionLayoutLit ?d_expr ?d_shape2 ?d_bits2))
    (= ?composed_d (int-subst-of ?d_expr ?tmap))
    (= ?inner_L (BitOffsetExpressionLayoutLit ?composed_d ?ishape ?d_bits2))
    ; THE LAYOUT REQUIREMENT (Austin, 2026-09-01): the bias form is minted
    ; ONLY when the claimed D is provably LEFT-major contiguous over the
    ; sibling frame [n, m] -- the storage order the library accepts for
    ; BIAS/RELU_BIAS (ROW-order D is NOT_SUPPORTED, measured 2026-08-28)
    ; and the one that puts the per-feature vector on D's rows. Two
    ; (= ?inner_L ...) premises on one variable = the class holds BOTH
    ; spellings; downward discovery (preamble 3a/3c + native chain
    ; composition) supplies the literal, this rule never mints it.
    (= ?inner_L (LeftMajorContiguousElementLayoutLit ?ishape ?d_bits2))
    (= ?d_shape (ShapeLit (IntExprCons ?m (IntExprCons ?n (IntExprNil)))))
    (= ?out2 (LogicalAdd ?y_outer ?bias_bcast))
    (= ?bias_bcast (LogicalIndexMapApply ?bias_logical ?bias_map ?d_shape))
    (= ?bias_map (IndexMapLit
        (IntExprCons (CoordVar ?d_shape 0) (IntExprNil))
        ?bias_shape))
    (= (shape-of ?bias_logical) ?bias_shape)
    (= ?bias_shape (ShapeLit (IntExprCons ?n (IntExprNil))))
    (= ?bias_lt (LayoutTensorLit ?bias_logical ?bias_layout))
    (= ?bias_layout (RightMajorContiguousElementLayoutLit ?bias_shape ?bias_bits))
    (= ?out2_outer_lt (LayoutTensorLit ?out2 ?d_layout))
    (= (injectivity-of ?out2_outer_lt) (Injective))
  )
  (
    (let ?inner_out2 (LogicalIndexMapApply ?out2 ?tmap ?ishape))
    (let ?out2_lt (LayoutTensorLit ?inner_out2 ?inner_L))
    (set (injectivity-of ?out2_lt) (Injective))
    (union ?out2 (LogicalIndexMapApply ?inner_out2
      (IndexMapLit
        (IntExprCons (CoordVar ?d_shape 0)
          (IntExprCons (CoordVar ?d_shape 1) (IntExprNil)))
        ?ishape)
      ?d_shape))
    (let ?op2 (LayoutTensorOpLit
      (LayoutTensorCons ?a_lt (LayoutTensorCons ?b_lt
        (LayoutTensorCons ?c_lt (LayoutTensorCons ?bias_lt (LayoutTensorNil)))))
      (LayoutTensorCons ?out2_lt (LayoutTensorNil))))
    (union ?op2 (LayoutTensorOpCublasLtAccumulateBias ?site ?desc_a ?desc_b
      (CublasLtOutputDDescriptor ?site ?out2_lt)
      ?c_lt ?bias_lt (CublasLtEpilogueDefault)))
  )
  :ruleset backend
)
; --- relu: epilogue field rewrite in place, one rule per constructor ------
; The dance is matched in the RECORDER frame (on ?y_outer); the decorated
; claim is the transpose view of the dance output. Round-7 one-level
; canonical fill forms unchanged.
(rule
  (
    (= ?op (LayoutTensorOpCublasLt ?site ?desc_a ?desc_b ?desc_d
        (CublasLtEpilogueDefault)))
    (= ?desc_d (CublasLtOutputDDescriptor ?site ?y_lt))
    (= ?op (LayoutTensorOpLit ?ins (LayoutTensorCons ?y_lt (LayoutTensorNil))))
    (= ?y_lt (LayoutTensorLit ?y ?inner_L))
    (= ?y (LogicalIndexMapApply ?y_outer ?tmap ?ishape))
    (= ?tmap (IndexMapLit
        (IntExprCons (CoordVar ?ishape 0)
          (IntExprCons (CoordVar ?ishape 1) (IntExprNil)))
        ?d_shape))
    (= ?y_outer_lt (LayoutTensorLit ?y_outer ?d_layout))
    (= ?d_layout (BitOffsetExpressionLayoutLit ?d_expr ?d_shape ?d_bits))
    (= ?composed_d (int-subst-of ?d_expr ?tmap))
    (= ?inner_L (BitOffsetExpressionLayoutLit ?composed_d ?ishape ?d_bits))
    (= ?t (LogicalLessThan ?y_outer ?z_lt))
    (= ?z_lt (LogicalIndexMapApply (LogicalConstant 0.0) ?zm1 ?zt1))
    (= ?tc (LogicalCast ?t (F32)))
    (= ?term1 (LogicalMul ?tc ?z_t1))
    (= ?z_t1 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm2 ?zt2))
    (= ?nm (LogicalMul ?tc ?neg_fill))
    (= ?neg_fill (LogicalIndexMapApply (LogicalConstant -1.0) ?nm1 ?nt1))
    (= ?p (LogicalAdd ?nm ?one_fill))
    (= ?one_fill (LogicalIndexMapApply (LogicalConstant 1.0) ?om1 ?ot1))
    (= ?s1 (LogicalCast (LogicalLessThan ?z_s1 ?p) (F32)))
    (= ?z_s1 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm3 ?zt3))
    (= ?s2 (LogicalCast (LogicalLessThan ?p ?z_s2) (F32)))
    (= ?z_s2 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm4 ?zt4))
    (= ?sum (LogicalAdd ?s1 ?s2))
    (= ?bsel (LogicalLessThan ?z_b ?sum))
    (= ?z_b (LogicalIndexMapApply (LogicalConstant 0.0) ?zm5 ?zt5))
    (= ?u (LogicalCast ?bsel (F32)))
    (= ?term2 (LogicalMul ?u ?y_outer))
    (= ?relu (LogicalAdd ?term1 ?term2))
    (= ?relu_outer_lt (LayoutTensorLit ?relu ?d_layout))
    (= (injectivity-of ?relu_outer_lt) (Injective))
  )
  (
    (let ?inner_relu (LogicalIndexMapApply ?relu ?tmap ?ishape))
    (let ?relu_lt (LayoutTensorLit ?inner_relu ?inner_L))
    (set (injectivity-of ?relu_lt) (Injective))
    (union ?relu (LogicalIndexMapApply ?inner_relu
      (IndexMapLit
        (IntExprCons (CoordVar ?d_shape 0)
          (IntExprCons (CoordVar ?d_shape 1) (IntExprNil)))
        ?ishape)
      ?d_shape))
    (let ?op2 (LayoutTensorOpLit ?ins (LayoutTensorCons ?relu_lt (LayoutTensorNil))))
    (union ?op2 (LayoutTensorOpCublasLt ?site ?desc_a ?desc_b
      (CublasLtOutputDDescriptor ?site ?relu_lt)
      (CublasLtEpilogueRelu)))
  )
  :ruleset backend
)
(rule
  (
    (= ?op (LayoutTensorOpCublasLtBias ?site ?desc_a ?desc_b ?desc_d
        ?bias_lt (CublasLtEpilogueDefault)))
    (= ?desc_d (CublasLtOutputDDescriptor ?site ?y_lt))
    (= ?op (LayoutTensorOpLit ?ins (LayoutTensorCons ?y_lt (LayoutTensorNil))))
    (= ?y_lt (LayoutTensorLit ?y ?inner_L))
    (= ?y (LogicalIndexMapApply ?y_outer ?tmap ?ishape))
    (= ?tmap (IndexMapLit
        (IntExprCons (CoordVar ?ishape 0)
          (IntExprCons (CoordVar ?ishape 1) (IntExprNil)))
        ?d_shape))
    (= ?y_outer_lt (LayoutTensorLit ?y_outer ?d_layout))
    (= ?d_layout (BitOffsetExpressionLayoutLit ?d_expr ?d_shape ?d_bits))
    (= ?composed_d (int-subst-of ?d_expr ?tmap))
    (= ?inner_L (BitOffsetExpressionLayoutLit ?composed_d ?ishape ?d_bits))
    (= ?t (LogicalLessThan ?y_outer ?z_lt))
    (= ?z_lt (LogicalIndexMapApply (LogicalConstant 0.0) ?zm1 ?zt1))
    (= ?tc (LogicalCast ?t (F32)))
    (= ?term1 (LogicalMul ?tc ?z_t1))
    (= ?z_t1 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm2 ?zt2))
    (= ?nm (LogicalMul ?tc ?neg_fill))
    (= ?neg_fill (LogicalIndexMapApply (LogicalConstant -1.0) ?nm1 ?nt1))
    (= ?p (LogicalAdd ?nm ?one_fill))
    (= ?one_fill (LogicalIndexMapApply (LogicalConstant 1.0) ?om1 ?ot1))
    (= ?s1 (LogicalCast (LogicalLessThan ?z_s1 ?p) (F32)))
    (= ?z_s1 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm3 ?zt3))
    (= ?s2 (LogicalCast (LogicalLessThan ?p ?z_s2) (F32)))
    (= ?z_s2 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm4 ?zt4))
    (= ?sum (LogicalAdd ?s1 ?s2))
    (= ?bsel (LogicalLessThan ?z_b ?sum))
    (= ?z_b (LogicalIndexMapApply (LogicalConstant 0.0) ?zm5 ?zt5))
    (= ?u (LogicalCast ?bsel (F32)))
    (= ?term2 (LogicalMul ?u ?y_outer))
    (= ?relu (LogicalAdd ?term1 ?term2))
    (= ?relu_outer_lt (LayoutTensorLit ?relu ?d_layout))
    (= (injectivity-of ?relu_outer_lt) (Injective))
  )
  (
    (let ?inner_relu (LogicalIndexMapApply ?relu ?tmap ?ishape))
    (let ?relu_lt (LayoutTensorLit ?inner_relu ?inner_L))
    (set (injectivity-of ?relu_lt) (Injective))
    (union ?relu (LogicalIndexMapApply ?inner_relu
      (IndexMapLit
        (IntExprCons (CoordVar ?d_shape 0)
          (IntExprCons (CoordVar ?d_shape 1) (IntExprNil)))
        ?ishape)
      ?d_shape))
    (let ?op2 (LayoutTensorOpLit ?ins (LayoutTensorCons ?relu_lt (LayoutTensorNil))))
    (union ?op2 (LayoutTensorOpCublasLtBias ?site ?desc_a ?desc_b
      (CublasLtOutputDDescriptor ?site ?relu_lt)
      ?bias_lt (CublasLtEpilogueRelu)))
  )
  :ruleset backend
)
(rule
  (
    (= ?op (LayoutTensorOpCublasLtAccumulate ?site ?desc_a ?desc_b ?desc_d
        ?c_lt (CublasLtEpilogueDefault)))
    (= ?desc_d (CublasLtOutputDDescriptor ?site ?y_lt))
    (= ?op (LayoutTensorOpLit ?ins (LayoutTensorCons ?y_lt (LayoutTensorNil))))
    (= ?y_lt (LayoutTensorLit ?y ?inner_L))
    (= ?y (LogicalIndexMapApply ?y_outer ?tmap ?ishape))
    (= ?tmap (IndexMapLit
        (IntExprCons (CoordVar ?ishape 0)
          (IntExprCons (CoordVar ?ishape 1) (IntExprNil)))
        ?d_shape))
    (= ?y_outer_lt (LayoutTensorLit ?y_outer ?d_layout))
    (= ?d_layout (BitOffsetExpressionLayoutLit ?d_expr ?d_shape ?d_bits))
    (= ?composed_d (int-subst-of ?d_expr ?tmap))
    (= ?inner_L (BitOffsetExpressionLayoutLit ?composed_d ?ishape ?d_bits))
    (= ?t (LogicalLessThan ?y_outer ?z_lt))
    (= ?z_lt (LogicalIndexMapApply (LogicalConstant 0.0) ?zm1 ?zt1))
    (= ?tc (LogicalCast ?t (F32)))
    (= ?term1 (LogicalMul ?tc ?z_t1))
    (= ?z_t1 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm2 ?zt2))
    (= ?nm (LogicalMul ?tc ?neg_fill))
    (= ?neg_fill (LogicalIndexMapApply (LogicalConstant -1.0) ?nm1 ?nt1))
    (= ?p (LogicalAdd ?nm ?one_fill))
    (= ?one_fill (LogicalIndexMapApply (LogicalConstant 1.0) ?om1 ?ot1))
    (= ?s1 (LogicalCast (LogicalLessThan ?z_s1 ?p) (F32)))
    (= ?z_s1 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm3 ?zt3))
    (= ?s2 (LogicalCast (LogicalLessThan ?p ?z_s2) (F32)))
    (= ?z_s2 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm4 ?zt4))
    (= ?sum (LogicalAdd ?s1 ?s2))
    (= ?bsel (LogicalLessThan ?z_b ?sum))
    (= ?z_b (LogicalIndexMapApply (LogicalConstant 0.0) ?zm5 ?zt5))
    (= ?u (LogicalCast ?bsel (F32)))
    (= ?term2 (LogicalMul ?u ?y_outer))
    (= ?relu (LogicalAdd ?term1 ?term2))
    (= ?relu_outer_lt (LayoutTensorLit ?relu ?d_layout))
    (= (injectivity-of ?relu_outer_lt) (Injective))
  )
  (
    (let ?inner_relu (LogicalIndexMapApply ?relu ?tmap ?ishape))
    (let ?relu_lt (LayoutTensorLit ?inner_relu ?inner_L))
    (set (injectivity-of ?relu_lt) (Injective))
    (union ?relu (LogicalIndexMapApply ?inner_relu
      (IndexMapLit
        (IntExprCons (CoordVar ?d_shape 0)
          (IntExprCons (CoordVar ?d_shape 1) (IntExprNil)))
        ?ishape)
      ?d_shape))
    (let ?op2 (LayoutTensorOpLit ?ins (LayoutTensorCons ?relu_lt (LayoutTensorNil))))
    (union ?op2 (LayoutTensorOpCublasLtAccumulate ?site ?desc_a ?desc_b
      (CublasLtOutputDDescriptor ?site ?relu_lt)
      ?c_lt (CublasLtEpilogueRelu)))
  )
  :ruleset backend
)
(rule
  (
    (= ?op (LayoutTensorOpCublasLtAccumulateBias ?site ?desc_a ?desc_b ?desc_d
        ?c_lt ?bias_lt (CublasLtEpilogueDefault)))
    (= ?desc_d (CublasLtOutputDDescriptor ?site ?y_lt))
    (= ?op (LayoutTensorOpLit ?ins (LayoutTensorCons ?y_lt (LayoutTensorNil))))
    (= ?y_lt (LayoutTensorLit ?y ?inner_L))
    (= ?y (LogicalIndexMapApply ?y_outer ?tmap ?ishape))
    (= ?tmap (IndexMapLit
        (IntExprCons (CoordVar ?ishape 0)
          (IntExprCons (CoordVar ?ishape 1) (IntExprNil)))
        ?d_shape))
    (= ?y_outer_lt (LayoutTensorLit ?y_outer ?d_layout))
    (= ?d_layout (BitOffsetExpressionLayoutLit ?d_expr ?d_shape ?d_bits))
    (= ?composed_d (int-subst-of ?d_expr ?tmap))
    (= ?inner_L (BitOffsetExpressionLayoutLit ?composed_d ?ishape ?d_bits))
    (= ?t (LogicalLessThan ?y_outer ?z_lt))
    (= ?z_lt (LogicalIndexMapApply (LogicalConstant 0.0) ?zm1 ?zt1))
    (= ?tc (LogicalCast ?t (F32)))
    (= ?term1 (LogicalMul ?tc ?z_t1))
    (= ?z_t1 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm2 ?zt2))
    (= ?nm (LogicalMul ?tc ?neg_fill))
    (= ?neg_fill (LogicalIndexMapApply (LogicalConstant -1.0) ?nm1 ?nt1))
    (= ?p (LogicalAdd ?nm ?one_fill))
    (= ?one_fill (LogicalIndexMapApply (LogicalConstant 1.0) ?om1 ?ot1))
    (= ?s1 (LogicalCast (LogicalLessThan ?z_s1 ?p) (F32)))
    (= ?z_s1 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm3 ?zt3))
    (= ?s2 (LogicalCast (LogicalLessThan ?p ?z_s2) (F32)))
    (= ?z_s2 (LogicalIndexMapApply (LogicalConstant 0.0) ?zm4 ?zt4))
    (= ?sum (LogicalAdd ?s1 ?s2))
    (= ?bsel (LogicalLessThan ?z_b ?sum))
    (= ?z_b (LogicalIndexMapApply (LogicalConstant 0.0) ?zm5 ?zt5))
    (= ?u (LogicalCast ?bsel (F32)))
    (= ?term2 (LogicalMul ?u ?y_outer))
    (= ?relu (LogicalAdd ?term1 ?term2))
    (= ?relu_outer_lt (LayoutTensorLit ?relu ?d_layout))
    (= (injectivity-of ?relu_outer_lt) (Injective))
  )
  (
    (let ?inner_relu (LogicalIndexMapApply ?relu ?tmap ?ishape))
    (let ?relu_lt (LayoutTensorLit ?inner_relu ?inner_L))
    (set (injectivity-of ?relu_lt) (Injective))
    (union ?relu (LogicalIndexMapApply ?inner_relu
      (IndexMapLit
        (IntExprCons (CoordVar ?d_shape 0)
          (IntExprCons (CoordVar ?d_shape 1) (IntExprNil)))
        ?ishape)
      ?d_shape))
    (let ?op2 (LayoutTensorOpLit ?ins (LayoutTensorCons ?relu_lt (LayoutTensorNil))))
    (union ?op2 (LayoutTensorOpCublasLtAccumulateBias ?site ?desc_a ?desc_b
      (CublasLtOutputDDescriptor ?site ?relu_lt)
      ?c_lt ?bias_lt (CublasLtEpilogueRelu)))
  )
  :ruleset backend
)
