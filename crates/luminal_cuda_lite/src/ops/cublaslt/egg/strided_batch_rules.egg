; One explicit batch axis. Recognize existing contractions and scalar scaling
; without reassociating them. A/B/C/D share one positive batch count.
; Alpha/beta share the arithmetic dtype; beta is zero without C.
; Bias-free ReLU/GELU use the same complete whitelist as rank-two calls.
(relation cublaslt-strided-batch-coordinate (Shape IntExpr))
(relation cublaslt-strided-batch-product
  (LogicalTensor LogicalTensor LogicalTensor IntExpr IntExpr IntExpr IntExpr))
(relation cublaslt-strided-batch-scaled-product
  (LogicalTensor LogicalTensor LogicalTensor IntExpr IntExpr IntExpr IntExpr LogicalTensor))
(relation cublaslt-strided-batch-product-with-C-matrix
  (LogicalTensor LogicalTensor LogicalTensor LogicalTensor IntExpr IntExpr IntExpr IntExpr LogicalTensor LogicalTensor))
(relation cublaslt-strided-batch-expression
  (LogicalTensor LogicalTensor LogicalTensor CublasLtLogicalCMatrix
    IntExpr IntExpr IntExpr IntExpr CublasLtEpilogue LogicalTensor LogicalTensor))
(relation cublaslt-strided-batch-expression-frame
  (CublasLtExpressionFrame IntExpr IntExpr IntExpr IntExpr))
(relation cublaslt-strided-batch-activation-epilogue (CublasLtEpilogue))
(cublaslt-strided-batch-activation-epilogue (CublasLtRectifiedLinearEpilogue))
(cublaslt-strided-batch-activation-epilogue (CublasLtGaussianErrorLinearEpilogue))
(relation cublaslt-strided-batch-transpose-demand (LogicalTensor))
(relation cublaslt-strided-batch-transpose (LogicalTensor LogicalTensor))
(relation cublaslt-strided-batch-layout-demand (LogicalTensor))
(relation cublaslt-strided-batch-geometry
  (LayoutTensor IntExpr IntExpr IntExpr Dtype ElementStride ElementStride ElementStride))
(relation cublaslt-batch-stride-demand (ElementStride IntExpr))
(relation cublaslt-legal-batch-stride (ElementStride IntExpr IntExpr))
(relation cublaslt-strided-batch-matrix-reading
  (LayoutTensor IntExpr IntExpr IntExpr Dtype CublasLtMatrixOrder CublasLtMatrixOperation CublasLtMatrixDescriptor))
(relation cublaslt-strided-batch-operand-reading
  (LayoutTensor IntExpr IntExpr IntExpr Dtype CublasLtMatrixOrder CublasLtMatrixOperation CublasLtMatrixDescriptor))
(relation cublaslt-strided-batch-destination-reading
  (LayoutTensor IntExpr IntExpr IntExpr Dtype CublasLtMatrixOrder CublasLtMatrixDescriptor))

(rule
  ((cublaslt-strided-batch-scaled-product ?product ?A ?B ?batch ?m ?n ?k ?alpha)
   (cublaslt-arithmetic-type (dtype-of ?product) ?zero ?one))
  ((cublaslt-scalar-demand ?alpha ?zero))
  :ruleset backend
  :name "cublaslt: demand batched product scalars")
(rule
  ((cublaslt-strided-batch-product-with-C-matrix ?out ?A ?B ?C ?batch ?m ?n ?k ?alpha ?beta))
  ((cublaslt-scalar-demand ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: demand batched accumulation scalars")

; The frontend broadcasts A[batch,m,k] and B[batch,k,n] into [batch,m,n,k].
; A singleton batch can read literal zero; otherwise the maps read coordinate 3.
(rule
  ((= ?output_expression (LogicalReduceSum ?products 0))
   (= ?products (LogicalMul ?A_broadcast ?B_broadcast))
   (= ?product_shape (shape-of ?products))
   (= ?product_shape (ShapeLit
     (IntExprCons ?BatchCount (IntExprCons ?m (IntExprCons ?n (IntExprCons ?k (IntExprNil))))))))
  ((cublaslt-strided-batch-coordinate ?product_shape (CoordVar ?product_shape 3)))
  :ruleset backend
  :name "cublaslt: batch coordinate in the contraction domain")
(rule
  ((cublaslt-strided-batch-coordinate ?product_shape ?batch_coordinate)
   (= ?product_shape (ShapeLit
     (IntExprCons (IntLit 1) (IntExprCons ?m (IntExprCons ?n (IntExprCons ?k (IntExprNil))))))))
  ((cublaslt-strided-batch-coordinate ?product_shape (IntLit 0)))
  :ruleset backend
  :name "cublaslt: singleton batch coordinate is zero")
(rule
  ((= ?output_expression (LogicalReduceSum ?products 0))
   (= ?products (LogicalMul ?A_broadcast ?B_broadcast))
   (= ?product_shape (shape-of ?products))
   (= ?product_shape (ShapeLit
     (IntExprCons ?BatchCount (IntExprCons ?m (IntExprCons ?n (IntExprCons ?k (IntExprNil)))))))
   (= ?A_shape (ShapeLit (IntExprCons ?BatchCount (IntExprCons ?m (IntExprCons ?k (IntExprNil))))))
   (= ?B_shape (ShapeLit (IntExprCons ?BatchCount (IntExprCons ?k (IntExprCons ?n (IntExprNil))))))
   (cublaslt-strided-batch-coordinate ?product_shape ?batch_coordinate)
   (= ?A_broadcast (LogicalIndexMapApply ?A_operand
     (IndexMapLit (IntExprCons ?batch_coordinate (IntExprCons (CoordVar ?product_shape 2)
       (IntExprCons (CoordVar ?product_shape 0) (IntExprNil)))) ?A_shape) ?product_shape))
   (= ?B_broadcast (LogicalIndexMapApply ?B_operand
     (IndexMapLit (IntExprCons ?batch_coordinate (IntExprCons (CoordVar ?product_shape 0)
       (IntExprCons (CoordVar ?product_shape 1) (IntExprNil)))) ?B_shape) ?product_shape))
   (= (shape-of ?A_operand) ?A_shape)
   (= (shape-of ?B_operand) ?B_shape)
   (= (shape-of ?output_expression)
     (ShapeLit (IntExprCons ?BatchCount (IntExprCons ?m (IntExprCons ?n (IntExprNil))))))
   (= ?arithmetic_type (dtype-of ?output_expression))
   (cublaslt-arithmetic-type ?arithmetic_type ?zero ?one)
   (= (dtype-of ?A_operand) ?arithmetic_type)
   (= (dtype-of ?B_operand) ?arithmetic_type)
   (= (dtype-of ?products) ?arithmetic_type))
  ((cublaslt-strided-batch-product ?output_expression ?A_operand ?B_operand ?BatchCount ?m ?n ?k))
  :ruleset backend
  :name "cublaslt: exact single axis batched floating contraction")


(rule
  ((cublaslt-strided-batch-product ?product ?A ?B ?batch ?m ?n ?k)
   (cublaslt-arithmetic-type (dtype-of ?product) ?zero ?one))
  ((cublaslt-strided-batch-scaled-product ?product ?A ?B ?batch ?m ?n ?k ?one))
  :ruleset backend
  :name "cublaslt: unscaled batched product has alpha one")
(rule
  ((cublaslt-strided-batch-product ?product ?A ?B ?batch ?m ?n ?k)
   (cublaslt-scalar-multiplication ?scaled ?product ?alpha))
  ((cublaslt-strided-batch-scaled-product ?scaled ?A ?B ?batch ?m ?n ?k ?alpha))
  :ruleset backend
  :name "cublaslt: alpha scales the completed batched product")
(rule
  ((cublaslt-strided-batch-scaled-product ?product ?A ?B ?batch ?m ?n ?k ?alpha)
   (= ?expression (LogicalAdd ?product ?scaled_C))
   (cublaslt-scalar-multiplication ?scaled_C ?C ?beta)
   (= (shape-of ?C) (shape-of ?product)))
  ((cublaslt-strided-batch-product-with-C-matrix ?expression ?A ?B ?C ?batch ?m ?n ?k ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: beta scales batched C before addition")

(rule
  ((cublaslt-strided-batch-scaled-product ?product ?A ?B ?batch ?m ?n ?k ?alpha)
   (= ?expression (LogicalAdd ?scaled_C ?product))
   (cublaslt-scalar-multiplication ?scaled_C ?C ?beta)
   (= (shape-of ?C) (shape-of ?product)))
  ((cublaslt-strided-batch-product-with-C-matrix ?expression ?A ?B ?C ?batch ?m ?n ?k ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: scaled batched C precedes the product in the authored addition")

(rule
  ((cublaslt-strided-batch-scaled-product ?matrix_product ?A_operand ?B_operand ?BatchCount ?m ?n ?k ?alpha)
   (= ?output_expression (LogicalAdd ?matrix_product ?C_matrix))
   (= (shape-of ?C_matrix) (shape-of ?matrix_product))
   (= ?arithmetic_type (dtype-of ?output_expression))
   (cublaslt-arithmetic-type ?arithmetic_type ?zero ?one)
   (= (dtype-of ?C_matrix) ?arithmetic_type))
  ((cublaslt-strided-batch-product-with-C-matrix
     ?output_expression ?A_operand ?B_operand ?C_matrix ?BatchCount ?m ?n ?k ?alpha ?one))
  :ruleset backend
  :name "cublaslt: batched product then C in one order")
(rule
  ((cublaslt-strided-batch-scaled-product ?matrix_product ?A_operand ?B_operand ?BatchCount ?m ?n ?k ?alpha)
   (= ?output_expression (LogicalAdd ?C_matrix ?matrix_product))
   (= (shape-of ?C_matrix) (shape-of ?matrix_product))
   (= ?arithmetic_type (dtype-of ?output_expression))
   (cublaslt-arithmetic-type ?arithmetic_type ?zero ?one)
   (= (dtype-of ?C_matrix) ?arithmetic_type))
  ((cublaslt-strided-batch-product-with-C-matrix
     ?output_expression ?A_operand ?B_operand ?C_matrix ?BatchCount ?m ?n ?k ?alpha ?one))
  :ruleset backend
  :name "cublaslt: batched C then product in one authored addition")
; Recognition describes the whole authored expression before output rounding.
; Activation may follow scaling and C addition, never cross an intervening cast.
(rule
  ((cublaslt-strided-batch-scaled-product ?product ?A ?B ?batch ?m ?n ?k ?alpha)
   (cublaslt-arithmetic-type (dtype-of ?product) ?zero ?one))
  ((cublaslt-strided-batch-expression ?product ?A ?B (CublasLtNoCMatrix)
     ?batch ?m ?n ?k (CublasLtDefaultEpilogue) ?alpha ?zero))
  :ruleset backend
  :name "cublaslt: complete batched product expression")
(rule
  ((cublaslt-strided-batch-product-with-C-matrix ?expression ?A ?B ?C ?batch ?m ?n ?k ?alpha ?beta))
  ((cublaslt-strided-batch-expression ?expression ?A ?B (CublasLtCMatrixOf ?C)
     ?batch ?m ?n ?k (CublasLtDefaultEpilogue) ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: complete batched accumulation expression")
(rule
  ((cublaslt-strided-batch-expression ?expression ?A ?B ?C ?batch ?m ?n ?k
     (CublasLtDefaultEpilogue) ?alpha ?beta)
   (cublaslt-rectified-linear-activation ?activated ?expression))
  ((cublaslt-strided-batch-expression ?activated ?A ?B ?C ?batch ?m ?n ?k
     (CublasLtRectifiedLinearEpilogue) ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: ReLU after the complete batched expression")
(rule
  ((cublaslt-strided-batch-expression ?expression ?A ?B ?C ?batch ?m ?n ?k
     (CublasLtDefaultEpilogue) ?alpha ?beta))
  ((cublaslt-gaussian-error-linear-input ?expression))
  :ruleset backend
  :name "cublaslt: examine the complete batched expression for GELU")
(rule
  ((cublaslt-strided-batch-expression ?expression ?A ?B ?C ?batch ?m ?n ?k
     (CublasLtDefaultEpilogue) ?alpha ?beta)
   (cublaslt-gaussian-error-linear-activation ?activated ?expression))
  ((cublaslt-strided-batch-expression ?activated ?A ?B ?C ?batch ?m ?n ?k
     (CublasLtGaussianErrorLinearEpilogue) ?alpha ?beta))
  :ruleset backend
  :name "cublaslt: GELU after the complete batched expression")

; Round the complete activated expression before choosing its API frame.
(rule
  ((cublaslt-strided-batch-expression ?expression ?A ?B ?C ?batch ?m ?n ?k ?epilogue ?alpha ?beta)
   (cublaslt-output-storage-reading ?expression ?stored_expression))
  ((cublaslt-strided-batch-expression-frame
     (CublasLtExpressionFrameOf ?stored_expression ?stored_expression ?A ?B ?C
       (CublasLtNoBias) ?epilogue ?alpha ?beta) ?batch ?m ?n ?k))
  :ruleset backend
  :name "cublaslt: direct complete batched expression frame")

; A pure last-two-axis permutation: [batch,r,c] -> [batch,c,r].
; Its inverse restores the original tensor; the batch coordinate stays axis 2.
; Use existing IndexMapApply views, with no new executable transpose operation.
; Recognize the same views introduced by cast commuting, not only demanded
; operands. Otherwise inverse views can grow an unbounded cast/view ladder.
(rule
  ((= ?source_shape (shape-of ?source))
   (= ?source_shape (ShapeLit (IntExprCons ?batch (IntExprCons ?rows (IntExprCons ?columns (IntExprNil))))))
   (= ?transposed_shape (ShapeLit (IntExprCons ?batch (IntExprCons ?columns (IntExprCons ?rows (IntExprNil))))))
   (= ?transposed (LogicalIndexMapApply ?source
     (IndexMapLit (IntExprCons (CoordVar ?transposed_shape 2)
       (IntExprCons (CoordVar ?transposed_shape 0)
         (IntExprCons (CoordVar ?transposed_shape 1) (IntExprNil)))) ?source_shape) ?transposed_shape)))
  ((cublaslt-strided-batch-transpose ?source ?transposed))
  :ruleset backend
  :name "cublaslt: recognize pure batched matrix axis transpose views")
(rule
  ((cublaslt-strided-batch-transpose ?source ?transposed)
   (cublaslt-strided-batch-transpose ?transposed ?restored))
  ((union ?source ?restored))
  :ruleset backend
  :name "cublaslt: cancel inverse batched matrix axis transpose views")
(rule
  ((cublaslt-strided-batch-transpose-demand ?source)
   (= ?source_shape (shape-of ?source))
   (= ?source_shape (ShapeLit (IntExprCons ?batch (IntExprCons ?rows (IntExprCons ?columns (IntExprNil)))))))
  ((let ?transposed_shape (ShapeLit (IntExprCons ?batch (IntExprCons ?columns (IntExprCons ?rows (IntExprNil))))))
   (let ?transposed (LogicalIndexMapApply ?source
     (IndexMapLit (IntExprCons (CoordVar ?transposed_shape 2)
       (IntExprCons (CoordVar ?transposed_shape 0)
         (IntExprCons (CoordVar ?transposed_shape 1) (IntExprNil)))) ?source_shape) ?transposed_shape))
   (cublaslt-strided-batch-transpose ?source ?transposed)
   (cublaslt-strided-batch-transpose ?transposed ?source))
  :ruleset backend
  :name "cublaslt: construct a demanded batched matrix axis transpose")
(rule
  ((cublaslt-strided-batch-expression ?expression ?A ?B ?C ?batch ?m ?n ?k ?epilogue ?alpha ?beta)
   (cublaslt-strided-batch-activation-epilogue ?epilogue)
   (cublaslt-output-storage-reading ?expression ?stored_expression)
   (cublaslt-strided-batch-transpose ?stored_expression ?api_expression)
   (= ?source_shape (shape-of ?stored_expression))
   (= ?transposed_shape (shape-of ?api_expression)))
  ((union ?stored_expression (LogicalIndexMapApply ?api_expression
     (IndexMapLit (IntExprCons (CoordVar ?source_shape 2)
       (IntExprCons (CoordVar ?source_shape 0)
         (IntExprCons (CoordVar ?source_shape 1) (IntExprNil)))) ?transposed_shape) ?source_shape)))
  :ruleset backend
  :name "cublaslt: restore the complete activated batch through its inverse view")
(rule
  ((cublaslt-strided-batch-expression ?expression ?A ?B ?C ?batch ?m ?n ?k ?epilogue ?alpha ?beta)
   (cublaslt-strided-batch-activation-epilogue ?epilogue)
   (cublaslt-output-storage-reading ?expression ?stored_expression))
  ((cublaslt-strided-batch-transpose-demand ?stored_expression)
   (cublaslt-strided-batch-transpose-demand ?A)
   (cublaslt-strided-batch-transpose-demand ?B))
  :ruleset backend
  :name "cublaslt: demand a whole activated batch transpose frame")
(rule
  ((cublaslt-strided-batch-expression ?expression ?A ?B (CublasLtCMatrixOf ?C)
     ?batch ?m ?n ?k ?epilogue ?alpha ?beta)
   (cublaslt-strided-batch-activation-epilogue ?epilogue))
  ((cublaslt-strided-batch-transpose-demand ?C))
  :ruleset backend
  :name "cublaslt: demand C in the activated batch transpose frame")
(rule
  ((cublaslt-strided-batch-expression ?expression ?A ?B (CublasLtNoCMatrix)
     ?batch ?m ?n ?k ?epilogue ?alpha ?beta)
   (cublaslt-strided-batch-activation-epilogue ?epilogue)
   (cublaslt-output-storage-reading ?expression ?stored_expression)
   (cublaslt-strided-batch-transpose ?stored_expression ?api_expression)
   (cublaslt-strided-batch-transpose ?A ?AT)
   (cublaslt-strided-batch-transpose ?B ?BT))
  ((cublaslt-strided-batch-expression-frame
     (CublasLtExpressionFrameOf ?stored_expression ?api_expression ?BT ?AT (CublasLtNoCMatrix)
       (CublasLtNoBias) ?epilogue ?alpha ?beta) ?batch ?n ?m ?k))
  :ruleset backend
  :name "cublaslt: transpose the complete activated batch without C")
(rule
  ((cublaslt-strided-batch-expression ?expression ?A ?B (CublasLtCMatrixOf ?C)
     ?batch ?m ?n ?k ?epilogue ?alpha ?beta)
   (cublaslt-strided-batch-activation-epilogue ?epilogue)
   (cublaslt-output-storage-reading ?expression ?stored_expression)
   (cublaslt-strided-batch-transpose ?stored_expression ?api_expression)
   (cublaslt-strided-batch-transpose ?A ?AT)
   (cublaslt-strided-batch-transpose ?B ?BT)
   (cublaslt-strided-batch-transpose ?C ?CT))
  ((cublaslt-strided-batch-expression-frame
     (CublasLtExpressionFrameOf ?stored_expression ?api_expression ?BT ?AT (CublasLtCMatrixOf ?CT)
       (CublasLtNoBias) ?epilogue ?alpha ?beta) ?batch ?n ?m ?k))
  :ruleset backend
  :name "cublaslt: transpose the complete activated batch with C")

(rule
  ((cublaslt-strided-batch-expression-frame
     (CublasLtExpressionFrameOf ?original ?api_expression ?A ?B ?C (CublasLtNoBias) ?epilogue ?alpha ?beta)
     ?batch ?m ?n ?k))
  ((cublaslt-strided-batch-layout-demand ?api_expression))
  :ruleset backend
  :name "cublaslt: demand the complete batch frame destination")
(rule
  ((cublaslt-strided-batch-expression-frame
     (CublasLtExpressionFrameOf ?original ?api_expression ?A ?B (CublasLtCMatrixOf ?C)
       (CublasLtNoBias) ?epilogue ?alpha ?beta) ?batch ?m ?n ?k)
   (cublaslt-exact-storage-reading (dtype-of ?A) ?C ?C_storage))
  ((cublaslt-strided-batch-layout-demand ?C_storage))
  :ruleset backend
  :name "cublaslt: demand C storage in the complete batch frame")
(rule
  ((cublaslt-strided-batch-expression-frame
     (CublasLtExpressionFrameOf ?original ?api_expression ?A ?B ?C (CublasLtNoBias) ?epilogue ?alpha ?beta)
     ?batch ?m ?n ?k)
   (cublaslt-operand-storage-reading ?computation ?A ?A_storage))
  ((cublaslt-strided-batch-layout-demand ?A_storage))
  :ruleset backend
  :name "cublaslt: demand A storage in the complete batch frame")
(rule
  ((cublaslt-strided-batch-expression-frame
     (CublasLtExpressionFrameOf ?original ?api_expression ?A ?B ?C (CublasLtNoBias) ?epilogue ?alpha ?beta)
     ?batch ?m ?n ?k)
   (cublaslt-operand-storage-reading ?computation ?B ?B_storage))
  ((cublaslt-strided-batch-layout-demand ?B_storage))
  :ruleset backend
  :name "cublaslt: demand B storage in the complete batch frame")

; Consume whole shape-owned ElementStride certificates, including the batch
; axis. No axes are flattened. The count must fit the vendor's int32 field.
(rule
  ((cublaslt-strided-batch-layout-demand ?logical_tensor)
   (= ?layout_tensor (LayoutTensorLit ?logical_tensor ?layout))
   (= (shape-of ?logical_tensor)
     (ShapeLit (IntExprCons ?BatchCount (IntExprCons ?rows (IntExprCons ?columns (IntExprNil))))))
   (= ?storage_data_type (dtype-of ?logical_tensor))
   (cublaslt-positive-extent ?BatchCount)
   (<= (upper-bound-of ?BatchCount) (bigint 2147483647))
   (cublaslt-positive-extent ?rows)
   (cublaslt-positive-extent ?columns)
   (cublaslt-element-stride-reading ?layout_tensor 2 ?batch_stride)
   (cublaslt-element-stride-reading ?layout_tensor 1 ?row_stride)
   (cublaslt-element-stride-reading ?layout_tensor 0 ?column_stride))
  ((cublaslt-strided-batch-geometry ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type ?batch_stride ?row_stride ?column_stride))
  :ruleset backend
  :name "cublaslt: shape owned rank three batch geometry")
(rule
  ((cublaslt-batch-stride-demand (ElementStrideExact ?BatchStrideInElements) ?matrix_padded_span))
  ((cublaslt-greater-than-or-equal-demand ?BatchStrideInElements ?matrix_padded_span))
  :ruleset backend
  :name "cublaslt: demand disjoint padded matrix batches")
(rule
  ((cublaslt-batch-stride-demand (ElementStrideExact ?BatchStrideInElements) ?matrix_padded_span)
   (cublaslt-greater-than-or-equal ?BatchStrideInElements ?matrix_padded_span))
  ((cublaslt-legal-batch-stride (ElementStrideExact ?BatchStrideInElements)
     ?matrix_padded_span ?BatchStrideInElements))
  :ruleset backend
  :name "cublaslt: proven positive batch pitch")
(rule
  ((cublaslt-batch-stride-demand (ElementStrideAny) ?matrix_padded_span))
  ((cublaslt-legal-batch-stride (ElementStrideAny) ?matrix_padded_span ?matrix_padded_span))
  :ruleset backend
  :name "cublaslt: choose canonical pitch for a singleton batch")
(rule
  ((cublaslt-strided-batch-geometry ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type ?batch_stride ?row_stride ?column_stride)
   (cublaslt-unit-element-stride ?column_stride))
  ((cublaslt-leading-dimension-demand ?row_stride ?columns))
  :ruleset backend
  :name "cublaslt: batched row leading dimension")
(rule
  ((cublaslt-strided-batch-geometry ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type ?batch_stride ?row_stride ?column_stride)
   (cublaslt-unit-element-stride ?column_stride)
   (cublaslt-legal-leading-dimension ?row_stride ?columns ?LeadingDimension))
  ((cublaslt-batch-stride-demand ?batch_stride (IntMul ?rows ?LeadingDimension)))
  :ruleset backend
  :name "cublaslt: batched row padded matrix footprint")
(rule
  ((cublaslt-strided-batch-geometry ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type ?batch_stride ?row_stride ?column_stride)
   (cublaslt-unit-element-stride ?column_stride)
   (cublaslt-legal-leading-dimension ?row_stride ?columns ?LeadingDimension)
   (cublaslt-legal-batch-stride ?batch_stride (IntMul ?rows ?LeadingDimension) ?BatchStrideInElements))
  ((cublaslt-strided-batch-matrix-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type (CublasLtRowMajor) (CublasLtNoTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?storage_data_type (CublasLtRowMajor) ?rows ?columns
         ?LeadingDimension ?BatchCount ?BatchStrideInElements)))
   (cublaslt-strided-batch-matrix-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type (CublasLtColumnMajor) (CublasLtTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?storage_data_type (CublasLtColumnMajor) ?columns ?rows
         ?LeadingDimension ?BatchCount ?BatchStrideInElements))))
  :ruleset backend
  :name "cublaslt: batched row matrix readings")
(rule
  ((cublaslt-strided-batch-geometry ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type ?batch_stride ?row_stride ?column_stride)
   (cublaslt-unit-element-stride ?row_stride))
  ((cublaslt-leading-dimension-demand ?column_stride ?rows))
  :ruleset backend
  :name "cublaslt: batched column leading dimension")
(rule
  ((cublaslt-strided-batch-geometry ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type ?batch_stride ?row_stride ?column_stride)
   (cublaslt-unit-element-stride ?row_stride)
   (cublaslt-legal-leading-dimension ?column_stride ?rows ?LeadingDimension))
  ((cublaslt-batch-stride-demand ?batch_stride (IntMul ?columns ?LeadingDimension)))
  :ruleset backend
  :name "cublaslt: batched column padded matrix footprint")
(rule
  ((cublaslt-strided-batch-geometry ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type ?batch_stride ?row_stride ?column_stride)
   (cublaslt-unit-element-stride ?row_stride)
   (cublaslt-legal-leading-dimension ?column_stride ?rows ?LeadingDimension)
   (cublaslt-legal-batch-stride ?batch_stride (IntMul ?columns ?LeadingDimension) ?BatchStrideInElements))
  ((cublaslt-strided-batch-matrix-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type (CublasLtColumnMajor) (CublasLtNoTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?storage_data_type (CublasLtColumnMajor) ?rows ?columns
         ?LeadingDimension ?BatchCount ?BatchStrideInElements)))
   (cublaslt-strided-batch-matrix-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type (CublasLtRowMajor) (CublasLtTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?storage_data_type (CublasLtRowMajor) ?columns ?rows
         ?LeadingDimension ?BatchCount ?BatchStrideInElements))))
  :ruleset backend
  :name "cublaslt: batched column matrix readings")
(rule
  ((cublaslt-strided-batch-matrix-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type ?matrix_order (CublasLtNoTranspose) ?matrix_descriptor))
  ((cublaslt-strided-batch-destination-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type ?matrix_order ?matrix_descriptor))
  :ruleset backend
  :name "cublaslt: disjoint strided batch destination")

; A and B may independently reuse one physical matrix across the logical
; batch axis. Keep this permission out of matrix-reading: C and D still require
; disjoint batches, and a shared read must never authorize overlapping writes.
(rule
  ((cublaslt-strided-batch-matrix-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type ?matrix_order ?operation ?matrix_descriptor))
  ((cublaslt-strided-batch-operand-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type ?matrix_order ?operation ?matrix_descriptor))
  :ruleset backend
  :name "cublaslt: disjoint batches are valid A and B operands")
(rule
  ((cublaslt-strided-batch-geometry ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type (ElementStrideExact (IntLit 0)) ?row_stride ?column_stride)
   (cublaslt-unit-element-stride ?column_stride)
   (cublaslt-legal-leading-dimension ?row_stride ?columns ?LeadingDimension))
  ((cublaslt-strided-batch-operand-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type (CublasLtRowMajor) (CublasLtNoTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?storage_data_type (CublasLtRowMajor) ?rows ?columns
         ?LeadingDimension ?BatchCount (IntLit 0))))
   (cublaslt-strided-batch-operand-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type (CublasLtColumnMajor) (CublasLtTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?storage_data_type (CublasLtColumnMajor) ?columns ?rows
         ?LeadingDimension ?BatchCount (IntLit 0)))))
  :ruleset backend
  :name "cublaslt: shared row matrix is an A or B operand")
(rule
  ((cublaslt-strided-batch-geometry ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type (ElementStrideExact (IntLit 0)) ?row_stride ?column_stride)
   (cublaslt-unit-element-stride ?row_stride)
   (cublaslt-legal-leading-dimension ?column_stride ?rows ?LeadingDimension))
  ((cublaslt-strided-batch-operand-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type (CublasLtColumnMajor) (CublasLtNoTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?storage_data_type (CublasLtColumnMajor) ?rows ?columns
         ?LeadingDimension ?BatchCount (IntLit 0))))
   (cublaslt-strided-batch-operand-reading ?layout_tensor ?BatchCount ?rows ?columns
     ?storage_data_type (CublasLtRowMajor) (CublasLtTranspose)
     (CublasLtMatrixDescriptorOf ?layout_tensor
       (CublasLtMatrixLayoutLit ?storage_data_type (CublasLtRowMajor) ?columns ?rows
         ?LeadingDimension ?BatchCount (IntLit 0)))))
  :ruleset backend
  :name "cublaslt: shared column matrix is an A or B operand")

; The batch geometry is part of the three descriptors. Computation, scalar,
; storage, order and transpose policy still require the complete whitelist row.
; Both gates consume a complete frame, including activation and final rounding.
(rule
  ((cublaslt-strided-batch-expression-frame ?expression_frame ?BatchCount ?m ?n ?k)
   (= ?expression_frame (CublasLtExpressionFrameOf ?original_expression ?output_expression
     ?A_operand ?B_operand (CublasLtNoCMatrix) (CublasLtNoBias) ?epilogue ?alpha ?zero))
   (cublaslt-operand-storage-reading ?computation_type ?A_operand ?A_storage_tensor)
   (cublaslt-operand-storage-reading ?computation_type ?B_operand ?B_storage_tensor)
   (= (shape-of ?A_operand) (shape-of ?A_storage_tensor))
   (= (shape-of ?B_operand) (shape-of ?B_storage_tensor))
   (= ?A_layout_tensor (LayoutTensorLit ?A_storage_tensor ?A_layout))
   (= ?B_layout_tensor (LayoutTensorLit ?B_storage_tensor ?B_layout))
   (= ?D_storage_data_type (dtype-of ?output_expression))
   (= ?D_layout_tensor (LayoutTensorLit ?output_expression ?D_layout))
   (cublaslt-strided-batch-operand-reading ?A_layout_tensor ?BatchCount ?m ?k ?A_storage_data_type
     ?A_matrix_order ?A_transpose_operation ?A_matrix_descriptor)
   (cublaslt-strided-batch-operand-reading ?B_layout_tensor ?BatchCount ?k ?n ?B_storage_data_type
     ?B_matrix_order ?B_transpose_operation ?B_matrix_descriptor)
   (cublaslt-strided-batch-destination-reading ?D_layout_tensor ?BatchCount ?m ?n ?D_storage_data_type
     ?D_matrix_order ?D_matrix_descriptor)
   (= ?scalar_data_type (dtype-of ?A_operand))
   (= ?configuration (CublasLtConfigurationOf ?computation_type ?scalar_data_type
     ?A_storage_data_type ?B_storage_data_type (CublasLtNoCMatrixDataType) ?D_storage_data_type
     (CublasLtNoBiasDataType) ?scalar_pointer_mode ?epilogue
     ?A_matrix_order ?B_matrix_order ?D_matrix_order ?A_transpose_operation ?B_transpose_operation ?reduction_scheme_mask))
   (cublaslt-approved-configuration ?configuration)
   (cublaslt-arithmetic-type ?scalar_data_type ?zero ?one)
   (cublaslt-scalar-arguments ?alpha ?zero ?scalar_data_type ?scalar_pointer_mode ?scalar_arguments ?scalar_inputs))
  ((cublaslt-approved-call ?configuration ?A_matrix_descriptor ?B_matrix_descriptor
     (CublasLtCMatrixAbsent) (CublasLtBiasAbsent) ?D_matrix_descriptor

     ?expression_frame ?scalar_arguments))
  :ruleset backend
  :name "cublaslt: approve complete strided batch product configuration")

; C and D have the same shape, type, order and count, but independent pitches.
; Both executable forms consume this proof. The existing in-place emission
; additionally requires identical complete C/D descriptions and layouts.
(rule
  ((cublaslt-strided-batch-expression-frame ?expression_frame ?BatchCount ?m ?n ?k)
   (= ?expression_frame (CublasLtExpressionFrameOf ?original_expression ?output_expression
     ?A_operand ?B_operand (CublasLtCMatrixOf ?C_matrix) (CublasLtNoBias) ?epilogue ?alpha ?beta))
   (cublaslt-operand-storage-reading ?computation_type ?A_operand ?A_storage_tensor)
   (cublaslt-operand-storage-reading ?computation_type ?B_operand ?B_storage_tensor)
   (= (shape-of ?A_operand) (shape-of ?A_storage_tensor))
   (= (shape-of ?B_operand) (shape-of ?B_storage_tensor))
   (= ?A_layout_tensor (LayoutTensorLit ?A_storage_tensor ?A_layout))
   (= ?B_layout_tensor (LayoutTensorLit ?B_storage_tensor ?B_layout))
   (cublaslt-exact-storage-reading (dtype-of ?A_operand) ?C_matrix ?C_storage_tensor)
   (= (shape-of ?C_matrix) (shape-of ?C_storage_tensor))
   (= ?C_layout_tensor (LayoutTensorLit ?C_storage_tensor ?C_layout))
   (= ?D_storage_data_type (dtype-of ?output_expression))
   (= ?D_layout_tensor (LayoutTensorLit ?output_expression ?D_layout))
   (cublaslt-strided-batch-operand-reading ?A_layout_tensor ?BatchCount ?m ?k ?A_storage_data_type
     ?A_matrix_order ?A_transpose_operation ?A_matrix_descriptor)
   (cublaslt-strided-batch-operand-reading ?B_layout_tensor ?BatchCount ?k ?n ?B_storage_data_type
     ?B_matrix_order ?B_transpose_operation ?B_matrix_descriptor)
   (cublaslt-strided-batch-matrix-reading ?C_layout_tensor ?BatchCount ?m ?n ?D_storage_data_type
     ?D_matrix_order (CublasLtNoTranspose) ?C_matrix_descriptor)
   (cublaslt-strided-batch-destination-reading ?D_layout_tensor ?BatchCount ?m ?n ?D_storage_data_type
     ?D_matrix_order ?D_matrix_descriptor)
   (= ?scalar_data_type (dtype-of ?A_operand))
   (= ?configuration (CublasLtConfigurationOf ?computation_type ?scalar_data_type
     ?A_storage_data_type ?B_storage_data_type (CublasLtCMatrixDataTypeOf ?D_storage_data_type) ?D_storage_data_type
     (CublasLtNoBiasDataType) ?scalar_pointer_mode ?epilogue
     ?A_matrix_order ?B_matrix_order ?D_matrix_order ?A_transpose_operation ?B_transpose_operation ?reduction_scheme_mask))
   (cublaslt-approved-configuration ?configuration)
   (cublaslt-scalar-arguments ?alpha ?beta ?scalar_data_type ?scalar_pointer_mode ?scalar_arguments ?scalar_inputs))
  ((cublaslt-approved-call ?configuration ?A_matrix_descriptor ?B_matrix_descriptor
     (CublasLtCMatrixInput ?C_matrix_descriptor) (CublasLtBiasAbsent) ?D_matrix_descriptor

     ?expression_frame ?scalar_arguments))
  :ruleset backend
  :name "cublaslt: approve complete strided batch C addition configuration")
