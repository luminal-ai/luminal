; Paged gpt-oss sink attention (GQA + sink-augmented softmax) -> FA3 host op.
;
; Masking is hybrid: causal + cross-sequence isolation is a host mask Input,
; matched as a PROOF-ONLY anchor; the sliding window is in-graph
; (k_pos vs q_abs-(W-1)), so sliding-vs-full is structurally proven AND the
; layer bodies differ, driving the period-2 loop roll that keeps per-slot
; masks loop-invariant — this rule matches inside rolled bodies. (The roll
; needs >= 6 layers; shallower tests see different rolling regimes.)
; qo/kv_indptr are free-floating named Inputs (size-1 joins) wired through
; as runtime inputs.
;
; Staging: scaled host-mask base -> requested window term -> window constant ->
; sa_masked -> sa_island -> op. Depends on flashinfer_attention.egg's
; const_like / flashinfer_head_dim_ok_16bit facts.

; (masked, scores, scale_val, window_left): the masked-scores node, the raw
; scores it was built from, the softmax scale constant, and the window
; (-1.0 = full attention).
(relation sa_masked (IR IR f64 f64))

; Consumer-demanded staging for the mask prefix.  A scaled host-mask base is
; cheap to discover.  The longer sliding-window proof is only explored for a
; term which is the second operand of an Add on one of those bases.
(relation sa_scaled_mask_base (IR IR f64))
(relation sa_sliding_mask_request (IR IR f64 IR))
(relation sa_window_past (IR IR))
; Normalized BF16 query boundary. This accepts both the legacy
; Cast(BF16)(RoPE-F32) spelling and a RoPE kernel which rounds directly at its
; BF16 store; both feed the same explicit F32 reference attention proof.
(relation sa_q_bf (IR IR))

(rule
    (
        (= (Bf16) (dtype ?q_bf))
        (= ?q_f (Op (Cast ?qf_sz (F32)) (ICons ?q_bf (INil))))
    )
    (
        (sa_q_bf ?q_f ?q_bf)
    )
    :ruleset kernel_fuse_late_pre_sink_attention_base
    :name "SinkAttention BF16 query boundary"
)

; Full attention: masked = scaled_scores + host_mask.
(rule
    (
        (= ?base (Op (Add ?m_s ?m_a ?m_b ?m_o)
            (ICons ?scaled (ICons ?mask (INil)))))
        (= ?scaled (Op (Mul ?sc_s ?sc_a ?sc_b ?sc_o)
            (ICons ?scores (ICons ?scale_c (INil)))))
        (const_like ?scale_c ?scale_val)
        (= ?mask (Input ?mask_idx ?mask_name (F32)))
    )
    (
        (sa_scaled_mask_base ?base ?scores ?scale_val)
        (sa_masked ?base ?scores ?scale_val -1.0)
    )
    :ruleset kernel_fuse_late_pre_sink_attention_base
    :name "SinkAttention scaled host-mask base"
)

; Only a base which is actually extended by another Add can demand the
; sliding-window proof for that Add's second operand.
(rule
    (
        (= ?masked (Op (Add ?o_s ?o_a ?o_b ?o_o)
            (ICons ?base (ICons ?wterm (INil)))))
        (sa_scaled_mask_base ?base ?scores ?scale_val)
    )
    (
        (sa_sliding_mask_request ?masked ?scores ?scale_val ?wterm)
    )
    :ruleset kernel_fuse_late_pre_sink_attention_request
    :name "request SinkAttention sliding-window proof"
)

; Prove the requested term through the negative-large mask and comparison,
; carrying the exact window-start node into the final constant proof.
(rule
    (
        (sa_sliding_mask_request ?masked ?scores ?scale_val ?wterm)
        (= ?wterm (Op (Mul ?w_s ?w_a ?w_b ?w_o)
            (ICons ?past_f (ICons ?negbig (INil)))))
        (const_like ?negbig ?negbig_val)
        (< ?negbig_val -900000000000000000000000000000.0)
        (= ?past_f (Op (Cast ?pc_sz (F32)) (ICons ?past (INil))))
        (= ?past (Op (LessThan ?lt_s ?lt_a ?lt_b ?lt_o)
            (ICons ?k_posf (ICons ?wstart (INil)))))
    )
    (
        (sa_window_past ?wterm ?wstart)
    )
    :ruleset kernel_fuse_late_pre_sink_attention_past
    :name "prove requested SinkAttention past-window term"
)

; Sliding window: masked = (scaled_scores + host_mask) + window_term, where
; window_term = Cast(LessThan(k_pos, q_abs - W1)) * -1e30 and W1 is the
; in-graph window constant (gpt-oss: 127 = SLIDING_WINDOW - 1, exactly
; FlashInfer's window_left convention).
(rule
    (
        (sa_sliding_mask_request ?masked ?scores ?scale_val ?wterm)
        (sa_window_past ?wterm ?wstart)
        (= ?wstart (Op (Add ?ws_s ?ws_a ?ws_b ?ws_o)
            (ICons ?q_absf (ICons ?negw (INil)))))
        (= ?negw (Op (Mul ?nw_s ?nw_a ?nw_b ?nw_o)
            (ICons ?wconst (ICons ?negone1 (INil)))))
        (const_like ?wconst ?window_val)
        (const_like ?negone1 -1.000000)
    )
    (
        (sa_masked ?masked ?scores ?scale_val ?window_val)
    )
    :ruleset kernel_fuse_late_pre_sink_attention_finish
    :name "prove requested SinkAttention sliding-window mask"
)

; (out, q_bf16, k_pool, v_pool, flat_gather_idx, sinks_f32,
;  nheads, kvdim, hdim, scale, window_left)
(relation sa_island (IR IR IR IR IR IR Expression Expression Expression Expression f64 f64))

(rule
    (
        ; ── K/V pool scatters sharing one flat scatter index ──
        (= ?k_pool (Op (Scatter ?ksd ?ksdst ?ksis ?ksistr ?ksss)
            (ICons ?k_dest (ICons ?scat_idx (ICons ?k_src (INil))))))
        (= ?v_pool (Op (Scatter ?vsd ?vsdst ?vsis ?vsistr ?vsss)
            (ICons ?v_dest (ICons ?scat_idx (ICons ?v_src (INil))))))

        ; ── Context gathers from both pools via ONE flat gather index ──
        (= ?k_gathered (Op (Gather
            (ECons ?context_tokens (ECons ?kvdim (ENil)))
            ?kg_a
            (ECons ?nslots (ECons ?kvdim2 (ENil)))
            ?kg_b)
            (ICons ?flat_gidx (ICons ?k_pool (INil)))))
        (= ?k_ctx (Op (Cast ?kc_sz (F32)) (ICons ?k_gathered (INil))))
        (= ?v_gathered (Op (Gather
            (ECons ?context_tokens (ECons ?kvdim3 (ENil)))
            ?vg_a
            (ECons ?nslots2 (ECons ?kvdim4 (ENil)))
            ?vg_b)
            (ICons ?flat_gidx (ICons ?v_pool (INil)))))
        (= ?v_ctx (Op (Cast ?vc_sz (F32)) (ICons ?v_gathered (INil))))

        ; ── Q: the bf16 island operand, cast back up for the F32 chain ──
        (sa_q_bf ?q_f ?q_bf)

        ; ── Q·K^T: (nheads, s, c, hd) mul + reduce over hd ──
        (= ?qk (Op (Mul
            (ECons ?nheads (ECons ?input_tokens (ECons ?context_tokens (ECons ?hdim (ENil)))))
            ?qk_a ?qk_b ?qk_o)
            (ICons ?q_f (ICons ?k_ctx (INil)))))
        (= ?scores (Op (Sum ?ss_shape ?hdim ?ss_in ?ss_iter ?ss_out)
            (ICons ?qk (INil))))
        (flashinfer_head_dim_ok_16bit ?hdim)

        ; ── Masked scores: staged fact (full or sliding-window shape) ──
        (sa_masked ?masked ?scores ?scale_val ?window_val)

        ; ── Row max, then max(row_max, sink) in the lt-select spelling ──
        (= ?rmax (Op (Max ?rm_shape ?context_tokens ?rm_in ?rm_iter ?rm_out)
            (ICons ?masked (INil))))
        ; The sink operand is semantically F32. It may be an explicit cast of
        ; a low-precision graph weight or an F32 input promoted once by the
        ; weight loader; the downstream arithmetic is identical.
        (= (F32) (dtype ?sinks_f))
        (= ?lt (Op (LessThan ?lt_s ?lt_a ?lt_b ?lt_o)
            (ICons ?rmax (ICons ?sinks_f (INil)))))
        (= ?lt_f (Op (Cast ?ltf_sz (F32)) (ICons ?lt (INil))))
        (= ?sink_part (Op (Mul ?sp_s ?sp_a ?sp_b ?sp_o)
            (ICons ?lt_f (ICons ?sinks_f (INil)))))
        (= ?lt_neg (Op (Mul ?ln_s ?ln_a ?ln_b ?ln_o)
            (ICons ?lt_f (ICons ?neg1a (INil)))))
        (const_like ?neg1a -1.000000)
        (= ?one_m (Op (Add ?om_s ?om_a ?om_b ?om_o)
            (ICons ?lt_neg (ICons ?one_c (INil)))))
        (const_like ?one_c 1.000000)
        (= ?om_bool (Op (Cast ?omb_sz (Bool)) (ICons ?one_m (INil))))
        (= ?om_f (Op (Cast ?omf_sz (F32)) (ICons ?om_bool (INil))))
        (= ?max_part (Op (Mul ?mp_s ?mp_a ?mp_b ?mp_o)
            (ICons ?om_f (ICons ?rmax (INil)))))
        (= ?newmax (Op (Add ?nm_s ?nm_a ?nm_b ?nm_o)
            (ICons ?sink_part (ICons ?max_part (INil)))))

        ; ── exp2((masked - newmax) · log2e) and its row sum ──
        (= ?nm_negc (Op (Mul ?nn_s ?nn_a ?nn_b ?nn_o)
            (ICons ?newmax (ICons ?neg1b (INil)))))
        (const_like ?neg1b -1.000000)
        (= ?shifted (Op (Add ?sh_s ?sh_a ?sh_b ?sh_o)
            (ICons ?masked (ICons ?nm_negc (INil)))))
        (= ?sc2 (Op (Mul ?s2_s ?s2_a ?s2_b ?s2_o)
            (ICons ?shifted (ICons ?log2e_a (INil)))))
        (const_like ?log2e_a 1.442695)
        (= ?num (Op (Exp2 ?ex_s ?ex_in ?ex_out) (ICons ?sc2 (INil))))
        (= ?numsum (Op (Sum ?ns_shape ?context_tokens ?ns_in ?ns_iter ?ns_out)
            (ICons ?num (INil))))

        ; ── The sink joins the DENOMINATOR only ──
        (= ?nm_negs (Op (Mul ?ng_s ?ng_a ?ng_b ?ng_o)
            (ICons ?newmax (ICons ?neg1c (INil)))))
        (const_like ?neg1c -1.000000)
        (= ?sink_sh (Op (Add ?ks_s ?ks_a ?ks_b ?ks_o)
            (ICons ?sinks_f (ICons ?nm_negs (INil)))))
        (= ?sink_sc (Op (Mul ?kc_s ?kc_a ?kc_b ?kc_o)
            (ICons ?sink_sh (ICons ?log2e_b (INil)))))
        (const_like ?log2e_b 1.442695)
        (= ?sink_exp (Op (Exp2 ?se_s ?se_in ?se_out) (ICons ?sink_sc (INil))))
        (= ?denom (Op (Add ?d_s ?d_a ?d_b ?d_o)
            (ICons ?numsum (ICons ?sink_exp (INil)))))
        (= ?rdenom (Op (Recip ?r_s ?r_in ?r_out) (ICons ?denom (INil))))
        (= ?probs (Op (Mul ?p_s ?p_a ?p_b ?p_o)
            (ICons ?num (ICons ?rdenom (INil)))))

        ; ── P·V: (nheads, s, hd, c) mul + reduce over c → output point ──
        (= ?pv (Op (Mul
            (ECons ?nheads2 (ECons ?input_tokens (ECons ?hdim2 (ECons ?context_tokens (ENil)))))
            ?pv_a ?pv_b ?pv_o)
            (ICons ?probs (ICons ?v_ctx (INil)))))
        (= ?out (Op (Sum ?o_shape ?context_tokens ?o_in ?o_iter ?o_out)
            (ICons ?pv (INil))))
    )
    (
        (sa_island ?out ?q_bf ?k_pool ?v_pool ?flat_gidx ?sinks_f
            ?nheads ?kvdim ?hdim ?input_tokens ?scale_val ?window_val)
    )
    :ruleset kernel_fuse_late
    :name "SinkAttention island fact"
)

; ── Op rule: window_left proven from the graph (sa_masked) ──

(rule
    (
        (sa_island ?out ?q ?kp ?vp ?g ?s ?nheads ?kvdim ?hdim ?input_tokens ?scale_val ?window_val)
        (= ?out (Op (Sum ?force_o_shape ?force_context ?force_o_in ?force_o_iter ?force_o_out)
            (ICons ?force_pv (INil))))
        (= ?qoi (Input ?qo_idx "qo_indptr" (Int)))
        (= ?kvi (Input ?kv_idx "kv_indptr" (Int)))
    )
    (
        (let ?fi (Op (SinkAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim ?input_tokens ?scale_val ?window_val (F32) 0.0)
            (ICons ?q (ICons ?kp (ICons ?vp (ICons ?g
                (ICons ?qoi (ICons ?kvi (ICons ?s (INil))))))))))
        (union ?out ?fi)
        (set (dtype ?fi) (F32))
        ; This exact dense attention chain scales its intermediate as
        ; heads*s*context and is not a serving-safe fallback once the
        ; FlashInfer island has been proven. Removing its matched root also
        ; keeps random search genomes from choosing a short-context winner
        ; that violates the memory cap later in the same dynamic bucket.
        (delete (Op (Sum ?force_o_shape ?force_context ?force_o_in ?force_o_iter ?force_o_out)
            (ICons ?force_pv (INil))))
    )
    :ruleset kernel_fuse_late2_sink_attention
    :name "SinkAttention op"
)

; When the immediate graph consumer rounds the reference F32 attention
; result to BF16, expose FA3's already-rounded native BF16 output directly.
; This preserves the exact numerical boundary while removing the native
; BF16 -> F32 -> BF16 storage round trip. At decode s=1 the layouts are also
; byte-identical, allowing the host op to write straight to the graph buffer.
(rule
    (
        (sa_island ?out ?q ?kp ?vp ?g ?s ?nheads ?kvdim ?hdim ?input_tokens ?scale_val ?window_val)
        (= ?cast (Op (Cast ?cast_size (Bf16)) (ICons ?out (INil))))
        (= ?qoi (Input ?qo_idx "qo_indptr" (Int)))
        (= ?kvi (Input ?kv_idx "kv_indptr" (Int)))
    )
    (
        (let ?fi (Op (SinkAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim ?input_tokens ?scale_val ?window_val (Bf16) 0.0)
            (ICons ?q (ICons ?kp (ICons ?vp (ICons ?g
                (ICons ?qoi (ICons ?kvi (ICons ?s (INil))))))))))
        (union ?cast ?fi)
        (set (dtype ?fi) (Bf16))
        ; The F32 SinkAttention spelling would only upcast the same rounded
        ; FA3 BF16 bytes before this exact cast rounds them back. Once this
        ; consumer is proven, retain only the direct native-storage spelling
        ; so extraction cannot reintroduce the redundant two-kernel path.
        (delete (Op (Cast ?cast_size (Bf16)) (ICons ?out (INil))))
    )
    :ruleset kernel_fuse_late2_sink_attention
    :name "SinkAttention native BF16 consumer"
)

; The model spells a non-affine transpose/merge materialization as
; Gather(Iota, data). When that exact token-major value is immediately
; rounded to BF16 for a tensor-core consumer, FA3's native output already has
; both the requested byte order and storage dtype. Expose it directly rather
; than launching heads->tokens Gather plus Cast after every attention layer.
;
; The index tensor is flat because the materialization gathers an iota of the
; total element count, while the data tracker retains the logical
; `(s, heads * dim)` view. Reusing those factors in the index product proves
; this is a full layout-only materialization, not arbitrary attention indexing.
(rule
    (
        (sa_island ?out ?q ?kp ?vp ?g ?s ?nheads ?kvdim ?hdim ?input_tokens ?scale_val ?window_val)
        (= ?materialized (Op (Gather
            (ECons (MMul ?input_tokens ?q_width) (ENil)) ?index_strides
            (ECons ?input_tokens (ECons ?q_width (ENil))) ?data_strides)
            (ICons ?iota (ICons ?out (INil)))))
        (= ?iota (Op (Iota ?iota_expr ?iota_range) (INil)))
        (= ?cast (Op (Cast ?cast_size (Bf16)) (ICons ?materialized (INil))))
        (= ?qoi (Input ?qo_idx "qo_indptr" (Int)))
        (= ?kvi (Input ?kv_idx "kv_indptr" (Int)))
    )
    (
        (let ?fi (Op (SinkAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim ?input_tokens ?scale_val ?window_val (Bf16) 1.0)
            (ICons ?q (ICons ?kp (ICons ?vp (ICons ?g
                (ICons ?qoi (ICons ?kvi (ICons ?s (INil))))))))))
        (union ?cast ?fi)
        (set (dtype ?fi) (Bf16))
        (delete (Op (Cast ?cast_size (Bf16)) (ICons ?materialized (INil))))
    )
    :ruleset kernel_fuse_late2_sink_attention
    :name "SinkAttention token-major BF16 consumer"
)

; The gather's tracker metadata is allowed to retain the pre-materialization
; heads-major view. In that spelling its data shape is not necessarily the
; canonical `(tokens, heads*dim)` pair above, even though a full flat Iota
; still proves the same row-major materialization. Match that invariant
; directly: equal Iota range and Cast size prove that every logical attention
; element is gathered exactly once, in order. This is a model-independent
; contiguous-view boundary, not an arbitrary attention gather.
(rule
    (
        (sa_island ?out ?q ?kp ?vp ?g ?s ?nheads ?kvdim ?hdim ?input_tokens ?scale_val ?window_val)
        (= ?materialized (Op (Gather
            ?gather_out_shape ?index_strides ?gather_data_shape ?data_strides)
            (ICons ?iota (ICons ?out (INil)))))
        (= ?iota (Op (Iota ?iota_expr ?iota_range) (INil)))
        (= ?cast (Op (Cast ?cast_size (Bf16)) (ICons ?materialized (INil))))
        (= ?iota_range ?cast_size)
        (= ?qoi (Input ?qo_idx "qo_indptr" (Int)))
        (= ?kvi (Input ?kv_idx "kv_indptr" (Int)))
    )
    (
        (let ?fi (Op (SinkAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim ?input_tokens ?scale_val ?window_val (Bf16) 1.0)
            (ICons ?q (ICons ?kp (ICons ?vp (ICons ?g
                (ICons ?qoi (ICons ?kvi (ICons ?s (INil))))))))))
        (union ?cast ?fi)
        (set (dtype ?fi) (Bf16))
        (delete (Op (Cast ?cast_size (Bf16)) (ICons ?materialized (INil))))
    )
    :ruleset kernel_fuse_late2_sink_attention
    :name "SinkAttention flat-Iota token-major BF16 consumer"
)

; Kernel lowering and generic elementwise fusion run before final cleanup.
; They can therefore leave a KernelCast or FusionEnd in the same eclass as
; the proven token-major SinkAttention even though the frontend Cast was
; deleted above. Both alternatives execute the heads-major F32 attention and
; materialize a transpose before rounding back to BF16. Once the exact
; token-major consumer proof has fired, those spellings are strictly more
; work and have the same storage contract; remove them at the final backend
; selection boundary so a one-candidate search is deterministic.
(rule
    (
        (= ?tm (Op (SinkAttention
            ?nheads ?nkv ?hdim ?input_tokens ?scale ?window (Bf16) 1.0)
            ?tm_inputs))
        (= ?fallback (Op (KernelCast ?size ?src_dtype ?dst_dtype)
            ?fallback_inputs))
        (= ?tm ?fallback)
    )
    (
        (delete (Op (KernelCast ?size ?src_dtype ?dst_dtype)
            ?fallback_inputs))
    )
    :ruleset base_cleanup
    :name "prefer token-major SinkAttention over cast fallback"
)

(rule
    (
        (= ?tm (Op (SinkAttention
            ?nheads ?nkv ?hdim ?input_tokens ?scale ?window (Bf16) 1.0)
            ?tm_inputs))
        (= ?fallback (Op (FusionEnd ?shape ?strides (Bf16))
            ?fallback_inputs))
        (= ?tm ?fallback)
    )
    (
        (delete (Op (FusionEnd ?shape ?strides (Bf16))
            ?fallback_inputs))
    )
    :ruleset base_cleanup
    :name "prefer token-major SinkAttention over fused fallback"
)
