; FlashInfer batch decode attention rewrite rule.
;
; Matches the paged attention pattern for ANY model with GQA:
;   Gather(K_cache) → GQA broadcast → Q*K^T matmul → scale → add mask → softmax → attn*V matmul
;   Gather(V_cache) → GQA broadcast ──────────────────────────────────────────→ attn*V matmul
;
; Structural anchors (prevent false matches on MLP/other ops):
;   - Gather ops from 2D cache pools (MLP never uses Gather)
;   - K and V cache gathers use the same flat gather index
;   - GQA broadcast via Mul(gathered, Constant(1.0)) with all-zero strides
;   - Scale Mul(QK, constant) connecting QK scores to mask Add
;   - Mask Add with zero-stride broadcast in first dim (nheads broadcast)
;   - Data flow: two sequential matmul+reduce pairs connected through softmax
;
; The egglog rule captures the mask as a proof-only 5th structural input.
; During extract(), Rust drops that runtime dependency and recovers the compact
; gather_idx input from the lowered flat gather index.
;
; Shape dimensions are egglog variables, not pinned constants.

(relation flashinfer_cache_pair (IR IR))

; Head dims the JIT-compiled FlashInfer kernels support (jit.rs asserts the
; same set). Rules must not capture islands for other dims (e.g. gemma-4's
; 512-dim full-attention layers stay on the HLIR chain).
(relation flashinfer_head_dim_ok (Expression))
(flashinfer_head_dim_ok (MNum 64))
(flashinfer_head_dim_ok (MNum 128))
(flashinfer_head_dim_ok (MNum 256))
; 512 is 16-bit only (the f32 kernel instantiation is gated out of the
; wrapper at HEAD_DIM > 256) — used by rules that pin a 16-bit dtype.
(relation flashinfer_head_dim_ok_16bit (Expression))
(flashinfer_head_dim_ok_16bit (MNum 64))
(flashinfer_head_dim_ok_16bit (MNum 128))
(flashinfer_head_dim_ok_16bit (MNum 256))
(flashinfer_head_dim_ok_16bit (MNum 512))

; Mask-chain facts staged for the attention island rules. Every island rule
; anchors at one of these tiny relations instead of inlining its mask atoms:
; the mask-fact joins are small and run once in kernel_fuse_late_pre, and the
; island joins stay narrow on rolled bodies with many distinct attention
; instances (inlined, the gemma body ground for 35+ minutes in fuse-late).
(relation fi_triu_mask (IR IR))
(relation fi_window_term (IR IR f64))
(relation fi_scaled_offset_mask (IR))
(relation fi_direct_causal_mask (IR IR))

; The attention island is proved backwards from the final value reduction.
; Each relation carries only the identity fields required by the next stage,
; so Egglog never has to plan or execute the original 50-atom joins.  These
; stages are an exact factorization of those joins: no structural condition
; from the six supported spellings is dropped.
; (output, soft/masked, v_cache, gather_idx, heads, q_len, head_dim, kv_len,
;  packed_kv_dim)
(relation fi_value_tail
    (IR IR IR IR Expression Expression Expression Expression Expression))
(relation fi_softmax_denominator
    (IR IR IR IR Expression Expression Expression Expression Expression))
(relation fi_attention_tail
    (IR IR IR IR Expression Expression Expression Expression Expression))
; (output, qk, mask, v_cache, gather_idx, dimensions..., scale, window, class)
; class 0 is decode; class 1 additionally requires a 16-bit prefill dtype.
(relation fi_attention_request
    (IR IR IR IR IR Expression Expression Expression Expression Expression f64 f64 f64))
; (output, mask, v_cache, gather_idx, q, k_cache, dimensions..., dtype,
;  scale, window, class)
(relation fi_attention_candidate
    (IR IR IR IR IR IR Expression Expression Expression Expression Expression DType f64 f64 f64))

; A constant-valued eclass regardless of dtype: either a plain HLIR Constant
; (f32 graphs) or a folded dtype-typed KernelConstant (the frontend emits
; `constant(v).cast(dt)` for non-f32 scalars, and the kernel_lower fold rule
; unions a KernelConstant into the Cast's eclass).
(relation const_like (IR f64))
(rule ((= ?e (Op (Constant ?v) (INil))))
    ((const_like ?e ?v))
    :ruleset matmul_backend
    :name "FlashInfer const-like hlir"
)
(rule ((= ?e (Op (KernelConstant ?v ?cdt) (INil))))
    ((const_like ?e ?v))
    :ruleset matmul_backend
    :name "FlashInfer const-like kernel"
)

; Dtypes with a tensor-core prefill runtime (16-bit only).
(relation flashinfer_prefill_dt (DType))
(flashinfer_prefill_dt (F16))
(flashinfer_prefill_dt (Bf16))


; K and V cache sources must come from the same cache-update provenance.
; This prevents a rolled loop-body K cache from pairing with the one remaining
; unrolled V cache outside the loop, which is shape-compatible but not the
; same attention instance.
(rule
    (
        (= ?k_cache (Op (Scatter ?k_ds ?k_dst ?k_is ?k_istr ?k_ss)
            (ICons ?k_dest (ICons ?scatter_idx (ICons ?k_src (INil))))))
        (= ?v_cache (Op (Scatter ?v_ds ?v_dst ?v_is ?v_istr ?v_ss)
            (ICons ?v_dest (ICons ?scatter_idx (ICons ?v_src (INil))))))
        (= ?k_dest (Input ?k_node ?k_label ?k_dt))
        (= ?v_dest (Input ?v_node ?v_label ?v_dt))
    )
    ((flashinfer_cache_pair ?k_cache ?v_cache))
    :ruleset matmul_backend
    :name "FlashInfer raw cache pair"
)

(rule
    (
        (= ?k_cache (Op (Scatter ?k_ds ?k_dst ?k_is ?k_istr ?k_ss)
            (ICons ?k_dest (ICons ?scatter_idx (ICons ?k_src (INil))))))
        (= ?v_cache (Op (Scatter ?v_ds ?v_dst ?v_is ?v_istr ?v_ss)
            (ICons ?v_dest (ICons ?scatter_idx (ICons ?v_src (INil))))))
        (= ?k_dest (Op (LoopInput ?loop_id ?k_stream ?k_dt) ?k_loop_inputs))
        (= ?v_dest (Op (LoopInput ?loop_id ?v_stream ?v_dt) ?v_loop_inputs))
    )
    ((flashinfer_cache_pair ?k_cache ?v_cache))
    :ruleset matmul_backend
    :name "FlashInfer rolled cache pair"
)

; ── Causal-mask proofs ──
;
; Prove the supported causal-mask spellings once, before the demand-driven
; attention stages consume these compact facts.

(rule
    (
        (= ?cmask (Op (Gather
            (ECons ?input_tokens (ECons ?context_tokens (ENil)))
            ?mask_idx_strides
            (ECons ?context_tokens (ECons ?context_tokens (ENil)))
            ?mask_src_strides)
            (ICons ?mask_indices (ICons ?scaled_blocked (INil)))))
        (= ?mask_indices (Op (Add
            (ECons ?input_tokens (ECons ?context_tokens (ENil)))
            ?row_idx_strides
            ?col_idx_strides
            ?mask_idx_out_strides)
            (ICons ?row_offsets (ICons ?col_offsets (INil)))))
        (= ?col_offsets (Op (Iota (MIter) ?context_tokens) (INil)))
        (= ?row_offsets (Op (Mul
            (ECons ?input_tokens (ENil))
            ?q_pos_strides
            ?ctx_scalar_strides
            ?row_offsets_out_strides)
            (ICons ?q_pos (ICons ?ctx_scalar (INil)))))
        (= ?ctx_scalar (Op (Iota ?context_tokens (MNum 1)) (INil)))

        (= ?scaled_blocked (Op (Mul
            (ECons ?context_tokens (ECons ?context_tokens (ENil)))
            ?blocked_strides
            ?neg_scale_strides
            ?scaled_blocked_strides)
            (ICons ?blocked_f32 (ICons ?neg_mask_scale (INil)))))
        (const_like ?neg_mask_scale ?neg_mask_scale_val)
        (< ?neg_mask_scale_val -9999999999.0)
        (> ?neg_mask_scale_val -10000000001.0)
        (= ?blocked_f32 (Op (Cast ?blocked_cast_size ?blocked_cast_dt)
            (ICons ?blocked_bool (INil))))
        (= ?blocked_bool (Op (LessThan
            (ECons ?context_tokens (ECons ?context_tokens (ENil)))
            ?tri_row_strides
            ?tri_col_strides
            ?blocked_out_strides)
            (ICons ?tri_iota_f32 (ICons ?tri_iota_minus_zero (INil)))))
        (= ?tri_iota_minus_zero (Op (Add
            (ECons ?context_tokens (ECons ?context_tokens (ENil)))
            ?tri_minus_zero_a_strides
            ?tri_minus_zero_b_strides
            ?tri_minus_zero_out_strides)
            (ICons ?tri_iota_f32 (ICons ?zero_offset (INil)))))
        (= ?zero_offset (Op (Mul
            (ECons ?context_tokens (ECons ?context_tokens (ENil)))
            ?zero_offset_a_strides
            ?zero_offset_b_strides
            ?zero_offset_out_strides)
            (ICons ?zero_const (ICons ?neg_one_const (INil)))))
        (= ?zero_const (Op (Constant 0.000000) (INil)))
        (= ?neg_one_const (Op (Constant -1.000000) (INil)))
        (= ?tri_iota_f32 (Op (Cast ?tri_iota_cast_size (F32))
            (ICons ?tri_iota (INil))))
        (= ?tri_iota (Op (Iota (MIter) ?context_tokens) (INil)))
    )
    (
        (fi_triu_mask ?cmask ?q_pos)
    )
    :ruleset kernel_fuse_late_pre_flashinfer
    :name "FlashInfer triu mask fact"
)

(rule
    (
        ; Legacy decode mask spelling: Add(Mul(allowed, 1e10), offset). The
        ; "batch decode attention" island rule anchors at this fact.
        (= ?mask (Op (Add ?inner_mask_shape ?inner_mask_a_strides ?inner_mask_b_strides ?inner_mask_out_strides)
            (ICons ?mask_scaled_allowed (ICons ?mask_offset (INil)))))
        (= ?mask_scaled_allowed (Op (Mul ?allowed_shape ?allowed_strides ?scale_const_strides ?scaled_allowed_strides)
            (ICons ?mask_allowed (ICons ?mask_scale_const (INil)))))
        (const_like ?mask_scale_const ?mask_scale_val)
        (> ?mask_scale_val 9999999999.0)
        (< ?mask_scale_val 10000000001.0)
    )
    (
        (fi_scaled_offset_mask ?mask)
    )
    :ruleset kernel_fuse_late_pre_flashinfer
    :name "FlashInfer scaled-offset mask fact"
)

(rule
    (
        ; Direct causal mask spelling:
        ;   (q_pos[:, None] < arange(c)[None, :]).cast(F32) * -1e10
        ; The "direct causal attention" island rule anchors at this fact.
        (= ?mask (Op (Mul
            (ECons ?input_tokens (ECons ?context_tokens (ENil)))
            ?blocked_strides
            ?neg_scale_strides
            ?mask_out_strides)
            (ICons ?blocked_f32 (ICons ?neg_mask_scale (INil)))))
        (const_like ?neg_mask_scale ?neg_mask_scale_val)
        (< ?neg_mask_scale_val -9999999999.0)
        (> ?neg_mask_scale_val -10000000001.0)
        (= ?blocked_f32 (Op (Cast ?blocked_cast_size ?blocked_cast_dt)
            (ICons ?blocked_bool (INil))))
        (= ?blocked_bool (Op (LessThan
            (ECons ?input_tokens (ECons ?context_tokens (ENil)))
            ?q_pos_cmp_strides
            ?col_cmp_strides
            ?blocked_out_strides)
            (ICons ?q_pos (ICons ?col_offsets (INil)))))
        (= ?col_offsets (Op (Iota (MIter) ?context_tokens) (INil)))
    )
    (
        (fi_direct_causal_mask ?mask ?q_pos)
    )
    :ruleset kernel_fuse_late_pre_flashinfer
    :name "FlashInfer direct causal mask fact"
)

(rule
    (
        ; window term: (col < q_pos - (W-1)) cast * -1e10; the constant W-1
        ; is FlashInfer's window_left.
        (= ?wterm (Op (Mul
            (ECons ?input_tokens (ECons ?context_tokens (ENil)))
            ?wt_a_strides
            ?wt_b_strides
            ?wt_out_strides)
            (ICons ?w_bool_cast (ICons ?w_negbig (INil)))))
        (const_like ?w_negbig ?w_negbig_val)
        (< ?w_negbig_val -9999999999.0)
        (> ?w_negbig_val -10000000001.0)
        (= ?w_bool_cast (Op (Cast ?w_cast_size ?w_cast_dt)
            (ICons ?w_lt (INil))))
        (= ?w_lt (Op (LessThan
            (ECons ?input_tokens (ECons ?context_tokens (ENil)))
            (ECons (MNum 0) (ECons (MIter) (ENil)))
            (ECons (MIter) (ECons (MNum 0) (ENil)))
            ?w_lt_out_strides)
            (ICons ?w_col_f (ICons ?w_lo (INil)))))
        (= ?w_col_f (Op (Cast ?w_col_cast_size (F32)) (ICons ?w_col_iota (INil))))
        (= ?w_col_iota (Op (Iota (MIter) ?context_tokens) (INil)))
        (= ?w_lo (Op (Add
            (ECons ?input_tokens (ENil))
            ?w_lo_a_strides
            ?w_lo_b_strides
            ?w_lo_out_strides)
            (ICons ?w_qpos_f (ICons ?w_neg (INil)))))
        (= ?w_qpos_f (Op (Cast ?w_qpos_cast_size (F32)) (ICons ?w_qpos (INil))))
        (= ?w_neg (Op (Mul
            (ECons ?input_tokens (ENil))
            (ECons (MNum 0) (ENil))
            (ECons (MNum 0) (ENil))
            ?w_neg_out_strides)
            (ICons ?w_window (ICons ?w_negone (INil)))))
        (= ?w_window (Op (Constant ?window_left) (INil)))
        (= ?w_negone (Op (Constant -1.000000) (INil)))
    )
    (
        (fi_window_term ?wterm ?w_qpos ?window_left)
    )
    :ruleset kernel_fuse_late_pre_flashinfer
    :name "FlashInfer window term fact"
)

; ── Demand-driven attention-island factorization ──

; Start at the externally visible output reduction and walk backwards through
; V. This is the only broad discovery stage, and its premise is a short,
; connected chain rather than a complete attention island.
(rule
    (
        (= ?output (Op (Sum
            (ECons ?out_heads (ECons ?input_tokens (ECons ?out_hdim (ENil))))
            ?context_tokens ?out_in_strides (MIter) ?out_out_strides)
            (ICons ?mul2 (INil))))
        (= ?mul2 (Op (Mul
            (ECons ?nheads (ECons ?input_tokens (ECons ?hdim (ECons ?context_tokens (ENil)))))
            ?mul2_a_strides ?mul2_b_strides ?mul2_out_strides)
            (ICons ?soft (ICons ?v_gqa (INil)))))
        (= ?v_gqa (Op (Mul
            (ECons ?v_heads (ECons ?context_tokens (ECons ?v_hdim (ENil))))
            ?v_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?v_gqa_out_strides)
            (ICons ?v_gathered (ICons ?v_gqa_const (INil)))))
        (const_like ?v_gqa_const 1.000000)
        (= ?v_gathered (Op (Gather
            (ECons ?context_tokens (ECons ?kvdim (ENil)))
            ?v_gather_strides
            (ECons ?num_slots_v (ECons ?v_source_width (ENil)))
            ?v_src_strides)
            (ICons ?k_idx (ICons ?v_cache (INil)))))
    )
    ((fi_value_tail ?output ?soft ?v_cache ?k_idx
        ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim))
    :ruleset kernel_fuse_late2_flashinfer_value
    :name "FlashInfer demand value tail"
)

; Prove the denominator half of softmax only for a value-tail consumer.
(rule
    (
        (fi_value_tail ?output ?soft ?v_cache ?k_idx
            ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim)
        (= ?soft (Op (Mul ?sf_shape ?sf_a ?sf_b ?sf_o)
            (ICons ?sexp (ICons ?srecip (INil)))))
        (= ?srecip (Op (Recip ?sr_shape ?sr_in ?sr_out)
            (ICons ?sexpsum (INil))))
        (= ?sexpsum (Op (Sum ?ss_shape ?context_tokens ?ss_in ?ss_iter ?ss_out)
            (ICons ?sexp (INil))))
    )
    ((fi_softmax_denominator ?output ?sexp ?v_cache ?k_idx
        ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim))
    :ruleset kernel_fuse_late2_flashinfer_softmax_denominator
    :name "FlashInfer demand softmax denominator"
)

; Prove the exp/max half and expose the precise masked-score node requested by
; each supported mask spelling.
(rule
    (
        (fi_softmax_denominator ?output ?sexp ?v_cache ?k_idx
            ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim)
        (= ?sexp (Op (Exp2 ?se_shape ?se_in ?se_out) (ICons ?sc (INil))))
        (= ?sc (Op (Mul ?sc_shape ?sc_a ?sc_b ?sc_o)
            (ICons ?shifted (ICons ?sc_log2e (INil)))))
        (const_like ?sc_log2e 1.442695)
        (= ?shifted (Op (Add ?sh_shape ?sh_a ?sh_b ?sh_o)
            (ICons ?masked (ICons ?negmax (INil)))))
        (= ?negmax (Op (Mul ?nm_shape ?nm_a ?nm_b ?nm_o)
            (ICons ?smax (ICons ?nm_negone (INil)))))
        (= ?smax (Op (Max ?smax_shape ?context_tokens ?smax_in ?smax_iter ?smax_out)
            (ICons ?masked (INil))))
    )
    ((fi_attention_tail ?output ?masked ?v_cache ?k_idx
        ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim))
    :ruleset kernel_fuse_late2_flashinfer_softmax_source
    :name "FlashInfer demand softmax source"
)

; Legacy scaled-offset decode mask.
(rule
    (
        (fi_attention_tail ?output ?masked ?v_cache ?k_idx
            ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim)
        (= ?masked (Op (Add
            (ECons ?mask_heads (ECons ?input_tokens (ECons ?context_tokens (ENil))))
            ?mask_add_a_strides (ECons (MNum 0) ?mask_rest_strides)
            ?mask_add_out_strides)
            (ICons ?scaled_qk (ICons ?mask (INil)))))
        (= ?scaled_qk (Op (Mul ?sq_shape ?sq_a ?sq_b ?sq_o)
            (ICons ?qk (ICons ?sq_scale (INil)))))
        (const_like ?sq_scale ?scale)
        (fi_scaled_offset_mask ?mask)
        (flashinfer_head_dim_ok ?hdim)
    )
    ((fi_attention_request ?output ?qk ?mask ?v_cache ?k_idx
        ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim ?scale -1.0 0.0))
    :ruleset kernel_fuse_late2_flashinfer_request
    :name "request FlashInfer scaled-offset decode"
)

; Direct causal-mask decode spelling.
(rule
    (
        (fi_attention_tail ?output ?masked ?v_cache ?k_idx
            ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim)
        (= ?s_lower (lower ?input_tokens))
        (= ?s_upper (upper ?input_tokens))
        (> ?s_lower 0)
        (< ?s_upper 2)
        (= ?masked (Op (Add
            (ECons ?mask_heads (ECons ?input_tokens (ECons ?context_tokens (ENil))))
            ?mask_add_a_strides (ECons (MNum 0) ?mask_rest_strides)
            ?mask_add_out_strides)
            (ICons ?scaled_qk (ICons ?mask (INil)))))
        (= ?scaled_qk (Op (Mul ?sq_shape ?sq_a ?sq_b ?sq_o)
            (ICons ?qk (ICons ?sq_scale (INil)))))
        (const_like ?sq_scale ?scale)
        (fi_direct_causal_mask ?mask ?q_pos)
        (flashinfer_head_dim_ok ?hdim)
    )
    ((fi_attention_request ?output ?qk ?mask ?v_cache ?k_idx
        ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim ?scale -1.0 0.0))
    :ruleset kernel_fuse_late2_flashinfer_request
    :name "request FlashInfer direct causal decode"
)

; Gathered triangular causal-mask decode spelling.
(rule
    (
        (fi_attention_tail ?output ?masked ?v_cache ?k_idx
            ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim)
        (= ?s_lower (lower ?input_tokens))
        (= ?s_upper (upper ?input_tokens))
        (> ?s_lower 0)
        (< ?s_upper 2)
        (= ?masked (Op (Add
            (ECons ?mask_heads (ECons ?input_tokens (ECons ?context_tokens (ENil))))
            ?mask_add_a_strides (ECons (MNum 0) ?mask_rest_strides)
            ?mask_add_out_strides)
            (ICons ?scaled_qk (ICons ?mask (INil)))))
        (= ?scaled_qk (Op (Mul ?sq_shape ?sq_a ?sq_b ?sq_o)
            (ICons ?qk (ICons ?sq_scale (INil)))))
        (const_like ?sq_scale ?scale)
        (fi_triu_mask ?mask ?q_pos)
        (flashinfer_head_dim_ok ?hdim)
    )
    ((fi_attention_request ?output ?qk ?mask ?v_cache ?k_idx
        ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim ?scale -1.0 0.0))
    :ruleset kernel_fuse_late2_flashinfer_request
    :name "request FlashInfer triu decode"
)

; The same scaled-score triu spelling without the decode-only bucket guard.
; Its candidate must prove a 16-bit prefill dtype in the final stage.
(rule
    (
        (fi_attention_tail ?output ?masked ?v_cache ?k_idx
            ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim)
        (= ?masked (Op (Add
            (ECons ?mask_heads (ECons ?input_tokens (ECons ?context_tokens (ENil))))
            ?mask_add_a_strides (ECons (MNum 0) ?mask_rest_strides)
            ?mask_add_out_strides)
            (ICons ?scaled_qk (ICons ?mask (INil)))))
        (= ?scaled_qk (Op (Mul ?sq_shape ?sq_a ?sq_b ?sq_o)
            (ICons ?qk (ICons ?sq_scale (INil)))))
        (const_like ?sq_scale ?scale)
        (fi_triu_mask ?mask ?q_pos)
        (flashinfer_head_dim_ok ?hdim)
    )
    ((fi_attention_request ?output ?qk ?mask ?v_cache ?k_idx
        ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim ?scale -1.0 1.0))
    :ruleset kernel_fuse_late2_flashinfer_request
    :name "request FlashInfer triu prefill"
)

; Gemma scale-free full attention.
(rule
    (
        (fi_attention_tail ?output ?masked ?v_cache ?k_idx
            ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim)
        (= ?s_lower (lower ?input_tokens))
        (= ?s_upper (upper ?input_tokens))
        (> ?s_lower 0)
        (< ?s_upper 2)
        (= ?masked (Op (Add
            (ECons ?mask_heads (ECons ?input_tokens (ECons ?context_tokens (ENil))))
            ?mask_add_a_strides (ECons (MNum 0) ?mask_rest_strides)
            ?mask_add_out_strides)
            (ICons ?qk (ICons ?mask (INil)))))
        (fi_triu_mask ?mask ?q_pos)
        (flashinfer_head_dim_ok_16bit ?hdim)
    )
    ((fi_attention_request ?output ?qk ?mask ?v_cache ?k_idx
        ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim 1.0 -1.0 1.0))
    :ruleset kernel_fuse_late2_flashinfer_request
    :name "request FlashInfer Gemma full attention"
)

; Gemma scale-free sliding-window attention.
(rule
    (
        (fi_attention_tail ?output ?masked ?v_cache ?k_idx
            ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim)
        (= ?s_lower (lower ?input_tokens))
        (= ?s_upper (upper ?input_tokens))
        (> ?s_lower 0)
        (< ?s_upper 2)
        (= ?masked (Op (Add
            (ECons ?mask_heads (ECons ?input_tokens (ECons ?context_tokens (ENil))))
            ?mask_add_a_strides (ECons (MNum 0) ?mask_rest_strides)
            ?mask_add_out_strides)
            (ICons ?qk (ICons ?mask (INil)))))
        (= ?mask (Op (Add
            (ECons ?input_tokens (ECons ?context_tokens (ENil)))
            ?wm_a_strides ?wm_b_strides ?wm_out_strides)
            (ICons ?cmask (ICons ?wterm (INil)))))
        (fi_triu_mask ?cmask ?q_pos)
        (fi_window_term ?wterm ?q_pos2 ?window)
        (= ?q_pos ?q_pos2)
        (flashinfer_head_dim_ok_16bit ?hdim)
    )
    ((fi_attention_request ?output ?qk ?mask ?v_cache ?k_idx
        ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim 1.0 ?window 1.0))
    :ruleset kernel_fuse_late2_flashinfer_request
    :name "request FlashInfer Gemma sliding attention"
)

; Shared Q/K proof. Joining through the request's exact qk, cache index and V
; cache preserves per-attention-instance identity without a cross product.
(rule
    (
        (fi_attention_request ?output ?qk ?mask ?v_cache ?k_idx
            ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim
            ?scale ?window ?class)
        (= ?qk (Op (Sum
            (ECons ?qk_heads (ECons ?input_tokens (ECons ?context_tokens (ENil))))
            ?qk_hdim ?qk_in_strides (MIter) ?qk_out_strides)
            (ICons ?mul1 (INil))))
        (= ?mul1 (Op (Mul
            (ECons ?mul_heads (ECons ?input_tokens (ECons ?context_tokens (ECons ?mul_hdim (ENil)))))
            ?mul1_a_strides ?mul1_b_strides ?mul1_out_strides)
            (ICons ?q (ICons ?k_gqa (INil)))))
        (= ?k_gqa (Op (Mul
            (ECons ?k_heads (ECons ?k_hdim (ECons ?context_tokens (ENil))))
            ?k_gqa_a_strides
            (ECons (MNum 0) (ECons (MNum 0) (ECons (MNum 0) (ENil))))
            ?k_gqa_out_strides)
            (ICons ?k_gathered (ICons ?k_gqa_const (INil)))))
        (const_like ?k_gqa_const 1.000000)
        (= ?k_gathered (Op (Gather
            (ECons ?context_tokens (ECons ?k_width (ENil)))
            ?k_gather_strides
            (ECons ?num_slots_k (ECons ?k_source_width (ENil)))
            ?k_src_strides)
            (ICons ?k_idx (ICons ?k_cache (INil)))))
        (= ?dt (dtype ?q))
        (= ?dt (dtype ?k_cache))
        (= ?dt (dtype ?v_cache))
        (flashinfer_cache_pair ?k_cache ?v_cache)
    )
    ((fi_attention_candidate ?output ?mask ?v_cache ?k_idx ?q ?k_cache
        ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim ?dt
        ?scale ?window ?class))
    :ruleset kernel_fuse_late2_flashinfer_qk
    :name "prove requested FlashInfer QK and caches"
)

; Decode candidates have no extra dtype guard.
(rule
    ((fi_attention_candidate ?output ?mask ?v_cache ?k_idx ?q ?k_cache
        ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim ?dt
        ?scale ?window 0.0))
    (
        (let ?fi (Op (FlashInferAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim (MNum 1)
            ?input_tokens ?context_tokens ?dt ?scale ?window)
            (ICons ?q (ICons ?k_cache (ICons ?v_cache
                (ICons ?k_idx (ICons ?mask (INil))))))))
        (union ?output ?fi)
        (set (dtype ?fi) ?dt)
    )
    :ruleset kernel_fuse_late2_flashinfer_final
    :name "materialize FlashInfer decode candidate"
)

; Prefill candidates exactly retain the original f16/bf16 restriction.
(rule
    (
        (fi_attention_candidate ?output ?mask ?v_cache ?k_idx ?q ?k_cache
            ?nheads ?input_tokens ?hdim ?context_tokens ?kvdim ?dt
            ?scale ?window 1.0)
        (flashinfer_prefill_dt ?dt)
    )
    (
        (let ?fi (Op (FlashInferAttention
            ?nheads (MDiv ?kvdim ?hdim) ?hdim (MNum 1)
            ?input_tokens ?context_tokens ?dt ?scale ?window)
            (ICons ?q (ICons ?k_cache (ICons ?v_cache
                (ICons ?k_idx (ICons ?mask (INil))))))))
        (union ?output ?fi)
        (set (dtype ?fi) ?dt)
    )
    :ruleset kernel_fuse_late2_flashinfer_final
    :name "materialize FlashInfer prefill candidate"
)
