; Row-major matmul: C[m,n] = A[m,k] × B[k,n]
; A[m,k] row-major → expand to [m, n, k] with strides [k, 0, MIter]
; B[k,n] row-major → permute to [n,k] then expand to [m, n, k] with strides [0, MIter, n]
;
; Row-major viewed as column-major (swap trick):
;   Row-major A[m,k] ≡ column-major [k,m] with lda=k
;   Row-major B[k,n] ≡ column-major [n,k] with ldb=n
;   Row-major C[m,n] ≡ column-major [n,m] with ldc=n
;
; cuBLAS computes: C_col[n,m] = B_col[n,k] × A_col[k,m]
; cublasSgemm(OP_N, OP_N, n, m, k, α, B, n, A, k, β, C, n)
(rule
    (
        ; Match the generic matmul produced from Mul -> Sum.
        (= ?sum (Op (GenericMatmul
            ?out_shape ?mul_shape ?k
            ?a_stride ?b_stride
            ?sum_in_stride ?k_stride ?sum_out_stride
            ?matmul_dtype)
            (ICons ?a (ICons ?b (INil)))))
        (generic_matmul_exact_2d ?sum ?m ?n ?k ?dt)
        (= ?matmul_dtype ?dt)

        ; Match exactly 2D output shape
        (= ?out_shape (ECons ?m (ECons ?n (ENil))))
        (!= ?m (MNum 0))
        (!= ?n (MNum 0))
        (!= ?k (MNum 1))

        ; Match exactly 3D strides [m, n, k]
        (= ?a_stride (ECons ?a_m_stride (ECons ?a_n_stride (ECons ?a_k_stride (ENil)))))
        (= ?b_stride (ECons ?b_m_stride (ECons ?b_n_stride (ECons ?b_k_stride (ENil)))))

        ; Assert contiguous k stride on output (required for reduction)
        (= ?k_stride (MIter))

        ; Assert A has strides [k*MIter, 0, MIter] (row-major A[m,k] broadcast to [m,n,k])
        (= ?a_m_stride (MMul (MIter) ?k))
        (= ?a_n_stride (MNum 0))
        (= ?a_k_stride (MIter))

        ; Assert B has strides [0, MIter, n*MIter] (row-major B[k,n] permuted to [n,k] then broadcast to [m,n,k])
        (= ?b_m_stride (MNum 0))
        (= ?b_n_stride (MIter))
        (= ?b_k_stride (MMul (MIter) ?n))

        (= ?dt (dtype ?a))
        (= ?dt (dtype ?b))
        (cublaslt_base_dtype ?dt)
    )
    (
        ; For row-major C = A × B with cuBLAS (column-major):
        ; cublasSgemm(OP_N, OP_N, n, m, k, α, B, n, A, k, β, C, n)
        (let ?sgemm (Op (cublaslt
            ?n             ; cuBLAS m = our n (swapped)
            ?m             ; cuBLAS n = our m (swapped)
            ?k             ; k unchanged
            "N"            ; transa = No transpose
            "N"            ; transb = No transpose
            "COL" "COL" "COL" "COL" ; A/B/C/D matrix orders
            ?b_k_stride    ; lda = B's row stride (resolves to n after z→1)
            ?a_m_stride    ; ldb = A's row stride (resolves to k after z→1)
            ?n             ; ldc = n (row-major C[m,n] viewed as col-major [n,m])
            ?n             ; ldd = ldc for current row-major output rewrites
            (MNum 1)       ; batch_count = 1
            (MNum 0)       ; stride_a = 0
            (MNum 0)       ; stride_b = 0
            (MNum 0)       ; stride_c = 0
            (MNum 0)       ; stride_d = 0
            ?dt ?dt ?dt ?dt "default" "default" 1.0 0.0 "DEFAULT")   ; type tuple, alpha, beta
            (ICons ?b (ICons ?a (INil)))))
        (union ?sum ?sgemm)
        (set (dtype ?sgemm) ?dt)
    )
    :ruleset matmul_backend
    :name "cublaslt row-major x row-major"
)

; Batched Row-major × Row-major: C[batch,m,n] = A[batch,m,k] × B[batch,k,n]
; In broadcast [batch, m, n, k] space:
;   A row-major per batch: a_k_stride=MIter, a_n_stride=0
;   B row-major per batch: b_n_stride=MIter, b_m_stride=0
; Leading dimensions may differ from k/n when batch slices are non-contiguous.
(rule
    (
        (= ?sum (Op (GenericMatmul
            ?out_shape ?mul_shape ?k
            ?a_stride ?b_stride
            ?sum_in_stride ?k_stride ?sum_out_stride
            ?matmul_dtype)
            (ICons ?a (ICons ?b (INil)))))
        (generic_matmul_exact_3d ?sum ?batch ?m ?n ?k ?dt)
        (= ?matmul_dtype ?dt)

        ; Output shape: exactly [batch, m, n]. This descriptor has only one
        ; strided-batch axis, so it cannot omit leading batch dimensions.
        (= ?out_shape (ECons ?batch (ECons ?m (ECons ?n (ENil)))))
        (!= ?m (MNum 0))
        (!= ?n (MNum 0))
        (!= ?k (MNum 1))
        (!= ?batch (MNum 0))

        ; A/B strides are exactly [batch, m, n, k].
        (= ?a_stride (ECons ?a_batch_stride (ECons ?a_m_stride (ECons ?a_n_stride (ECons ?a_k_stride (ENil))))))
        (= ?b_stride (ECons ?b_batch_stride (ECons ?b_m_stride (ECons ?b_n_stride (ECons ?b_k_stride (ENil))))))

        (= ?k_stride (MIter))

        ; A row-major: k=MIter, n=0, m_stride=k*MIter
        (= ?a_k_stride (MIter))
        (= ?a_n_stride (MNum 0))
        (= ?a_m_stride (MMul (MIter) ?k))

        ; B row-major: n=MIter, m=0, k_stride=n*MIter
        (= ?b_n_stride (MIter))
        (= ?b_m_stride (MNum 0))
        (= ?b_k_stride (MMul (MIter) ?n))

        ; Uniform batch strides (contiguous per batch, no GQA-style repetition)
        (= ?a_batch_stride (MMul ?m ?a_m_stride))
        (= ?b_batch_stride (MMul ?k ?b_k_stride))

        (= ?dt (dtype ?a))
        (= ?dt (dtype ?b))
        (cublaslt_base_dtype ?dt)
    )
    (
        ; cuBLAS swap: C^T[n,m] = B^T[n,k] × A^T[k,m] per batch
        ; cublas(OP_N, OP_N, n, m, k, B, lda=b_k_stride, A, ldb=a_m_stride, C, ldc=n)
        (let ?sgemm (Op (cublaslt
            ?n ?m ?k
            "N" "N"
            "COL" "COL" "COL" "COL"
            ?b_k_stride       ; lda (cuBLAS A = our B, row stride)
            ?a_m_stride       ; ldb (cuBLAS B = our A, row stride)
            ?n                ; ldc (contiguous output per batch)
            ?n                ; ldd
            ?batch            ; batch_count
            ?b_batch_stride   ; stride_a (cuBLAS A = our B)
            ?a_batch_stride   ; stride_b (cuBLAS B = our A)
            (MMul ?m ?n)      ; stride_c
            (MMul ?m ?n)      ; stride_d
            ?dt ?dt ?dt ?dt "default" "default" 1.0 0.0 "DEFAULT")
            (ICons ?b (ICons ?a (INil)))))
        (union ?sum ?sgemm)
        (set (dtype ?sgemm) ?dt)
    )
    :ruleset matmul_backend
    :name "cublaslt batched row-major × row-major"
)

; Batched Row-major × Row-major, single-row (m = 1) A operand.
;
; Decode-time attention reads A as one row per batch head, usually through a
; permuted view (e.g. q reshaped from [1, heads, head_dim]), so its m stride
; is arbitrary — and irrelevant, because a 1-row matrix never advances it.
; cuBLASLt only needs each batch's row to be contiguous: batch stride = k.
; ldb/stride_b are passed as k explicitly rather than the unconstrained view
; strides.
(rule
    (
        (= ?sum (Op (GenericMatmul
            ?out_shape ?mul_shape ?k
            ?a_stride ?b_stride
            ?sum_in_stride ?k_stride ?sum_out_stride
            ?matmul_dtype)
            (ICons ?a (ICons ?b (INil)))))
        (generic_matmul_exact_3d ?sum ?batch ?m ?n ?k ?dt)
        (= ?matmul_dtype ?dt)

        (= ?out_shape (ECons ?batch (ECons ?m (ECons ?n (ENil)))))
        (!= ?n (MNum 0))
        (!= ?k (MNum 1))
        (!= ?batch (MNum 0))

        ; m = 1: static spelling. (Dyn bounds variant below.)
        (= ?m (MNum 1))

        (= ?a_stride (ECons ?a_batch_stride (ECons ?a_m_stride (ECons ?a_n_stride (ECons ?a_k_stride (ENil))))))
        (= ?b_stride (ECons ?b_batch_stride (ECons ?b_m_stride (ECons ?b_n_stride (ECons ?b_k_stride (ENil))))))

        (= ?k_stride (MIter))

        ; A: one contiguous [k] row per batch; m stride unconstrained.
        (= ?a_k_stride (MIter))
        (= ?a_n_stride (MNum 0))
        (= ?a_batch_stride (MMul (MIter) ?k))

        ; B row-major: n=MIter, m=0, k_stride=n*MIter
        (= ?b_n_stride (MIter))
        (= ?b_m_stride (MNum 0))
        (= ?b_k_stride (MMul (MIter) ?n))
        (= ?b_batch_stride (MMul ?k ?b_k_stride))

        (= ?dt (dtype ?a))
        (= ?dt (dtype ?b))
        (cublaslt_base_dtype ?dt)
    )
    (
        (let ?sgemm (Op (cublaslt
            ?n ?m ?k
            "N" "N"
            "COL" "COL" "COL" "COL"
            ?b_k_stride       ; lda (cuBLAS A = our B, row stride)
            (MMul (MIter) ?k) ; ldb (cuBLAS B = our A: one row of k)
            ?n                ; ldc
            ?n                ; ldd
            ?batch            ; batch_count
            ?b_batch_stride   ; stride_a
            (MMul (MIter) ?k) ; stride_b (contiguous single-row batches)
            (MMul ?m ?n)      ; stride_c
            (MMul ?m ?n)      ; stride_d
            ?dt ?dt ?dt ?dt "default" "default" 1.0 0.0 "DEFAULT")
            (ICons ?b (ICons ?a (INil)))))
        (union ?sum ?sgemm)
        (set (dtype ?sgemm) ?dt)
    )
    :ruleset matmul_backend
    :name "cublaslt batched row-major × row-major single-row"
)

; Same as above with a dynamic m proven to be 1 by interval bounds.
(rule
    (
        (= ?sum (Op (GenericMatmul
            ?out_shape ?mul_shape ?k
            ?a_stride ?b_stride
            ?sum_in_stride ?k_stride ?sum_out_stride
            ?matmul_dtype)
            (ICons ?a (ICons ?b (INil)))))
        (generic_matmul_exact_3d ?sum ?batch ?m ?n ?k ?dt)
        (= ?matmul_dtype ?dt)

        (= ?out_shape (ECons ?batch (ECons ?m (ECons ?n (ENil)))))
        (!= ?n (MNum 0))
        (!= ?k (MNum 1))
        (!= ?batch (MNum 0))

        (= ?m_lower (lower ?m))
        (= ?m_upper (upper ?m))
        (> ?m_lower 0)
        (< ?m_upper 2)

        (= ?a_stride (ECons ?a_batch_stride (ECons ?a_m_stride (ECons ?a_n_stride (ECons ?a_k_stride (ENil))))))
        (= ?b_stride (ECons ?b_batch_stride (ECons ?b_m_stride (ECons ?b_n_stride (ECons ?b_k_stride (ENil))))))

        (= ?k_stride (MIter))

        (= ?a_k_stride (MIter))
        (= ?a_n_stride (MNum 0))
        (= ?a_batch_stride (MMul (MIter) ?k))

        (= ?b_n_stride (MIter))
        (= ?b_m_stride (MNum 0))
        (= ?b_k_stride (MMul (MIter) ?n))
        (= ?b_batch_stride (MMul ?k ?b_k_stride))

        (= ?dt (dtype ?a))
        (= ?dt (dtype ?b))
        (cublaslt_base_dtype ?dt)
    )
    (
        (let ?sgemm (Op (cublaslt
            ?n ?m ?k
            "N" "N"
            "COL" "COL" "COL" "COL"
            ?b_k_stride
            (MMul (MIter) ?k)
            ?n
            ?n
            ?batch
            ?b_batch_stride
            (MMul (MIter) ?k)
            (MMul ?m ?n)
            (MMul ?m ?n)
            ?dt ?dt ?dt ?dt "default" "default" 1.0 0.0 "DEFAULT")
            (ICons ?b (ICons ?a (INil)))))
        (union ?sum ?sgemm)
        (set (dtype ?sgemm) ?dt)
    )
    :ruleset matmul_backend
    :name "cublaslt batched row-major × row-major single-row dyn"
)

; Batched Row-major × Row-major with free row/batch strides.
;
; cuBLASLt's strided-batch addressing is A[b,m,k] = stride_b·b + ldb·m + k
; (and likewise for B), so ANY operand layout of the form
; (batch: z·β, m: z·α, n: 0, k: z) is natively supported — permuted views
; (e.g. q read as [heads, s, head_dim] from a [s, heads, head_dim] tensor)
; included. The only true constraints are the unit-stride innermost dim,
; the broadcast zeros, and the descriptor requirement ld >= rows, guarded
; here via interval bounds.
(rule
    (
        (= ?sum (Op (GenericMatmul
            ?out_shape ?mul_shape ?k
            ?a_stride ?b_stride
            ?sum_in_stride ?k_stride ?sum_out_stride
            ?matmul_dtype)
            (ICons ?a (ICons ?b (INil)))))
        (generic_matmul_exact_3d ?sum ?batch ?m ?n ?k ?dt)
        (= ?matmul_dtype ?dt)

        (= ?out_shape (ECons ?batch (ECons ?m (ECons ?n (ENil)))))
        (!= ?m (MNum 0))
        (!= ?n (MNum 0))
        (!= ?k (MNum 1))
        (!= ?batch (MNum 0))

        (= ?a_stride (ECons ?a_batch_stride (ECons ?a_m_stride (ECons ?a_n_stride (ECons ?a_k_stride (ENil))))))
        (= ?b_stride (ECons ?b_batch_stride (ECons ?b_m_stride (ECons ?b_n_stride (ECons ?b_k_stride (ENil))))))

        (= ?k_stride (MIter))

        ; A[b, m, k]: contiguous k, broadcast n. The row stride factor is
        ; destructured for the ld guard below; the batch stride passes
        ; through verbatim (any movement expression, including 0 for a
        ; batch-broadcast operand, is native cuBLASLt strided batching).
        (= ?a_k_stride (MIter))
        (= ?a_n_stride (MNum 0))
        (= ?a_m_stride (MMul (MIter) ?a_row))

        ; B[b, k, n]: contiguous n, broadcast m.
        (= ?b_n_stride (MIter))
        (= ?b_m_stride (MNum 0))
        (= ?b_k_stride (MMul (MIter) ?b_row))

        ; Descriptor validity: ld >= rows of the column-major view.
        ; cuBLAS A = our B^T [n, k] with lda = b_row  => b_row >= n.
        ; cuBLAS B = our A^T [k, m] with ldb = a_row  => a_row >= k.
        (= ?a_row_lower (lower ?a_row))
        (= ?k_upper (upper ?k))
        (>= ?a_row_lower ?k_upper)
        (= ?b_row_lower (lower ?b_row))
        (= ?n_upper (upper ?n))
        (>= ?b_row_lower ?n_upper)

        (= ?dt (dtype ?a))
        (= ?dt (dtype ?b))
        (cublaslt_base_dtype ?dt)
    )
    (
        (let ?sgemm (Op (cublaslt
            ?n ?m ?k
            "N" "N"
            "COL" "COL" "COL" "COL"
            ?b_k_stride       ; lda (cuBLAS A = our B, row stride)
            ?a_m_stride       ; ldb (cuBLAS B = our A, row stride)
            ?n                ; ldc
            ?n                ; ldd
            ?batch            ; batch_count
            ?b_batch_stride   ; stride_a
            ?a_batch_stride   ; stride_b
            (MMul ?m ?n)      ; stride_c
            (MMul ?m ?n)      ; stride_d
            ?dt ?dt ?dt ?dt "default" "default" 1.0 0.0 "DEFAULT")
            (ICons ?b (ICons ?a (INil)))))
        (union ?sum ?sgemm)
        (set (dtype ?sgemm) ?dt)
    )
    :ruleset matmul_backend
    :name "cublaslt batched row-major × row-major free strides"
)
